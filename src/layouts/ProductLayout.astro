---
import '../styles/global.css';
import { SITE } from '../site.config';
import { PRODUCT_BY_SLUG, CATEGORY_BY_SLUG, type Product } from '../products.config';
import { PRODUCT_FAQS, ORG_ID, ORGANIZATION_SCHEMA } from '../seo.config';
import { GLOSSARY } from '../glossary.config';
import { GUIDES } from '../guides.config';
import Nav from '../components/Nav.astro';
import FooterLinks from '../components/FooterLinks.astro';
import ContactMap from '../components/ContactMap.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  slug: Product['slug'];
  title?: string;
  description?: string;
}

const { slug, title, description } = Astro.props;
const product = PRODUCT_BY_SLUG[slug];
const category = CATEGORY_BY_SLUG[product.category];
const faqs = PRODUCT_FAQS[slug] ?? [];

// 延伸閱讀：反查 related 指向本產品的名詞解釋 / 情境指南（雙向交叉連結）
const relatedTerms = GLOSSARY.filter((t) => t.related?.includes(slug));
const relatedGuides = GUIDES.filter((g) => g.related?.includes(slug));
const hasFurtherReading = relatedTerms.length > 0 || relatedGuides.length > 0;

// 開發與維運單位（實體歸屬）：LLM 讀正文的權重高於結構化資料，schema 有寫、正文也要寫。
// 產品站各自在別的網域，這段是官網這側「誰做的」的唯一可見出處。
const externalHost = product.externalUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
const repoName = product.repoUrl?.replace('https://github.com/', '');

const pageTitle = title ?? `${product.title} · yao.care`;
const pageDescription = description ?? product.description;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL(`/assets/images/og/${slug}.png`, SITE.url).toString();

// LLM / 搜尋引擎結構化資料：軟體應用 + 麵包屑 + FAQ
const appCategory =
  product.category === 'ai' ? 'BusinessApplication' : 'HealthApplication';

// 產品的軟體實體 @id —— 公司 Organization 的 owns 會指回這裡，形成雙向關係。
// 對外站台（如 twtxgnn.yao.care）的 schema 也用同一組 @id 回指，跨網域串成同一個實體。
const softwareAppId = `${canonical}#software`;

const softwareApp = {
  '@type': 'SoftwareApplication',
  '@id': softwareAppId,
  name: product.title,
  ...(product.alternateNames?.length ? { alternateName: product.alternateNames } : {}),
  description: product.description,
  url: canonical,
  applicationCategory: appCategory,
  operatingSystem: 'Web',
  inLanguage: 'zh-TW',
  image: ogImage,
  sameAs: [product.externalUrl, product.repoUrl, ...(product.extraSameAs ?? [])].filter(Boolean),
  // 出處歸屬：一律引用同頁的完整 Organization 節點，而非另寫一份殘缺的內嵌組織
  publisher: { '@id': ORG_ID },
  author: { '@id': ORG_ID },
  creator: { '@id': ORG_ID },
  copyrightHolder: { '@id': ORG_ID },
  provider: { '@id': ORG_ID },
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: category.label,
      item: new URL(category.href, SITE.url).toString(),
    },
    { '@type': 'ListItem', position: 3, name: product.title, item: canonical },
  ],
};

const faqPage =
  faqs.length > 0
    ? {
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  // ORGANIZATION_SCHEMA 必須同頁輸出：ProductLayout 不經 BaseLayout，過去產品頁的
  // @graph 只有 softwareApp/breadcrumb/faq，publisher 指向一個頁面上不存在的組織。
  '@graph': [ORGANIZATION_SCHEMA, softwareApp, breadcrumb, ...(faqPage ? [faqPage] : [])],
};
---
<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="author" content="yao.care" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="yao.care" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body class="bg-white text-[color:var(--color-ink)] antialiased">
    <Nav />
    <main class="pt-20">
      <!-- breadcrumb -->
      <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
        <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
        <span class="mx-1.5">›</span>
        <a href={category.href} class="hover:text-[color:var(--color-brand)]">{category.label}</a>
        <span class="mx-1.5">›</span>
        <span class="text-[color:var(--color-ink)]">{product.title}</span>
      </div>

      <slot />

      {faqs.length > 0 && (
        <section class="py-14 md:py-20 border-t border-neutral-200/70">
          <div class="max-w-3xl mx-auto px-4 lg:px-6">
            <div class="mb-8">
              <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
                FAQ
              </p>
              <h2 class="mt-2 text-2xl md:text-3xl font-bold">常見問題</h2>
            </div>
            <div class="space-y-3">
              {faqs.map((f) => (
                <details class="group rounded-xl bg-white border border-neutral-200 shadow-sm overflow-hidden">
                  <summary class="cursor-pointer p-5 md:p-6 flex items-start gap-4 list-none">
                    <span class="flex-1 font-bold text-[color:var(--color-ink)]">{f.q}</span>
                    <svg class="shrink-0 w-5 h-5 mt-0.5 text-[color:var(--color-ink-soft)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <div class="px-5 md:px-6 pb-5 md:pb-6 pt-0 text-[color:var(--color-ink-soft)] leading-relaxed border-t border-neutral-100">
                    <p class="pt-4">{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      {hasFurtherReading && (
        <section class="py-14 md:py-20 border-t border-neutral-200/70 bg-neutral-50">
          <div class="max-w-5xl mx-auto px-4 lg:px-6">
            <div class="mb-8">
              <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
                Further Reading
              </p>
              <h2 class="mt-2 text-2xl md:text-3xl font-bold">延伸閱讀</h2>
              <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)]">
                與 {product.title} 相關的名詞解釋與情境指南
              </p>
            </div>
            <div class="grid md:grid-cols-2 gap-4 md:gap-5">
              {relatedGuides.map((g) => (
                <a
                  href={`/guides/${g.slug}/`}
                  class="group block rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm hover:border-[color:var(--color-brand)] transition-colors"
                >
                  <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">情境指南</div>
                  <h3 class="font-bold text-base md:text-lg mb-2 group-hover:text-[color:var(--color-brand)]">{g.question}</h3>
                  <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed line-clamp-3">{g.answer}</p>
                </a>
              ))}
              {relatedTerms.map((t) => (
                <a
                  href={`/glossary/${t.slug}/`}
                  class="group block rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm hover:border-[color:var(--color-brand)] transition-colors"
                >
                  <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">名詞解釋</div>
                  <h3 class="font-bold text-base md:text-lg mb-2 group-hover:text-[color:var(--color-brand)]">{t.term}</h3>
                  <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed line-clamp-3">{t.oneLiner}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <slot name="news" />

      <!-- 開發與維運單位：實體歸屬的可見出處，全產品頁共用 -->
      <section class="max-w-7xl mx-auto px-4 lg:px-6 pb-12">
        <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 md:p-6">
          <h2 class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-3">開發與維運</h2>
          <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed">
            {product.title} 由<strong class="text-[color:var(--color-ink)]">{SITE.legalName}</strong>（{SITE.name}，統一編號 {SITE.taxId}，
            地址：台中市西區台灣大道二段220號12樓）開發與維運。
            {externalHost && (
              <>
                {' '}服務網站：<a href={product.externalUrl} class="underline hover:text-[color:var(--color-brand)]">{externalHost}</a>。
              </>
            )}
            {repoName && (
              <>
                {' '}原始碼：<a href={product.repoUrl} rel="noopener" class="underline hover:text-[color:var(--color-brand)]">{repoName}</a>。
              </>
            )}
            {' '}聯絡：<a href={`mailto:${SITE.email}`} class="underline hover:text-[color:var(--color-brand)]">{SITE.email}</a>
          </p>
        </div>
      </section>

      <!-- back to category hub -->
      <div class="max-w-7xl mx-auto px-4 lg:px-6 py-12 border-t border-neutral-200/70">
        <a
          href={category.href}
          class="inline-flex items-center gap-2 text-sm text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)]"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          回 {category.label}
        </a>
      </div>

      <ContactMap />
    </main>
    <FooterLinks />
  </body>
</html>
