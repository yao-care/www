---
import '../styles/global.css';
import { SITE } from '../site.config';
import { WORK_BY_SLUG, type Work } from '../works.config';
import Nav from '../components/Nav.astro';
import FooterLinks from '../components/FooterLinks.astro';

interface Props {
  slug: Work['slug'];
  /** Override title shown in <title>; defaults to "{work.title} · 藥提醒" */
  title?: string;
  /** Override description meta */
  description?: string;
}

const { slug, title, description } = Astro.props;
const work = WORK_BY_SLUG[slug];

const pageTitle = title ?? `${work.title} · 藥提醒 yao.care`;
const pageDescription = description ?? work.description;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL(`/assets/images/og/${slug}.png`, SITE.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: work.title,
  description: work.description,
  url: canonical,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
};
---
<!DOCTYPE html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="author" content="yao.care 藥提醒" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="藥提醒" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-white text-[color:var(--color-ink)] antialiased">
    <Nav />
    <main class="pt-16">
      <!-- breadcrumb -->
      <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
        <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
        <span class="mx-1.5">›</span>
        <a href="/works" class="hover:text-[color:var(--color-brand)]">作品</a>
        <span class="mx-1.5">›</span>
        <span class="text-[color:var(--color-ink)]">{work.title}</span>
      </div>

      <slot />

      <!-- back to all works -->
      <div class="max-w-7xl mx-auto px-4 lg:px-6 py-12 border-t border-neutral-200/70">
        <a
          href="/works"
          class="inline-flex items-center gap-2 text-sm text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)]"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          回作品列表
        </a>
      </div>
    </main>
    <FooterLinks />
  </body>
</html>
