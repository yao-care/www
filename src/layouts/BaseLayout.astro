---
import '../styles/global.css';
import { SITE } from '../site.config';
import { KNOWS_ABOUT, ORG_SAME_AS, ORG_AWARDS, ORG_PATENT } from '../seo.config';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** 額外 schema 節點：疊加進預設 @graph（保留 Organization+WebSite），與整包 jsonLd 互斥 */
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title = SITE.title,
  description = SITE.description,
  ogImage,
  ogType = 'website',
  jsonLd,
  extraSchema,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage ?? SITE.ogImage, SITE.url).toString();

const orgId = `${SITE.url}/#organization`;
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'MedicalOrganization'],
      '@id': orgId,
      name: SITE.name,
      legalName: SITE.legalName,
      alternateName: '藥提醒',
      url: SITE.url,
      logo: `${SITE.url}/assets/images/logo.png`,
      description: SITE.description,
      email: SITE.email,
      telephone: `+886-4-2310-0969`,
      foundingDate: SITE.founded,
      founder: { '@type': 'Person', name: SITE.founder },
      taxID: SITE.taxId,
      knowsAbout: KNOWS_ABOUT,
      award: ORG_AWARDS,
      owns: {
        '@type': 'CreativeWork',
        name: `${ORG_PATENT.name}（發明專利 ${ORG_PATENT.number}）`,
        about: '用藥提醒與回報系統',
      },
      areaServed: { '@type': 'Country', name: 'Taiwan' },
      hasMap: 'https://www.google.com/maps?cid=12025785010180313919',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '台灣大道二段220號12樓',
        addressLocality: '台中市西區',
        addressCountry: 'TW',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: SITE.email,
        telephone: `+886-4-2310-0969`,
        url: SITE.lineLink,
        availableLanguage: ['zh-TW', 'en'],
      },
      sameAs: ORG_SAME_AS,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      alternateName: '藥提醒 yao.care',
      description: SITE.description,
      inLanguage: 'zh-TW',
      publisher: { '@id': orgId },
    },
  ],
};
const finalJsonLd =
  jsonLd ??
  (extraSchema && extraSchema.length
    ? { ...defaultJsonLd, '@graph': [...defaultJsonLd['@graph'], ...extraSchema] }
    : defaultJsonLd);
---
<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="author" content="yao.care" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="keywords" content={SITE.keywords} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="yao.care" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
    <Analytics />
  </head>
  <body class="bg-white text-[color:var(--color-ink)] antialiased">
    <slot />
  </body>
</html>
