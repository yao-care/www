---
import '../styles/global.css';
import { SITE } from '../site.config';
import { ORG_ID, ORGANIZATION_SCHEMA } from '../seo.config';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** 額外 schema 節點：疊加進預設 @graph（保留 Organization+WebSite），與整包 jsonLd 互斥 */
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title = SITE.title,
  description = SITE.description,
  ogImage,
  ogType = 'website',
  jsonLd,
  extraSchema,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage ?? SITE.ogImage, SITE.url).toString();

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZATION_SCHEMA,
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      alternateName: '藥提醒 yao.care',
      description: SITE.description,
      inLanguage: 'zh-TW',
      publisher: { '@id': ORG_ID },
    },
  ],
};
const finalJsonLd =
  jsonLd ??
  (extraSchema && extraSchema.length
    ? { ...defaultJsonLd, '@graph': [...defaultJsonLd['@graph'], ...extraSchema] }
    : defaultJsonLd);
---
<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="author" content="yao.care" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="keywords" content={SITE.keywords} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="yao.care" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
    <Analytics />
  </head>
  <body class="bg-white text-[color:var(--color-ink)] antialiased">
    <slot />
  </body>
</html>
