---
import { getCollection } from 'astro:content';
import { NEWS_TARGET_BY_SLUG, SHOW_PER_PRODUCT, type NewsTargetSlug } from '../../news.config';
import NewsCard from './NewsCard.astro';

interface Props {
  target: NewsTargetSlug;
  limit?: number;
  heading?: string;
}

const { target, limit = SHOW_PER_PRODUCT, heading } = Astro.props;
const targetCfg = NEWS_TARGET_BY_SLUG[target];

const allNews = await getCollection('news', ({ data }) => data.target === target);
const items = allNews
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, limit);

const sectionHeading = heading ?? `${targetCfg.title} 議題追蹤`;
---
{items.length > 0 && (
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div>
          <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
            Issue Tracking
          </p>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold">{sectionHeading}</h2>
          <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-2xl">
            自動追蹤與本服務相關的最新議題，由 AI 蒐集公開新聞並對照本系統的設計觀點。
          </p>
        </div>
        <a href="/news/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline whitespace-nowrap">
          看全部議題追蹤
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
        {items.map((entry) => <NewsCard entry={entry} />)}
      </div>
    </div>
  </section>
)}
