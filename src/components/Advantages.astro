---
const items = [
  { icon: '/assets/images/icon/1.png', label: '用藥情形資訊' },
  { icon: '/assets/images/icon/2.png', label: '復健資訊' },
  { icon: '/assets/images/icon/3.png', label: '病人生活資訊' },
  { icon: '/assets/images/icon/4.png', label: '影像檢查資訊' },
  { icon: '/assets/images/icon/5.png', label: '中醫藥資訊' },
  { icon: '/assets/images/icon/6.png', label: '居家量測資訊' },
  { icon: '/assets/images/icon/7.png', label: '實驗室檢查資訊' },
];
---
<section id="feature" class="py-20 md:py-28 bg-neutral-50">
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-4 order-2 lg:order-1">
        <img
          src="/assets/images/222.png"
          alt="藥提醒手機介面"
          class="mx-auto max-w-xs lg:max-w-full h-auto"
          width="400" height="600"
        />
      </div>
      <div class="lg:col-span-8 order-1 lg:order-2">
        <h2 class="text-3xl md:text-4xl font-bold mb-10">
          醫院的<span class="text-[color:var(--color-brand)]">潛在優勢</span>
        </h2>
        <ul class="grid sm:grid-cols-2 gap-4">
          {items.map((it) => (
            <li class="flex items-center gap-3 p-4 rounded-lg bg-white shadow-sm border border-neutral-200">
              <img src={it.icon} alt="" class="w-10 h-10 object-contain shrink-0" width="40" height="40" />
              <span class="font-medium">{it.label}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <picture>
            <source media="(min-width: 768px)" srcset="/assets/images/littlehelp.jpg" />
            <img src="/assets/images/littlehelp_m.jpg" alt="小幫手示意" class="w-full h-auto rounded-lg" />
          </picture>
        </div>
      </div>
    </div>
  </div>
</section>
