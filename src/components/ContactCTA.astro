---
import { SITE } from '../site.config';
---
<section id="cta" class="py-20 md:py-28 bg-neutral-50">
  <div class="max-w-3xl mx-auto px-4 lg:px-6 text-center">
    <svg class="w-16 h-16 mx-auto text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 7h-3V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zm-9-2h4v2h-4V5zm5 9h-2v2h-2v-2H9v-2h2v-2h2v2h2v2z"/>
    </svg>
    <h2 class="mt-4 text-3xl md:text-4xl font-bold">
      Yao Care<span class="text-[color:var(--color-brand)]">藥提醒</span>
    </h2>
    <p class="mt-3 text-[color:var(--color-ink-soft)]">用最貼近患者的方式提醒用藥</p>
    <div class="mt-8">
      <a href={SITE.lineLink} target="_blank" rel="noopener" class="btn-line">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.92 2 10.74c0 4.32 3.55 7.94 8.35 8.62l1.06.15.13-.97-.07-.71c.08-.47-.31-.91-.78-.97l-.16-.02C5.83 16.27 3 13.81 3 10.74 3 6.48 7.03 3 12 3s9 3.48 9 7.74c0 4.26-4.03 7.74-9 7.74h-.5l-3.83 2.41a.5.5 0 0 1-.74-.55l.84-3.07A9.06 9.06 0 0 0 22 10.74C22 5.92 17.52 2 12 2z"/></svg>
        加入好友
      </a>
    </div>
  </div>
</section>
