---
import { SITE } from '../site.config';
import { CATEGORIES, productsByCategory, LINE_TEAM } from '../products.config';
import { TOPICS } from '../topics.config';

const medicalProducts = productsByCategory('medical');
const aiProducts = productsByCategory('ai');
const careProducts = productsByCategory('care');
const contactLinks = [
  { href: `mailto:${SITE.email}`, label: SITE.email },
  { href: SITE.lineLink, label: 'LINE：與工程師聯絡', external: true },
  { href: LINE_TEAM, label: 'LINE：與團隊聯絡', external: true },
  { href: SITE.mapsLink, label: SITE.address, external: true },
];
const year = new Date().getFullYear();
---
<footer class="bg-neutral-50 border-t border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 lg:px-6 py-14 md:py-20">
    <div class="grid gap-10 md:gap-12 md:grid-cols-12">
      <!-- brand block -->
      <div class="md:col-span-3">
        <a href="/" class="inline-flex items-center" aria-label="yao.care 首頁">
          <img
            src="/assets/images/logo.svg"
            alt="yao.care logo"
            class="h-10 w-auto"
            width="167" height="40"
          />
        </a>
        <p class="mt-5 max-w-md text-base text-[color:var(--color-ink-soft)] leading-relaxed">
          yao.care 用 AI 與自動化把硬問題變成可重複的系統 ——
          智慧醫療、AI 系統、高齡友善、數位行銷四條業務線，
          旗下涵蓋藥提醒、AI 華佗、TxGNN、Smart Func/Geri/Pedi 評估、長者友善無接觸報到、情報自動化、評鑑稽核、TRIZ、整合行銷等服務。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={SITE.lineLink} target="_blank" rel="noopener" class="btn-line">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.92 2 10.74c0 4.32 3.55 7.94 8.35 8.62l1.06.15.13-.97-.07-.71c.08-.47-.31-.91-.78-.97l-.16-.02C5.83 16.27 3 13.81 3 10.74 3 6.48 7.03 3 12 3s9 3.48 9 7.74c0 4.26-4.03 7.74-9 7.74h-.5l-3.83 2.41a.5.5 0 0 1-.74-.55l.84-3.07A9.06 9.06 0 0 0 22 10.74C22 5.92 17.52 2 12 2z"/></svg>
            加入 LINE
          </a>
          <a href={`mailto:${SITE.email}`} class="btn-brand">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            來信詢問
          </a>
        </div>
      </div>

      <!-- 智慧醫療 -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-widest uppercase text-[color:var(--color-brand)] mb-4">智慧醫療</p>
        <ul class="space-y-3">
          {medicalProducts.map((p) => (
            <li>
              <a href={`/medical/${p.slug}/`} class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">
                {p.ogTitle}
              </a>
            </li>
          ))}
          <li>
            <a href="/medical/" class="text-sm font-medium text-[color:var(--color-brand)] hover:underline">看全部 →</a>
          </li>
        </ul>
      </div>

      <!-- AI 系統 -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-widest uppercase text-[color:var(--color-brand)] mb-4">AI 系統</p>
        <ul class="space-y-3">
          {aiProducts.map((p) => (
            <li>
              <a href={`/ai/${p.slug}/`} class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">
                {p.ogTitle}
              </a>
            </li>
          ))}
          <li>
            <a href="/ai/" class="text-sm font-medium text-[color:var(--color-brand)] hover:underline">看全部 →</a>
          </li>
        </ul>
      </div>

      <!-- 高齡友善 -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-widest uppercase text-[color:var(--color-brand)] mb-4">高齡友善</p>
        <ul class="space-y-3">
          {careProducts.map((p) => (
            <li>
              <a href={`/care/${p.slug}/`} class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">
                {p.ogTitle}
              </a>
            </li>
          ))}
          <li>
            <a href="/medical/geri/" class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">
              Smart Geri 評估
            </a>
          </li>
          <li>
            <a href="/care/" class="text-sm font-medium text-[color:var(--color-brand)] hover:underline">看全部 →</a>
          </li>
        </ul>
      </div>

      <!-- 數位行銷 + 議題追蹤 -->
      <div class="md:col-span-1">
        <p class="text-xs font-semibold tracking-widest uppercase text-[color:var(--color-brand)] mb-4">行銷</p>
        <ul class="space-y-3">
          <li>
            <a href="/marketing/" class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">數位行銷服務</a>
          </li>
          <li>
            <a href="/guides/" class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">情境指南</a>
          </li>
          <li>
            <a href="/topics/" class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">議題追蹤</a>
          </li>
          <li>
            <a href="/news/" class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">議題追蹤封存</a>
          </li>
          <li>
            <a href="/glossary/" class="text-base text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">知識庫</a>
          </li>
        </ul>
      </div>

      <!-- contact -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-widest uppercase text-[color:var(--color-brand)] mb-4">聯絡</p>
        <ul class="space-y-3">
          {contactLinks.map((l) => (
            <li>
              <a
                href={l.href}
                {...l.external ? { target: '_blank', rel: 'noopener' } : {}}
                class="text-sm text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors leading-snug"
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 主題（9 個角度式彙整頁，全站內鏈；2026-07-15 內容重構 Phase 1） -->
    <div class="mt-10 pt-6 border-t border-neutral-200">
      <p class="text-xs font-semibold tracking-widest uppercase text-[color:var(--color-brand)] mb-3">主題</p>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        {TOPICS.map((t) => (
          <a href={`/topics/${t.slug}/`} class="text-sm text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)] transition-colors">{t.title}</a>
        ))}
      </div>
    </div>

    <!-- bottom -->
    <div class="mt-12 pt-6 border-t border-neutral-200 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-sm text-[color:var(--color-ink-muted)]">
      <p>© 2020–{year} yao.care. All rights reserved.</p>
      <p>
        Built with
        <span class="text-[color:var(--color-ink-soft)]">Astro · Tailwind · D3</span>
      </p>
    </div>
  </div>
</footer>

<button
  type="button"
  id="back-to-top"
  class="fixed bottom-6 right-6 w-11 h-11 rounded-full bg-[color:var(--color-brand)] text-white shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition"
  aria-label="回到頂部"
>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 11 12 6 7 11"/><polyline points="17 18 12 13 7 18"/></svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    if (!btn) return;
    if (window.scrollY > 400) {
      btn.classList.remove('opacity-0', 'pointer-events-none');
      btn.classList.add('opacity-100');
    } else {
      btn.classList.add('opacity-0', 'pointer-events-none');
      btn.classList.remove('opacity-100');
    }
  });
  btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
