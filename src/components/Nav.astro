---
import { NAV } from '../nav.config';
---
<nav
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur border-b border-neutral-200/60"
>
  <div class="max-w-7xl mx-auto px-4 lg:px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center" aria-label="yao.care 首頁">
      <img
        src="/assets/images/logo.svg"
        alt="yao.care logo"
        class="h-9 w-auto"
        width="150"
        height="36"
      />
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-md text-[color:var(--color-brand)]"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="切換選單"
    >
      <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <ul
      id="nav-menu"
      class="hidden lg:flex items-center gap-1 lg:gap-2 absolute lg:static inset-x-0 top-full lg:top-auto bg-white lg:bg-transparent border-b lg:border-0 border-neutral-200/60 px-4 lg:px-0 py-3 lg:py-0 flex-col lg:flex-row"
    >
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class="block px-3 py-2 text-sm font-medium text-[color:var(--color-ink)] rounded-md hover:text-[color:var(--color-brand)] transition-colors"
            data-nav-link
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 1023px)').matches) {
        menu?.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
