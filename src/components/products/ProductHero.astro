---
import type { Product } from '../../products.config';

interface Props {
  product: Product;
  /** Override what shows above the title; defaults to cardKicker */
  kicker?: string;
}

const { product, kicker } = Astro.props;
const displayKicker = kicker ?? product.cardKicker;
---
<section class="relative pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
  <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-orange-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
    <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
      {displayKicker}
    </p>
    <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight max-w-4xl">
      {product.title}
    </h1>
    <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
      {product.tagline}
    </p>
    {product.externalUrl && (
      <div class="mt-6">
        <a
          href={product.externalUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-sm font-medium text-[color:var(--color-brand)] hover:underline underline-offset-4"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          {product.externalUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}
        </a>
      </div>
    )}
    <slot name="hero-extras" />
  </div>
</section>
