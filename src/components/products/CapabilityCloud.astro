---
interface Props {
  kicker?: string;
  title?: string;
  description?: string;
  capabilities: readonly { label: string; en: string }[];
}

const {
  kicker = 'Capabilities',
  title = '我們也能做',
  description,
  capabilities,
} = Astro.props;
---
<section class="py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-4 lg:px-6">
    <div class="text-center mb-10">
      <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
        {kicker}
      </p>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold">{title}</h2>
      {description && (
        <p class="mt-3 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-2xl mx-auto leading-relaxed">
          {description}
        </p>
      )}
    </div>
    <ul class="flex flex-wrap justify-center gap-2 md:gap-3">
      {capabilities.map((c) => (
        <li class="inline-flex flex-col items-center px-4 md:px-5 py-2.5 md:py-3 rounded-full bg-white border border-neutral-200 hover:border-[color:var(--color-brand)] transition-colors">
          <span class="text-sm font-medium text-[color:var(--color-ink)]">{c.label}</span>
          <span class="text-xs text-[color:var(--color-ink-muted)] tracking-wide mt-0.5">{c.en}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
