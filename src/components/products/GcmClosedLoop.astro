---
// GCM SMART on FHIR 收案閉環 panel
// 用在 /medical（評估生態系區塊尾端）與 /care hub，把三個 CDS 自評工具
// 與 GCM 收案後端串成一條預防醫學閉環。GCM 後端為 private repo、無對外站，
// 故以「閉環基礎建設」呈現，不另開產品頁。
interface Props {
  /** 區塊上方小標 */
  kicker?: string;
  /** 是否使用淺灰底（嵌在白底區塊時設 true 比較分層） */
  tinted?: boolean;
  /** 「深入了解」連結；設 null 隱藏（GCM 頁自身用） */
  detailHref?: string | null;
}
const { kicker = 'Closed Loop · SMART on FHIR', tinted = true, detailHref = '/medical/fhir-server' } = Astro.props;

const steps = [
  {
    n: '1',
    title: '瀏覽器自評',
    body: 'Smart Func / Geri / Pedi 在裝置端完成評估，產生標準 QuestionnaireResponse（FHIR R4）。',
  },
  {
    n: '2',
    title: '選擇送出收案',
    body: '民眾自願選擇將結果送交 GCM；僅填暱稱、由系統產生收案碼，免帳號密碼。',
  },
  {
    n: '3',
    title: 'GCM 後端收案',
    body: '收案伺服器以 OAuth 2.0 + PKCE 接收資料；同一收案碼的重複評估自動歸戶。',
  },
  {
    n: '4',
    title: '個案管理追蹤',
    body: '後台狀態追蹤、團隊指派、進度註記；危險訊號自動升級，全程可稽核、每日加密備份異地備援。',
  },
];
---
<section class:list={['py-14 md:py-20', tinted ? 'bg-neutral-50' : '']}>
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <div class="text-center mb-10 md:mb-12">
      <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
        {kicker}
      </p>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold">GCM SMART on FHIR 收案閉環</h2>
      <p class="mt-3 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-3xl mx-auto leading-relaxed">
        三個自評工具不是各自獨立的小程式 —— 它們以 SMART on FHIR 標準匯流到
        <strong class="text-[color:var(--color-ink)]">GCM 收案伺服器</strong>，
        把「自評 → 收案 → 個案管理」串成一條可追蹤、可稽核的預防醫學閉環。
        GCM 為
        <a href="https://gcm.org.tw" target="_blank" rel="noopener" class="text-[color:var(--color-brand)] hover:underline underline-offset-2">預防醫學發展協會</a>。
      </p>
    </div>

    <ol class="grid gap-4 md:gap-5 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="relative rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="shrink-0 w-9 h-9 rounded-lg bg-[color:var(--color-brand)] text-white flex items-center justify-center font-bold tabular-nums">
              {s.n}
            </span>
            <h3 class="font-bold text-[color:var(--color-ink)]">{s.title}</h3>
          </div>
          <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{s.body}</p>
          {i < steps.length - 1 && (
            <span class="hidden md:block absolute top-1/2 -right-3 z-10 text-[color:var(--color-brand)]" aria-hidden="true">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs md:text-sm text-[color:var(--color-ink-soft)]">
      <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-brand)]"></span> FHIR R4 QuestionnaireResponse</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-brand)]"></span> OAuth 2.0 + PKCE</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-brand)]"></span> 暱稱 + 收案碼，免帳密</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-brand)]"></span> 符合 Inferno FHIR 測試</span>
    </div>

    {detailHref && (
      <div class="mt-8 text-center">
        <a href={detailHref} class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline underline-offset-4">
          深入了解 GCM 收案伺服器
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    )}
  </div>
</section>
