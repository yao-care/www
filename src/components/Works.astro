---
import { WORKS } from '../works.config';
---
<section id="works" class="py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <div class="text-center mb-3">
      <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Our Works</p>
    </div>
    <h2 class="section-title">作品集</h2>
    <p class="section-subtitle">
      AI + 自動化處理硬問題 — 從醫療到行銷、從合規到情報，
      <a href="/works" class="text-[color:var(--color-brand)] underline-offset-4 hover:underline">看完整作品列表 →</a>
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {WORKS.map((w) => (
        <a
          href={`/works/${w.slug}`}
          class="group block rounded-xl border border-neutral-200 bg-white p-5 hover:shadow-lg hover:-translate-y-0.5 transition-all"
        >
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex w-8 h-8 rounded-md items-center justify-center bg-orange-50 text-[color:var(--color-brand)] font-bold tabular-nums text-sm">
              {w.ogStat}
            </span>
            <span class="text-xs font-medium tracking-widest uppercase text-[color:var(--color-ink-soft)]">
              {w.cardKicker}
            </span>
          </div>
          <h3 class="font-bold text-base text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors leading-snug">
            {w.title}
          </h3>
          <p class="mt-2 text-xs text-[color:var(--color-ink-soft)] leading-relaxed line-clamp-3">
            {w.tagline}
          </p>
          <div class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-[color:var(--color-brand)]">
            了解更多
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/works" class="btn-brand">
        瀏覽全部作品
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
