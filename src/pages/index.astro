---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ProductCard from '../components/products/ProductCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ContactMap from '../components/ContactMap.astro';
import FooterLinks from '../components/FooterLinks.astro';
import CareTag from '../components/CareTag.astro';
import HighlightNews from '../components/news/HighlightNews.astro';
import { CATEGORIES, CATEGORY_BY_SLUG, productsByCategory, PRODUCT_BY_SLUG } from '../products.config';

const medicalProducts = productsByCategory('medical');
const aiProducts = productsByCategory('ai');
const careProducts = productsByCategory('care');
const marketingCategory = CATEGORY_BY_SLUG.marketing;
const medicalCategory = CATEGORY_BY_SLUG.medical;
const aiCategory = CATEGORY_BY_SLUG.ai;
const careCategory = CATEGORY_BY_SLUG.care;
const geri = PRODUCT_BY_SLUG.geri; // 高齡友善 section 交叉預覽
const ods = PRODUCT_BY_SLUG.ods;
---
<BaseLayout>
  <Nav />
  <main>
    <!-- Hero — company-level intro -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-40 right-0 w-96 h-96 rounded-full bg-orange-100/60 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-4 lg:px-6 relative">
        <img
          src="/assets/images/logo.svg"
          alt="yao.care"
          class="h-12 w-auto mb-6"
          width="200" height="48"
        />
        <h1 class="text-4xl md:text-6xl font-bold leading-tight max-w-4xl">
          <span class="text-neutral-700">yao.care</span>
          <span class="block mt-2">用 AI 接手專業領域的<span class="text-[color:var(--color-brand)]">硬問題</span></span>
        </h1>
        <p class="mt-7 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          藥提醒每天在 LINE 上提醒人按時吃藥，AI 華佗的每一步辨證都追得到規則與證據，
          Smart Geri 幫長輩篩衰弱，情報系統半夜自己跑完 500 家公司。四條業務線，做的都是上線之後還會繼續運轉的東西。
        </p>

        <!-- category anchors -->
        <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5 max-w-5xl">
          {CATEGORIES.map((c) => (
            <a
              href={c.href}
              class="group rounded-xl bg-white/80 backdrop-blur border border-neutral-200 hover:border-[color:var(--color-brand)] hover:bg-white px-4 py-3 md:px-5 md:py-4 shadow-sm hover:shadow-md transition-all"
            >
              <div class="flex items-baseline gap-2 mb-1.5">
                <span class="text-lg md:text-xl font-bold leading-none text-[color:var(--color-brand)]">{c.caretag.yao}</span>
                <span class="text-lg md:text-xl font-bold leading-none text-[color:var(--color-ink)]">・{c.caretag.word}</span>
                <span class="text-[10px] md:text-xs font-medium text-[color:var(--color-ink-soft)] tracking-wide">(care)</span>
              </div>
              <div class="text-xs font-medium tracking-widest uppercase text-[color:var(--color-brand)]/80">
                {c.kicker}
              </div>
              <div class="text-base md:text-lg font-bold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors mt-0.5">
                {c.label}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 信任條：獎項與專利 -->
    <section class="border-y border-neutral-200 bg-neutral-50/60">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 py-5 md:py-6">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 md:gap-x-10 text-sm text-[color:var(--color-ink-soft)]">
          {[
            '衛福部醫療科技展肯定',
            'SNQ 國家品質標章',
            '高血脂照護競賽金牌',
            '發明專利 TW202202123A',
          ].map((label) => (
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
              <span class="font-medium text-[color:var(--color-ink)]">{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 智慧醫療 -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <CareTag caretag={medicalCategory.caretag} size="md" class="mb-3" />
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              Smart Healthcare
            </p>
            <h2 class="mt-2 text-3xl md:text-4xl font-bold">智慧醫療</h2>
            <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink-soft)] max-w-2xl leading-relaxed">
              以病人為中心：用藥提醒、診斷推理、全齡評估。對齊 ATC、SMART on FHIR、TWCM 等國際標準，跟既有醫療系統接得上。
            </p>
          </div>
          <a href="/medical/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline whitespace-nowrap">
            瀏覽智慧醫療全部
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-5 md:gap-6">
          {medicalProducts.map((p) => <ProductCard product={p} variant="preview" />)}
        </div>
      </div>
    </section>

    <!-- AI 系統 -->
    <section class="py-16 md:py-24 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <CareTag caretag={aiCategory.caretag} size="md" class="mb-3" />
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              AI Systems
            </p>
            <h2 class="mt-2 text-3xl md:text-4xl font-bold">AI 系統</h2>
            <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink-soft)] max-w-2xl leading-relaxed">
              把老手才會的判斷寫成 AI 系統：跑完看得到結果，出錯查得出是哪一步。情報、合規、創新方法三條線都在跑。
            </p>
          </div>
          <a href="/ai/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline whitespace-nowrap">
            瀏覽 AI 系統全部
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-5 md:gap-6">
          {aiProducts.map((p) => <ProductCard product={p} variant="preview" />)}
        </div>
        <div class="mt-8 rounded-2xl border border-orange-200 bg-orange-50/60 px-5 py-4 md:px-6 md:py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <p class="text-sm md:text-base text-[color:var(--color-ink)] leading-relaxed">
            正在找公文範例或格式檢核？先到 <strong>{ods.title}</strong> 看案例，再依身分進入申請或自助註冊流程。
          </p>
          <a
            href={ods.cta.href}
            data-cta={ods.cta.content}
            target="_blank"
            rel="noopener"
            class="shrink-0 inline-flex items-center justify-center gap-1.5 rounded-lg bg-[color:var(--color-brand)] px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity"
          >
            立即前往 ODS
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 高齡友善 -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <CareTag caretag={careCategory.caretag} size="md" class="mb-3" />
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              Age-Friendly Care
            </p>
            <h2 class="mt-2 text-3xl md:text-4xl font-bold">高齡友善</h2>
            <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink-soft)] max-w-2xl leading-relaxed">
              長者走過鏡頭就完成報到，據點不必再排隊簽名；衰弱的徵兆用周全性評估提早篩出來。臉部資料留在裝置裡，不上雲端。
            </p>
          </div>
          <a href="/care/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline whitespace-nowrap">
            瀏覽高齡友善全部
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
          {careProducts.map((p) => <ProductCard product={p} variant="preview" />)}
          <ProductCard product={geri} variant="preview" />
        </div>
      </div>
    </section>

    <!-- 數位行銷 -->
    <section class="py-16 md:py-24 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <CareTag caretag={marketingCategory.caretag} size="md" class="mb-3" />
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              Digital Marketing
            </p>
            <h2 class="mt-2 text-3xl md:text-4xl font-bold">數位行銷</h2>
            <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink-soft)] max-w-2xl leading-relaxed">
              {marketingCategory.tagline}。{marketingCategory.description}
            </p>
          </div>
          <a href="/marketing/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline whitespace-nowrap">
            了解整合行銷服務
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

        <!-- 5 環閉環 preview -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-4">
          {[
            { kicker: 'Strategy', title: '策略診斷' },
            { kicker: 'Content', title: '內容製作' },
            { kicker: 'KOL', title: '醫友操盤' },
            { kicker: 'Ads', title: '廣告投放' },
            { kicker: 'Compliance', title: '法規合規' },
          ].map((s, i) => (
            <a href="/marketing/" class="group rounded-xl border border-neutral-200 bg-white hover:border-[color:var(--color-brand)] p-4 md:p-5 transition-colors">
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-xl font-bold text-[color:var(--color-brand)] tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-ink-soft)]">{s.kicker}</span>
              </div>
              <h3 class="font-bold text-sm text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors">
                {s.title}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 知識庫入口：名詞解釋 + 情境指南（目前僅頁尾可見，補一個首頁顯眼入口） -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="mb-10">
          <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
            Knowledge Base
          </p>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold">知識庫</h2>
          <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink-soft)] max-w-2xl leading-relaxed">
            把常見的醫療 AI 名詞與情境問題講清楚，隨時可查。
          </p>
        </div>
        <div class="grid sm:grid-cols-2 gap-5 md:gap-6">
          <a href="/glossary/" class="group rounded-xl border border-neutral-200 bg-white hover:border-[color:var(--color-brand)] hover:shadow-md p-6 md:p-8 transition-all">
            <h3 class="text-xl font-bold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors">名詞解釋</h3>
            <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)] leading-relaxed">
              SMART on FHIR、ATC 藥品碼、CFS、ASQ-3、內在能力、生成式 AI 指引，這些名詞一則一則講清楚。
            </p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)]">
              瀏覽名詞解釋
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
          <a href="/guides/" class="group rounded-xl border border-neutral-200 bg-white hover:border-[color:var(--color-brand)] hover:shadow-md p-6 md:p-8 transition-all">
            <h3 class="text-xl font-bold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors">情境指南</h3>
            <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)] leading-relaxed">
              標題就是你會打進搜尋框的那句話。先給直接可用的答案，最後才提我們哪個服務幫得上忙。
            </p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)]">
              瀏覽情境指南
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        </div>
        <div class="mt-8">
          <p class="text-sm font-medium text-[color:var(--color-ink)] mb-3">常被查的名詞與指南</p>
          <div class="flex flex-wrap gap-2">
          <a href="/glossary/llm/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">大型語言模型 LLM</a>
          <a href="/glossary/ai-agent/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">AI Agent</a>
          <a href="/glossary/rag/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">RAG 檢索增強生成</a>
          <a href="/glossary/smart-on-fhir/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">SMART on FHIR</a>
          <a href="/guides/fhir-connectathon/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">FHIR 聯測要準備什麼</a>
          <a href="/glossary/asq3/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">ASQ-3</a>
          <a href="/guides/child-development-delay/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">2 歲還不太會說話</a>
          <a href="/guides/asq3-scoring-guide/" class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">ASQ-3 怎麼計分</a>
          </div>
        </div>
      </div>
    </section>

    <HighlightNews />
    <ContactCTA />
    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
