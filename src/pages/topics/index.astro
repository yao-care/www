---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import { TOPICS } from '../../topics.config';
import { SITE } from '../../site.config';

const pageTitle = '主題 · yao.care';
const pageDescription =
  '用藥安全、高齡照護、兒童發展、預防醫學、醫療 AI、合規治理、產業情報、創新方法、行銷法規 — 每個主題一個判斷角度，把該領域的現況、數據與 yao.care 的回應整理在同一頁。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageTitle,
  itemListElement: TOPICS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.title,
    url: new URL(`/topics/${t.slug}/`, SITE.url).toString(),
  })),
};
---
<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Nav />
  <main class="pt-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">主題</span>
    </div>

    <section class="relative pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Topics</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight">主題</h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          每個主題用一個判斷角度貫穿：這個領域正在發生什麼、該怎麼讀，以及 yao.care 怎麼回應。
        </p>
      </div>
    </section>

    <section class="py-10 md:py-14">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
          {TOPICS.map((t) => (
            <a href={`/topics/${t.slug}/`} class="group block rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all">
              <p class="text-xs font-medium tracking-widest uppercase text-[color:var(--color-brand)]">{t.lens}</p>
              <h2 class="mt-2 text-lg font-bold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors leading-snug">{t.title}</h2>
              <p class="mt-3 text-sm text-[color:var(--color-ink-soft)] leading-relaxed line-clamp-3">{t.answerFirst}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)]">
                看整頁
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
