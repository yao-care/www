---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import { TOPICS, TOPIC_BY_SLUG } from '../../topics.config';
import { NEWS_TARGET_BY_SLUG } from '../../news.config';
import { GUIDES } from '../../guides.config';
import { GLOSSARY } from '../../glossary.config';
import { SITE } from '../../site.config';
import { feedAnchorId } from '../../lib/topic-feed';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const topic = TOPIC_BY_SLUG[slug!];
const products = topic.products.map((p) => NEWS_TARGET_BY_SLUG[p]).filter(Boolean);
// Phase 3 掛靠：同主題的解答層（guides）與名詞層（glossary），URL 不動、僅內鏈與 isPartOf
const relGuides = GUIDES.filter((g) => g.topic === topic.slug);
const relTerms = GLOSSARY.filter((t) => t.topic === topic.slug);

// 近期動態：產線每日餵進來的新聞條目（初始批次由既有語料回填）。
// 2026-07-28：不再 slice——**全部**條目都渲染進 HTML（爬蟲與無 JS 訪客看得到全部），
// 前端預設只顯示前 FEED_INITIAL 筆，其餘由「看更多」每次展開 FEED_STEP 筆直到全部顯示。
// /topics/ 總覽卡片顯示的「動態 N 則」＝這裡的 feed.length，兩邊一致（勿再改回 slice，否則又對不上）。
const FEED_INITIAL = 10;
const FEED_STEP = 10;
const feedAll = await getCollection('topicFeed', (e) => e.data.topic === topic.slug);
const feed = feedAll.sort((a, b) => b.data.fetchedAt.getTime() - a.data.fetchedAt.getTime());
const feedLatest = feed[0]?.data.fetchedAt;
// 一律以台北時區成日（主機跑 UTC；topics/index.astro 有相同的 fmtDate，兩處要一起改）
const fmtDate = (d: Date) => d.toLocaleDateString('sv-SE', { timeZone: 'Asia/Taipei' });

const pageTitle = `${topic.title} · yao.care`;
const pageDescription = topic.answerFirst;
const canonical = new URL(`/topics/${topic.slug}/`, SITE.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: topic.title,
      description: topic.answerFirst,
      inLanguage: 'zh-TW',
      mainEntityOfPage: canonical,
      ...(feedLatest ? { dateModified: feedLatest.toISOString() } : {}),
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
        logo: { '@type': 'ImageObject', url: `${SITE.url}/assets/images/logo.png` },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: '主題', item: new URL('/topics', SITE.url).toString() },
        { '@type': 'ListItem', position: 3, name: topic.title, item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: topic.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogType="article"
  jsonLd={jsonLd}
  feeds={[{ title: '主題動態 — yao.care', href: '/topics/rss.xml' }]}
>
  <Nav />
  <main class="pt-20">
    <!-- breadcrumb -->
    <div class="max-w-3xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <a href="/topics/" class="hover:text-[color:var(--color-brand)]">主題</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">{topic.title}</span>
    </div>

    <article class="max-w-3xl mx-auto px-4 lg:px-6 py-8 md:py-12">
      <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">{topic.lens}</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold leading-tight">{topic.title}</h1>

      <!-- answer first -->
      <p class="mt-5 text-lg md:text-xl text-[color:var(--color-ink)] leading-relaxed font-medium border-l-4 border-[color:var(--color-brand)] pl-4">
        {topic.answerFirst}
      </p>

      <!-- sections -->
      <div class="mt-10 space-y-10 topic-body">
        {topic.sections.map((s) => (
          <section>
            <h2 class="text-xl md:text-2xl font-bold text-[color:var(--color-ink)]">{s.heading}</h2>
            <div class="mt-3 space-y-3 text-base text-[color:var(--color-ink-soft)] leading-relaxed">
              {s.paragraphs.map((p) => <p set:html={p} />)}
            </div>
            {s.bullets && (
              <ul class="mt-4 space-y-2.5">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-[color:var(--color-ink)]">
                    <svg class="w-5 h-5 mt-0.5 shrink-0 text-[color:var(--color-brand)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span set:html={b} />
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </article>

    <!-- 近期動態（產線每日更新；連結為原始報導） -->
    {feed.length > 0 && (
      <section class="max-w-3xl mx-auto px-4 lg:px-6 pb-10">
        <div class="pt-8 border-t border-neutral-200">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-xl md:text-2xl font-bold">近期動態</h2>
            <p class="text-xs text-[color:var(--color-ink-muted)]">
              共 {feed.length} 則．持續更新．連結為原始報導
            </p>
          </div>
          {/* 訂閱入口：九個主題共用同一支 feed（/topics/rss.xml），每則的連結會回到本頁該則錨點 */}
          <a
            href="/topics/rss.xml"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)] hover:underline"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
            用 RSS 訂閱主題動態
          </a>
          {/* 摺疊用自有屬性 data-collapsed，不用 hidden 屬性：Tailwind v4 preflight 對 [hidden] 下的
              display:none 帶強制旗標，noscript 覆寫贏不了它，而設計規範禁用該旗標（check-design 規則 3）。 */}
          <style is:inline>[data-feed-item][data-collapsed] { display: none; }</style>
          <ul id="topic-feed" class="mt-5 space-y-5">
            {feed.map((e, i) => (
              <li id={feedAnchorId(e.id)} class="leading-relaxed scroll-mt-24" data-feed-item data-collapsed={i >= FEED_INITIAL ? '' : undefined}>
                <p class="text-sm">
                  <span class="text-[color:var(--color-ink-muted)] tabular-nums">{fmtDate(e.data.publishedAt)}</span>
                  <a href={e.data.url} target="_blank" rel="noopener" class="ml-2 font-medium text-[color:var(--color-ink)] hover:text-[color:var(--color-brand)] transition-colors">{e.data.title}</a>
                  <span class="text-[color:var(--color-ink-muted)]">（{e.data.source}）</span>
                </p>
                <p class="mt-1 text-sm text-[color:var(--color-ink-soft)]">{e.data.takeaway}</p>
              </li>
            ))}
          </ul>
          {feed.length > FEED_INITIAL && (
            <div
              class="mt-6"
              id="topic-feed-more"
              data-feed-target="topic-feed"
              data-feed-step={String(FEED_STEP)}
              hidden
            >
              <button
                type="button"
                class="inline-flex items-center gap-1.5 rounded-full border border-neutral-300 px-4 py-2 text-sm font-medium text-[color:var(--color-ink)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors"
              >
                看更多（還有 <span data-feed-remaining>{feed.length - FEED_INITIAL}</span> 則）
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          )}
          {/* 無 JS 時（含不執行 JS 的爬蟲）把摺疊的條目全部攤開，避免「看更多」按不動就少一半內容。
              這條在文件順序上晚於上面的摺疊規則故勝出；style/script 都必須 is:inline——否則 Astro 會把
              <style> 抽成打包 CSS、脫離 <noscript>，變成任何情況都全展開，摺疊直接失效。 */}
          <noscript>
            <style is:inline>[data-feed-item][data-collapsed] { display: list-item; }</style>
          </noscript>
          <script is:inline>
            (function () {
              var box = document.getElementById('topic-feed-more');
              var list = box && document.getElementById(box.dataset.feedTarget);
              if (!box || !list) return;
              var step = parseInt(box.dataset.feedStep, 10) || 10;
              var btn = box.querySelector('button');
              var left = box.querySelector('[data-feed-remaining]');
              var collapsed = function () { return list.querySelectorAll('[data-feed-item][data-collapsed]'); };
              var sync = function () {
                var n = collapsed().length;
                box.hidden = n === 0;
                if (n > 0) left.textContent = String(n);
              };
              box.hidden = false; // 有 JS 才出現按鈕（無 JS 時條目已由 noscript 全展開）
              btn.addEventListener('click', function () {
                var batch = collapsed();
                for (var i = 0; i < step && i < batch.length; i++) batch[i].removeAttribute('data-collapsed');
                sync();
              });
              // RSS 的每則都連到該則的錨點（見 lib/topic-feed.ts）；若那則還在摺疊區，
              // 瀏覽器捲不到隱藏元素，
              // 訂閱者會落在頁首。這裡把該則（含它之前的）全部展開再捲過去。
              var openHash = function () {
                var id = decodeURIComponent(location.hash.replace('#', ''));
                if (!id) return;
                var el = document.getElementById(id);
                if (!el || !list.contains(el)) return;
                var items = Array.prototype.slice.call(list.querySelectorAll('[data-feed-item]'));
                var idx = items.indexOf(el);
                for (var i = 0; i <= idx; i++) items[i].removeAttribute('data-collapsed');
                sync();
                el.scrollIntoView();
              };
              openHash();
              window.addEventListener('hashchange', openHash);
            })();
          </script>
        </div>
      </section>
    )}

    <!-- product response -->
    <section class="py-12 md:py-16 bg-neutral-50">
      <div class="max-w-3xl mx-auto px-4 lg:px-6">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">yao.care 怎麼回應</p>
        <div class="mt-5 space-y-5">
          {topic.ctas.map((c) => {
            const t = NEWS_TARGET_BY_SLUG[c.product];
            return (
              <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
                <a href={t.pageUrl} class="text-lg font-bold text-[color:var(--color-ink)] hover:text-[color:var(--color-brand)] transition-colors">{t.title}</a>
                <p class="mt-2 text-sm text-[color:var(--color-ink-soft)] leading-relaxed topic-body" set:html={c.text} />
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-14 md:py-20">
      <div class="max-w-3xl mx-auto px-4 lg:px-6">
        <div class="mb-8">
          <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">FAQ</p>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold">常見問題</h2>
        </div>
        <div class="space-y-3">
          {topic.faqs.map((f) => (
            <details class="group rounded-xl bg-white border border-neutral-200 shadow-sm overflow-hidden">
              <summary class="cursor-pointer p-5 md:p-6 flex items-start gap-4 list-none">
                <span class="flex-1 font-bold text-[color:var(--color-ink)]">{f.q}</span>
                <svg class="shrink-0 w-5 h-5 mt-0.5 text-[color:var(--color-ink-soft)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="px-5 md:px-6 pb-5 md:pb-6 pt-0 text-[color:var(--color-ink-soft)] leading-relaxed border-t border-neutral-100">
                <p class="pt-4">{f.a}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- sources -->
        <div class="mt-10 pt-6 border-t border-neutral-200 text-sm text-[color:var(--color-ink-soft)]">
          <p class="font-medium text-[color:var(--color-ink)] mb-2">引用來源</p>
          <ul class="space-y-1.5">
            {topic.sources.map((s) => (
              <li class="leading-relaxed">
                <a href={s.url} target="_blank" rel="noopener" class="text-[color:var(--color-brand)] hover:underline underline-offset-2 break-all">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 深入閱讀：掛靠的指南與名詞（Phase 3） -->
        {(relGuides.length > 0 || relTerms.length > 0) && (
          <div class="mt-10 pt-6 border-t border-neutral-200">
            <p class="text-sm font-medium text-[color:var(--color-ink)] mb-3">深入閱讀</p>
            <div class="flex flex-wrap gap-2">
              {relGuides.map((g) => (
                <a href={`/guides/${g.slug}/`} class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">{g.question}</a>
              ))}
              {relTerms.map((t) => (
                <a href={`/glossary/${t.slug}/`} class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">{t.term}</a>
              ))}
            </div>
          </div>
        )}

        <!-- related products chips -->
        {products.length > 0 && (
          <div class="mt-10 pt-6 border-t border-neutral-200">
            <p class="text-sm font-medium text-[color:var(--color-ink)] mb-3">相關服務</p>
            <div class="flex flex-wrap gap-2">
              {products.map((p) => (
                <a href={p.pageUrl} class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">
                  {p.title}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- back -->
    <div class="max-w-3xl mx-auto px-4 lg:px-6 pb-12">
      <a href="/topics/" class="inline-flex items-center gap-2 text-sm text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)]">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        看更多主題
      </a>
    </div>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>

<style is:global>
  .topic-body a { color: var(--color-brand); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: color-mix(in srgb, var(--color-brand) 40%, transparent); word-break: break-all; }
  .topic-body a:hover { text-decoration-color: var(--color-brand); }
</style>
