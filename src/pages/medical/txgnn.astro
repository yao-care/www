---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import RelatedTopics from '../../components/products/RelatedTopics.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';
import { TXGNN_SITES, txgnnSiteUrl, txgnnSiteBrand } from '../../seo.config';
import countries from '../../data/txgnn-countries.json';
import worldmap from '../../data/txgnn-worldmap.json';
import { TXGNN_GALLERY_APPS, GALLERY_ORG_URL } from '../../lib/smart-gallery';

const product = PRODUCT_BY_SLUG.txgnn;

// ─── 對外數字（2026-11-12 自線上資料重抓） ───────────────────────────────────
// 國家數、語言數、藥物頁數、FHIR 檔數、查核紀錄筆數一律由 txgnn-countries.json 算出，不寫死。
// 重抓方法（要更新時照做，並改 counts_date／drug_pages_date）：
//   drug_pages     ＝ https://{cc}txgnn.yao.care/data/drugs.json 的 drugs 陣列長度（只含公開藥物頁，不含 noindex 與轉址頁）
//   fhir_resources ＝ 各站公開 repo（github.com/yao-care/{Cc}TxGNN）docs/fhir/MedicationKnowledge 與 ClinicalUseDefinition 的 .json 檔數合計（不含彙總 Bundle）；
//                    用 git ls-tree -z 或 core.quotepath=false 數，否則非 ASCII 檔名（如巴西的 etoposídeo.json）會被漏算
//   review_records ＝ 同 repo docs/_data/drug_reviews.json 的 records 筆數
//   basis_zh／basis_short ＝ 各站 /sources/ 頁寫的實際資料依據（不一定是藥監局許可證）
// 頁面不提四級信心度（very_high／high／medium／low 是內部排序用），只講模型分數與證據等級。
const nf = (n: number) => n.toLocaleString('en-US');
const sum = (k: 'drug_pages' | 'fhir_resources' | 'review_records') => countries.reduce((a, c) => a + (c[k] ?? 0), 0);
const totalDrugPages = sum('drug_pages');
const totalFhir = sum('fhir_resources');
const totalReviews = sum('review_records');
const drugPagesDate = countries[0]?.drug_pages_date ?? '';
const countsDate = countries[0]?.counts_date ?? '';
// 「約 1.7 萬」這種寫法：四捨五入到千位，以萬為單位
const wan = (n: number, digits = 1) => `約 ${(n / 10000).toFixed(digits)} 萬`;
// 這一頁內容最後核對日（JSON-LD dateModified 用）
const PAGE_MODIFIED = '2026-11-12';

const LANG_ZH: Record<string, string> = {
  en: '英文', zh: '中文', ja: '日文', ko: '韓文', ar: '阿拉伯文', de: '德文', ms: '馬來文',
  es: '西班牙文', pt: '葡萄牙文', fi: '芬蘭文', no: '挪威文', da: '丹麥文', fr: '法文',
  it: '義大利文', sv: '瑞典文', th: '泰文', nl: '荷蘭文',
};
const baseLang = (tag: string) => tag.split('-')[0].toLowerCase();
const langCount = new Set(countries.flatMap((c) => (c.langs ?? []).map(baseLang))).size;
const langLabel = (tags: string[] | null) =>
  [...new Set((tags ?? []).map(baseLang))].map((l) => (l === 'zh' ? '繁體中文' : LANG_ZH[l] ?? l)).join('、');

const siteName = Object.fromEntries(TXGNN_SITES.map((s) => [s.code, s.name]));
const siteFlag = Object.fromEntries(TXGNN_SITES.map((s) => [s.code, s.flag]));
const byIso = Object.fromEntries(countries.map((c) => [c.iso2, c]));
const info = (code: string) => {
  const c = byIso[code];
  return {
    code,
    name: siteName[code] ?? c?.zh ?? code,
    flag: siteFlag[code] ?? '',
    url: txgnnSiteUrl(code),
    pages: c?.drug_pages != null ? nf(c.drug_pages) : '',
    date: c?.drug_pages_date ?? '',
    langs: c ? langLabel(c.langs) : '',
    basis: c?.basis_zh ?? '',
    basisShort: c?.basis_short ?? '',
    brand: txgnnSiteBrand(code),
  };
};

const REGIONS: { label: string; codes: string[] }[] = [
  { label: '亞洲', codes: ['tw', 'jp', 'kr', 'hk', 'sg', 'my', 'th', 'ph', 'in'] },
  { label: '歐洲', codes: ['eu', 'uk', 'de', 'fr', 'it', 'es', 'nl', 'ch', 'se', 'no', 'dk', 'fi'] },
  { label: '北美洲', codes: ['us', 'ca'] },
  { label: '中南美洲', codes: ['br', 'ar', 'co'] },
  { label: '大洋洲', codes: ['au', 'nz'] },
  { label: '中東與非洲', codes: ['sa', 'za'] },
];

// ─── 插圖（codex image_gen 產生，2026-10-16；圖內無文字） ───────────────────
const IMG = {
  hero: { src: '/assets/images/txgnn/hero.webp', w: 1600, h: 900, alt: '一顆膠囊延伸出多條路徑，通往肺、心臟、大腦、皮膚與血管的插圖' },
  countries: { src: '/assets/images/txgnn/countries.webp', w: 1200, h: 675, alt: '一顆藥丸被幾份樣式不同、蓋著印章的核准文件圍繞的插圖' },
  smart: { src: '/assets/images/txgnn/smart.webp', w: 1200, h: 675, alt: '醫師在診間看電腦上病歷畫面的插圖' },
};

// ─── 例子卡片（資料陣列驅動，換例子只改這裡） ──────────────────────────────
// 三例皆為「系統自己預測、知識圖譜裡沒有這組關係」。等級、預測適應症與分數一律照美國站藥物頁（EXAMPLES_AS_OF 當天實看）。
// 2026-11-12：clopidogrel 在美國站頁首已是 L5（頁內仍列 PFO 偏頭痛試驗），標「沒有臨床證據」會誤導，換成 bupropion（L1）。
// 換例子時：等級、預測適應症、分數（藥物頁 Quick Overview 的 TxGNN Prediction Score）都要跟線上頁一致，查不到的分數就拿掉。
const EXAMPLES_AS_OF = '2026-11-12';
// systemPrediction 兩種形態：
//   { score, level, url, site } → 顯示分數、證據等級與藥物頁連結
//   { none: true, note }        → 顯示「系統沒有這組預測」與說明
type Source = { label: string; url: string };
type SystemPrediction =
  | { none?: false; score: string; level: string; url: string; site: string }
  | { none: true; note: string };
type Example = {
  drug: string;
  original: string;
  newUse: string;
  summary: string;
  evidence: string;
  level: string;
  img?: { src: string; w: number; h: number; alt: string };
  systemPrediction: SystemPrediction;
  sources: Source[];
};
const examples: Example[] = [
  {
    drug: 'Dapsone',
    original: '痲瘋病、皰疹樣皮膚炎',
    newUse: '肺囊蟲肺炎',
    summary: '模型自己找回了臨床上真的在用的用途。',
    evidence:
      '不能用磺胺類藥物的愛滋感染者，醫師會改用 dapsone 預防肺囊蟲肺炎，美國做過第三期試驗拿它和 atovaquone 比。2024 年的統合分析把含 dapsone 的處方列為預防選項之一，第一線仍是 TMP-SMX。',
    level: 'L1',
    img: { src: '/assets/images/txgnn/ex-dapsone.webp', w: 960, h: 720, alt: '皮膚切面與肺臟之間有一顆藥丸與箭頭的插圖' },
    systemPrediction: { score: '99.73%', level: 'L1', url: 'https://ustxgnn.yao.care/drugs/dapsone/', site: '美國站' },
    sources: [
      { label: 'MedlinePlus：Dapsone', url: 'https://medlineplus.gov/druginfo/meds/a682128.html' },
      { label: 'Dermatol Clin 2001 回顧（PMID 11155588）', url: 'https://pubmed.ncbi.nlm.nih.gov/11155588/' },
      { label: 'ClinicalTrials.gov NCT00000802（第三期）', url: 'https://clinicaltrials.gov/study/NCT00000802' },
      { label: 'Clin Microbiol Infect 2024 統合分析（PMID 38583518）', url: 'https://pubmed.ncbi.nlm.nih.gov/38583518/' },
    ],
  },
  {
    drug: 'Bupropion',
    original: '憂鬱症、戒菸輔助',
    newUse: '注意力不足過動症（ADHD）',
    summary: '成人 ADHD 有隨機試驗和系統性回顧，結論是可能有效，但證據品質偏低。',
    evidence:
      '2017 年的 Cochrane 回顧收了 6 個成人隨機對照試驗、共 438 人，結論是可能有幫助：症狀嚴重度下降、明顯改善的人也比較多，但證據品質低。2018 年 Lancet Psychiatry 的網絡統合分析裡，成人由醫師評分時，bupropion 的效果優於安慰劑。GSK 做過一個 162 人的第三期安慰劑對照試驗，登記平台上沒有公布結果摘要。',
    level: 'L1',
    systemPrediction: { score: '99.99%', level: 'L1', url: 'https://ustxgnn.yao.care/drugs/bupropion/', site: '美國站' },
    sources: [
      { label: 'MedlinePlus：Bupropion', url: 'https://medlineplus.gov/druginfo/meds/a695033.html' },
      { label: 'Cochrane 2017 回顧（PMID 28965364）', url: 'https://pubmed.ncbi.nlm.nih.gov/28965364/' },
      { label: 'Lancet Psychiatry 2018 網絡統合分析（PMID 30097390）', url: 'https://pubmed.ncbi.nlm.nih.gov/30097390/' },
      { label: 'ClinicalTrials.gov NCT00048360（第三期）', url: 'https://clinicaltrials.gov/study/NCT00048360' },
    ],
  },
  {
    drug: 'Acetylcysteine（NAC）',
    original: '化痰、乙醯胺酚中毒解毒',
    newUse: '血栓性疾病',
    summary: '目前只有兩個試驗，一個數字看起來有差但沒附統計，一個還沒公布結果。',
    evidence:
      '蘇州大學附一院的第三期試驗讓造血幹細胞移植病人吃 NAC 或安慰劑，看能不能預防移植相關的血栓性微血管病變。登記平台上公布的數字是 NAC 組 66 人有 5 人發病，安慰劑組 77 人有 15 人，但沒有附統計檢定，主持單位也註明好幾項指標沒照原計畫執行。法國馬賽的 RENACTIF 第二期試驗找了 40 位洗腎病人，看 NAC 能不能降低血中的組織因子，2023 年完成，到現在還沒公布結果。',
    level: 'L2',
    img: { src: '/assets/images/txgnn/ex-nac.webp', w: 960, h: 720, alt: '氣管、肝臟與一段有血栓的血管之間有一顆藥丸與箭頭的插圖' },
    systemPrediction: { score: '99.96%', level: 'L2', url: 'https://ustxgnn.yao.care/drugs/acetylcysteine/', site: '美國站' },
    sources: [
      { label: 'DailyMed：Acetylcysteine 溶液仿單（化痰、解毒）', url: 'https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=5558a5f5-e821-473b-7d8a-5d33d09f0586' },
      { label: 'ClinicalTrials.gov NCT03252925（第三期，已公布結果）', url: 'https://clinicaltrials.gov/study/NCT03252925' },
      { label: 'ClinicalTrials.gov NCT03636932 RENACTIF（第二期，未公布結果）', url: 'https://clinicaltrials.gov/study/NCT03636932' },
    ],
  },
  // 已換下：clopidogrel（偏頭痛，美國站 2026-11-12 為 L5）、propofol（用戶決定不用）。
  // 美國站其他 L1 候選（2026-11-12 drugs.json）：busulfan、tacrolimus、bendamustine、clomipramine；換上前要逐條補權威來源。
];

// 證據等級定義：以台灣站 TwTxGNN docs/methodology.md 為準。bar＝階梯寬度（純視覺）
const LEVELS = [
  { k: 'L1', t: '多個第三期試驗或系統性回顧', bar: 100 },
  { k: 'L2', t: '一個隨機對照試驗，或多個第二期試驗', bar: 82 },
  { k: 'L3', t: '觀察性研究、大型病例系列', bar: 64 },
  { k: 'L4', t: '動物、細胞實驗或個案報告', bar: 46 },
  { k: 'L5', t: '只有模型預測', bar: 28 },
];
const levelText = Object.fromEntries(LEVELS.map((l) => [l.k, l.t]));

// 截圖：Playwright 實拍台灣站公開頁面（2026-10-16），無個資、無後台
const steps = [
  { t: '選國家', b: '台灣直接進台灣站，其他國家在下方地圖挑。', img: { src: '/assets/images/txgnn/step1-home.webp', w: 768, h: 720, alt: '台灣站首頁，有藥物查詢搜尋框與證據等級篩選' } },
  { t: '查一個藥', b: '輸入學名或英文名，例如 busulfan。', img: { src: '/assets/images/txgnn/step2-search.webp', w: 584, h: 493, alt: '在台灣站搜尋 busulfan 後出現的結果清單' } },
  { t: '看預測和證據', b: '藥物頁列出預測新適應症、模型分數和證據等級。', img: { src: '/assets/images/txgnn/step3-drug.webp', w: 784, h: 345, alt: 'Busulfan 藥物頁的快速總覽表：預測新適應症骨髓發育不良症候群，分數 99.62%，證據等級 L2' } },
];

// 系統怎麼運作：HTML/CSS 圖解，icon 為 inline SVG path（24×24 viewBox）
const pipeline = [
  { t: '準備資料', b: 'TxGNN 知識圖譜（129,375 個節點、約 800 萬條關係）加上各國的藥品註冊或給付清單。', icon: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3' },
  { t: '模型打分數', b: '每一組藥物與疾病得到 0 到 1 的分數。', icon: 'M4 20V10m6 10V4m6 16v-7m4 7H2' },
  { t: '剔除已知用途', b: '和知識圖譜裡已記錄的適應症、禁忌症比對，相同的拿掉。', icon: 'M3 5h18l-7 8v6l-4 2v-8z' },
  { t: '查證據', b: '分數 0.99 以上的前 10 名，到 PubMed 與 ClinicalTrials.gov 找研究，判定等級。', icon: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm9 16-4.3-4.3' },
  { t: '產出網站', b: '藥物報告頁、FHIR 資料與交互作用提醒，定期自動更新。', icon: 'M4 4h16v16H4zM4 9h16M9 9v11' },
];

// SMART App Gallery 上架清單：每天自動同步（.github/workflows/smart-gallery.yml），整理在 src/lib/smart-gallery.ts，這裡不寫死
const galleryApps = TXGNN_GALLERY_APPS;
const gallerySites = new Set(galleryApps.map((a) => a.site));
const galleryOrgUrl = GALLERY_ORG_URL;
// 各站 repo 名＝品牌名（TwTxGNN、UsTxGNN…），頁面舉兩個例子
const REPO_EXAMPLES = ['tw', 'us'].map(txgnnSiteBrand);
// 近期更新：日期取自各站 drug_reviews.json 的 checked 欄位與 repo 的 data-YYYYMMDD tag；查不到日期的寫 date: ''
const MILESTONES = [
  { date: countsDate, t: `${countries.length} 站都有公開查核紀錄`, b: `各站 repo 的 drug_reviews.json 合計${wan(totalReviews)}筆，藥物頁上用查核框和查核紀錄表呈現。` },
  { date: '2026-10-31', t: '查核紀錄擴到多數國家站', b: '這一天起，二十多個國家站陸續開始記錄藥物頁的更正與加註。' },
  { date: '2026-10-03', t: '台灣站開始記錄查核', b: '台灣站第一筆藥物頁查核紀錄，對照食藥署許可證資料。' },
  { date: '', t: '許可證資訊每週自動更新', b: '各站每週依最新的註冊或給付清單資料重算許可證張數與狀態。' },
];
const emptyReviewSites = countries.filter((c) => (c.review_records ?? 0) === 0).map((c) => siteName[c.iso2] ?? c.zh);
const W = worldmap.world;
const E = worldmap.europe;
const tipAttrs = (code: string) => {
  const i = info(code);
  return {
    'data-tip-name': i.name,
    'data-tip-reg': i.basis,
    'data-tip-pages': i.pages,
    'data-tip-date': i.date,
    'data-tip-langs': i.langs,
  };
};
---
<ProductLayout slug="txgnn" dateModified={PAGE_MODIFIED} faqOpen={false} wide furtherLimit={4} furtherCompact>
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-8 items-center">
        <div>
          <p class="text-lg md:text-xl font-medium text-[color:var(--color-ink)] leading-relaxed">
            已經上市的藥，可能還能治別的病。TxGNN 用 AI 找出這些可能，並附上研究證據。
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="https://twtxgnn.yao.care/" target="_blank" rel="noopener" class="btn-brand">
              查台灣的藥
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
            <a href="#countries" class="btn-outline-brand">選其他國家</a>
          </div>
          <dl class="mt-8 grid grid-cols-3 gap-3">
            <div class="stat"><dt class="sr-only">國家與地區</dt><dd><span class="stat-num" data-count={countries.length}>{countries.length}</span><span class="stat-unit">國家與地區</span></dd></div>
            <div class="stat"><dt class="sr-only">語言</dt><dd><span class="stat-num" data-count={langCount}>{langCount}</span><span class="stat-unit">種語言</span></dd></div>
            <div class="stat"><dt class="sr-only">藥物報告</dt><dd><span class="stat-num" data-count={totalDrugPages} data-live-total="drugs">{nf(totalDrugPages)}</span><span class="stat-unit">份藥物報告</span></dd></div>
          </dl>
          <p class="mt-3 text-xs text-[color:var(--color-ink-muted)]" data-live-note="drugs" aria-live="polite">資料日期 {drugPagesDate}：藥物報告為 {countries.length} 站公開藥物頁合計 <span class="tabular-nums">{nf(totalDrugPages)}</span> 份（各站 drugs.json，不含 noindex 與轉址頁）。</p>
          {/* 即時更新用：各站 drugs.json 網址與建置時的記錄值。前端抓到最新值後，總數與國家卡用動畫跳過去；抓不到的站沿用記錄值。 */}
          <script type="application/json" id="txgnn-live-sites" set:html={JSON.stringify({ date: drugPagesDate, fhirDate: countsDate, sites: countries.map((c) => ({ cc: c.iso2, base: txgnnSiteUrl(c.iso2), n: c.drug_pages ?? 0, fhir: c.fhir_resources ?? 0 })) })} />
        </div>
        <img src={IMG.hero.src} width={IMG.hero.w} height={IMG.hero.h} alt={IMG.hero.alt} fetchpriority="high" class="w-full h-auto rounded-2xl" />
      </div>
    </Fragment>
  </ProductHero>

  <!-- 例子 -->
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <header class="sec-head">
        <p class="kicker">Examples</p>
        <h2 class="section-title mt-2">三個模型自己找出來的例子</h2>
        <p class="sec-lead">知識圖譜裡原本沒有這些組合，證據有強有弱，照實標。證據等級、預測適應症與分數以 {EXAMPLES_AS_OF} 美國站藥物頁為準，之後可能因重審改變。</p>
      </header>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {examples.map((ex) => (
          <article class="flex flex-col rounded-2xl bg-white border border-neutral-200 shadow-sm overflow-hidden">
            {ex.img ? (
