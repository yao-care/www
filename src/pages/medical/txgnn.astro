<script>
  // 數字動畫＋即時校正：
  // 1. 先從 0 跑向建置時記錄的值（data-count），讓畫面馬上有東西動
  // 2. 同時抓 30 站的 drugs.json（各站都回 access-control-allow-origin: *），數 drugs 陣列長度
  // 3. 抓到就把動畫目標改成最新總數；某站失敗就用該站記錄值補，說明文字寫明幾站是即時
  // 沒開 JS 或爬蟲看到的是 HTML 裡的記錄值與資料日期。偏好減少動態時不跑動畫，直接換數字。
  const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  type Anim = { el: HTMLElement; from: number; to: number; start: number; dur: number; cur: number };
  const anims = new Map<HTMLElement, Anim>();
  const tick = (now: number) => {
    let running = false;
    for (const a of anims.values()) {
      const t = Math.min(1, (now - a.start) / a.dur);
      a.cur = a.from + (a.to - a.from) * ease(t);
      a.el.textContent = fmt(a.cur);
      if (t < 1) running = true;
    }
    if (running) requestAnimationFrame(tick);
  };
  const animateTo = (el: HTMLElement, to: number, dur: number, from?: number) => {
    if (reduce) {
      el.textContent = fmt(to);
      return;
    }
    const prev = anims.get(el);
    const start = performance.now();
    const wasIdle = ![...anims.values()].some((a) => performance.now() - a.start < a.dur);
    anims.set(el, { el, from: from ?? prev?.cur ?? to, to, start, dur, cur: from ?? prev?.cur ?? to });
    if (wasIdle) requestAnimationFrame(tick);
  };

  // 第一段：數字進到畫面時從 0 跑到目標（記錄值；若即時值先到，就直接跑到即時值）
  const revealed = new WeakSet<HTMLElement>();
  const reveal = (el: HTMLElement) => {
    if (revealed.has(el)) return;
    revealed.add(el);
    const n = Number(el.dataset.count);
    if (Number.isFinite(n)) animateTo(el, n, n > 1000 ? 1600 : 900, 0);
  };
  // 即時值到了：已出現的數字用動畫跳過去；還沒出現的只改目標，等出現時再跑
  const setTarget = (el: HTMLElement, n: number, dur: number, from?: number) => {
    el.dataset.count = String(n);
    if (revealed.has(el)) animateTo(el, n, dur, from);
    else el.textContent = fmt(n);
  };
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          reveal(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.6 });
    counters.forEach((el) => io.observe(el));
  } else {
    counters.forEach(reveal);
  }

  // 第二段：抓即時資料校正（兩個指標，各自獨立成功或失敗）
  //   drugs：各站 /data/drugs.json 的 drugs 陣列長度
  //   fhir ：各站 /fhir/metadata（CapabilityStatement）裡的 extension
  //          url = FHIR_COUNTS_URL，子 extension MedicationKnowledge／ClinicalUseDefinition（valueInteger）＋countedAt（valueDate）
  //          只認這個欄位、不解析 description 文字；countedAt 早於官網記錄日、或數字跟記錄值差超過一半，都視為不可信，沿用記錄值
  const FHIR_COUNTS_URL = 'https://yao.care/fhir/StructureDefinition/txgnn-resource-counts';
  type Site = { cc: string; base: string; n: number; fhir: number };
  const cfgEl = document.getElementById('txgnn-live-sites');
  const cfg = cfgEl ? (JSON.parse(cfgEl.textContent || '{}') as { date: string; fhirDate: string; sites: Site[] }) : null;

  const getJson = async (url: string) => {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 12000);
    try {
      const r = await fetch(url, { signal: ctl.signal });
      if (!r.ok) throw new Error(String(r.status));
      return await r.json();
    } finally {
      clearTimeout(timer);
    }
  };
  const drugsCount = async (s: Site) => {
    const d = await getJson(`${s.base}data/drugs.json`);
    const arr = Array.isArray(d) ? d : d?.drugs;
    if (!Array.isArray(arr)) throw new Error('bad shape');
    return arr.length;
  };
  const isInt = (v: unknown): v is number => Number.isInteger(v) && (v as number) >= 0;
  const fhirCount = async (s: Site) => {
    const d = await getJson(`${s.base}fhir/metadata`);
    const ext = (d?.extension ?? []).find((e: { url?: string }) => e?.url === FHIR_COUNTS_URL);
    if (!ext) throw new Error('no counts extension');
    const sub = (k: string) => (ext.extension ?? []).find((e: { url?: string }) => e?.url === k);
    const mk = sub('MedicationKnowledge')?.valueInteger;
    const cud = sub('ClinicalUseDefinition')?.valueInteger;
    const at = sub('countedAt')?.valueDate;
    if (!isInt(mk) || !isInt(cud) || typeof at !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(at)) throw new Error('bad counts');
    if (cfg && at < cfg.fhirDate) throw new Error(`stale ${at}`);
    const n = mk + cud;
    if (s.fhir > 0 && Math.abs(n - s.fhir) > s.fhir * 0.5) throw new Error(`out of range ${n} vs ${s.fhir}`);
    return n;
  };

  const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Taipei' });
  const run = (
    key: 'drugs' | 'fhir',
    getter: (s: Site) => Promise<number>,
    recorded: (s: Site) => number,
    recordedDate: string,
    note: (total: number, scope: string) => string,
    perSite?: (s: Site, n: number, live: boolean) => void,
  ) => {
    const totalEl = document.querySelector<HTMLElement>(`[data-live-total="${key}"]`);
    const noteEl = document.querySelector<HTMLElement>(`[data-live-note="${key}"]`);
    if (!cfg || !totalEl || !noteEl) return;
    Promise.allSettled(cfg.sites.map(getter)).then((results) => {
      let total = 0;
      let live = 0;
      results.forEach((r, i) => {
        const s = cfg.sites[i];
        const ok = r.status === 'fulfilled';
        const n = ok ? r.value : recorded(s);
        if (ok) live++;
        else console.debug(`[txgnn-live] ${key} ${s.cc} 沿用記錄值：`, r.reason?.message ?? r.reason);
        total += n;
        perSite?.(s, n, ok);
      });
      if (live === 0) return; // 全部失敗：保留記錄值與記錄日期
      setTarget(totalEl, total, 1200);
      const scope = live === cfg.sites.length ? `${live} 站全部即時` : `${live} 站即時、其餘 ${cfg.sites.length - live} 站沿用 ${recordedDate} 記錄`;
      noteEl.textContent = note(total, scope);
    });
  };

  if (cfg) {
    run(
      'drugs',
      drugsCount,
      (s) => s.n,
      cfg.date,
      (total, scope) => `即時資料（${today} 讀取，${scope}）：藥物報告為 ${cfg.sites.length} 站公開藥物頁合計 ${fmt(total)} 份（各站 drugs.json，不含 noindex 與轉址頁）。頁面原始記錄為 ${cfg.date}。`,
      (s, n, ok) => {
        document.querySelectorAll<HTMLElement>(`[data-live-cc="${s.cc}"]`).forEach((el) => {
          if (n !== s.n) animateTo(el, n, 900, s.n);
        });
        if (ok) {
          document.querySelectorAll<HTMLElement>(`.map-pin[href*="//${s.cc}txgnn."]`).forEach((pin) => {
            pin.dataset.tipPages = fmt(n);
            pin.dataset.tipDate = '即時';
          });
        }
      },
    );
    run(
      'fhir',
      fhirCount,
      (s) => s.fhir,
      cfg.fhirDate,
      (_total, scope) => `即時資料（${today} 讀取，${scope}）：各站 /fhir/metadata 回報的資源數。頁面原始記錄為 ${cfg.fhirDate}。`,
    );
  }
</script>

<script>
  // 地圖提示框：滑鼠移過或鍵盤 focus 到國家標點時顯示該站資料（資料在 data-tip-* 屬性裡，build 時已寫好）。
  const wrap = document.querySelector<HTMLElement>('.map-wrap');
  const tip = document.getElementById('map-tip');
  if (wrap && tip) {
    const show = (pin: Element) => {
      const d = (pin as HTMLElement).dataset;
      tip.replaceChildren();
      const title = document.createElement('strong');
      title.textContent = d.tipName ?? '';
      tip.append(title);
      const rows: [string, string | undefined][] = [
        ['資料依據', d.tipReg],
        ['藥物報告', d.tipPages ? `${d.tipPages}（${d.tipDate} 統計）` : undefined],
        ['語言', d.tipLangs],
      ];
      for (const [k, v] of rows) {
        if (!v) continue;
        const line = document.createElement('div');
        line.textContent = `${k}：${v}`;
        tip.append(line);
      }
      const hint = document.createElement('div');
      hint.textContent = '點一下在新分頁打開';
      hint.style.opacity = '0.75';
      tip.append(hint);
      tip.hidden = false;
      const r = (pin as SVGGraphicsElement).getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      let left = r.left - w.left + r.width / 2 + 12;
      const top = r.top - w.top + r.height / 2 + 12;
      const maxLeft = w.width - tip.offsetWidth - 8;
      if (left > maxLeft) left = Math.max(8, r.left - w.left - tip.offsetWidth - 12);
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };
    const hide = () => {
      tip.hidden = true;
    };
    wrap.querySelectorAll('.map-pin').forEach((pin) => {
      pin.addEventListener('mouseenter', () => show(pin));
      pin.addEventListener('focus', () => show(pin));
      pin.addEventListener('mouseleave', hide);
      pin.addEventListener('blur', hide);
    });
  }
</script>
