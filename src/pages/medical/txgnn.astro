---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import ProductNews from '../../components/news/ProductNews.astro';
import RelatedTopics from '../../components/products/RelatedTopics.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';
import { TXGNN_SITES, txgnnSiteUrl } from '../../seo.config';
import countries from '../../data/txgnn-countries.json';
import worldmap from '../../data/txgnn-worldmap.json';

const product = PRODUCT_BY_SLUG.txgnn;

// ─── 對外數字（TxGNN 團隊 2026-10-16 確認的口徑） ───────────────────────────
// 國家數、語言數、藥物頁數一律由 txgnn-countries.json 算出，不寫死。
// 頁面不提四級信心度（very_high／high／medium／low 是內部排序用），只講模型分數與證據等級。
// FHIR 資源數目前沒有資料檔可讀，先照團隊確認的數字寫。TODO：有資料檔後改成計算值。
const FHIR_RESOURCES = '32.6 萬';
const nf = (n: number) => n.toLocaleString('en-US');
const totalDrugPages = countries.reduce((a, c) => a + (c.drug_pages ?? 0), 0);
const drugPagesDate = countries[0]?.drug_pages_date ?? '';

const LANG_ZH: Record<string, string> = {
  en: '英文', zh: '中文', ja: '日文', ko: '韓文', ar: '阿拉伯文', de: '德文', ms: '馬來文',
  es: '西班牙文', pt: '葡萄牙文', fi: '芬蘭文', no: '挪威文', da: '丹麥文', fr: '法文',
  it: '義大利文', sv: '瑞典文', th: '泰文', nl: '荷蘭文',
};
const baseLang = (tag: string) => tag.split('-')[0].toLowerCase();
const langCount = new Set(countries.flatMap((c) => (c.langs ?? []).map(baseLang))).size;
const langLabel = (tags: string[] | null) =>
  [...new Set((tags ?? []).map(baseLang))].map((l) => (l === 'zh' ? '繁體中文' : LANG_ZH[l] ?? l)).join('、');

type Country = (typeof countries)[number];
const regName = (c: Country) => {
  const name = c.regulator.name_local ?? c.regulator.name_en;
  const abbr = c.regulator.abbrev;
  if (name && abbr && name !== abbr) return `${name}（${abbr}）`;
  return name ?? abbr ?? '';
};

const siteName = Object.fromEntries(TXGNN_SITES.map((s) => [s.code, s.name]));
const siteFlag = Object.fromEntries(TXGNN_SITES.map((s) => [s.code, s.flag]));
const byIso = Object.fromEntries(countries.map((c) => [c.iso2, c]));
const info = (code: string) => {
  const c = byIso[code];
  return {
    code,
    name: siteName[code] ?? c?.zh ?? code,
    flag: siteFlag[code] ?? '',
    url: txgnnSiteUrl(code),
    regulator: c ? regName(c) : '',
    pages: c?.drug_pages != null ? nf(c.drug_pages) : '',
    date: c?.drug_pages_date ?? '',
    langs: c ? langLabel(c.langs) : '',
  };
};

const REGIONS: { label: string; codes: string[] }[] = [
  { label: '亞洲', codes: ['tw', 'jp', 'kr', 'hk', 'sg', 'my', 'th', 'ph', 'in'] },
  { label: '歐洲', codes: ['eu', 'uk', 'de', 'fr', 'it', 'es', 'nl', 'ch', 'se', 'no', 'dk', 'fi'] },
  { label: '北美洲', codes: ['us', 'ca'] },
  { label: '中南美洲', codes: ['br', 'ar', 'co'] },
  { label: '大洋洲', codes: ['au', 'nz'] },
  { label: '中東與非洲', codes: ['sa', 'za'] },
];

// ─── 例子卡片（資料陣列驅動，換例子只改這裡） ──────────────────────────────
// 用戶尚未拍板最終三例（2026-10-16）。目前三例皆為「系統自己預測、知識圖譜裡沒有這組關係」，
// 分數與頁面連結由 TxGNN 團隊提供、網址已實測 200；臨床證據逐條附權威來源。
// systemPrediction 兩種形態：
//   { score, level, url, site } → 顯示分數、證據等級與藥物頁連結
//   { none: true, note }        → 顯示「系統沒有這組預測」與說明
type Source = { label: string; url: string };
type SystemPrediction =
  | { none?: false; score: string; level: string; url: string; site: string }
  | { none: true; note: string };
type Example = {
  drug: string;
  original: string;
  newUse: string;
  evidence: string;
  level: string;
  systemPrediction: SystemPrediction;
  sources: Source[];
};
const examples: Example[] = [
  {
    drug: 'Dapsone',
    original: '痲瘋病、皰疹樣皮膚炎',
    newUse: '肺囊蟲肺炎（PCP）',
    evidence:
      '這一例是模型自己找回了臨床上真的在用的用途。不能用磺胺類藥物的愛滋感染者，醫師會改用 dapsone 預防肺囊蟲肺炎，美國做過第三期試驗拿它和 atovaquone 比。2024 年的統合分析把含 dapsone 的處方列為預防選項之一，第一線仍是 TMP-SMX。',
    level: 'L1',
    systemPrediction: { score: '99.73%', level: 'L1', url: 'https://ustxgnn.yao.care/drugs/dapsone/', site: '美國站' },
    sources: [
      { label: 'MedlinePlus：Dapsone', url: 'https://medlineplus.gov/druginfo/meds/a682128.html' },
      { label: 'Dermatol Clin 2001 回顧（PMID 11155588）', url: 'https://pubmed.ncbi.nlm.nih.gov/11155588/' },
      { label: 'ClinicalTrials.gov NCT00000802（第三期）', url: 'https://clinicaltrials.gov/study/NCT00000802' },
      { label: 'Clin Microbiol Infect 2024 統合分析（PMID 38583518）', url: 'https://pubmed.ncbi.nlm.nih.gov/38583518/' },
    ],
  },
  {
    drug: 'Clopidogrel',
    original: '抗血小板藥，預防心肌梗塞、中風再發',
    newUse: '偏頭痛',
    evidence:
      '證據集中在一小群人：心臟有卵圓孔未閉，或做過心房中膈缺損關閉術的偏頭痛患者。2015 年 JAMA 的隨機試驗裡，關閉術後加用 clopidogrel 的人，三個月內偏頭痛發作比較少；2026 年 BMJ 的試驗中，它對合併卵圓孔未閉的偏頭痛效果不輸常用的預防藥 metoprolol。一般偏頭痛患者的小型隨機試驗則看不出差別。',
    level: 'L2',
    systemPrediction: { score: '99.44%', level: 'L2', url: 'https://ustxgnn.yao.care/drugs/clopidogrel/', site: '美國站' },
    sources: [
      { label: 'MedlinePlus：Clopidogrel', url: 'https://medlineplus.gov/druginfo/meds/a601040.html' },
      { label: 'JAMA 2015 CANOA 試驗（PMID 26551304）', url: 'https://pubmed.ncbi.nlm.nih.gov/26551304/' },
      { label: 'BMJ 2026 卵圓孔未閉偏頭痛試驗（PMID 42526943）', url: 'https://pubmed.ncbi.nlm.nih.gov/42526943/' },
      { label: 'Cephalalgia 2014 先導試驗（PMID 24836213）', url: 'https://pubmed.ncbi.nlm.nih.gov/24836213/' },
    ],
  },
  // 第三例：用戶尚未選定（2026-10-16）。選定後照上面格式補一筆，systemPrediction 與 sources 都要有實查過的網址。
  //   propofol（麻醉 → 偏頭痛 99.69% L2）用戶已決定不用。
  // 備選（團隊提供分數與網址，臨床證據尚未查證，換上前要逐條補權威來源）：
  //   ketamine（麻醉）→ 頭痛疾患 99.33% L2  https://intxgnn.yao.care/drugs/ketamine/
  //   cyclandelate → 偏頭痛 99.69% L2       https://twtxgnn.yao.care/drugs/cyclandelate/
  //   busulfan → 骨髓發育不良症候群 99.62% L2 https://twtxgnn.yao.care/drugs/busulfan/
];

// 證據等級定義：以台灣站 TwTxGNN docs/methodology.md 為準
const LEVELS = [
  { k: 'L1', t: '多個第三期隨機對照試驗，或系統性回顧', b: '找到兩個以上第三期試驗或系統性回顧' },
  { k: 'L2', t: '單一隨機對照試驗，或多個第二期試驗', b: '有一個隨機對照試驗，或兩個以上第二期試驗' },
  { k: 'L3', t: '觀察性研究、大型病例系列', b: '沒有隨機分組，只觀察用藥的人後來怎麼樣' },
  { k: 'L4', t: '前臨床研究、機轉研究、個案報告', b: '只有動物、細胞實驗或少數個案' },
  { k: 'L5', t: '只有模型預測', b: '還找不到任何臨床證據' },
];
const levelText = Object.fromEntries(LEVELS.map((l) => [l.k, l.t]));

const steps = [
  { t: '選國家', b: '要查台灣核准的藥，直接到台灣站。其他國家在下面的地圖或清單裡挑，每個國家有自己的站。' },
  { t: '查一個藥', b: '用藥名搜尋，學名或英文名都可以。每個藥有一頁，最上面寫著它在這個國家原本核准治什麼。' },
  { t: '看預測和證據', b: '頁面列出模型預測的新適應症、模型分數和證據等級，下面是找到的臨床試驗與文獻，還有交互作用和禁忌提醒。' },
];

const pipeline = [
  {
    t: '準備資料',
    b: 'TxGNN 用的知識圖譜叫 PrimeKG，可以想成一張很大的醫學關係網，有 129,375 個節點（藥物、疾病、基因等）、約 800 萬條關係。另一份是各國主管機關公開的藥證資料，決定這個國家有哪些藥。',
  },
  {
    t: '模型打分數',
    b: 'TxGNN 的深度學習模型替每一組「藥物、疾病」打一個 0 到 1 的分數，越接近 1，模型越覺得這個藥可能對這個病有用。',
  },
  {
    t: '對照已知用途',
    b: '把知識圖譜裡這個藥已經記錄的適應症、仿單外用途和禁忌症列出來，和模型的預測一筆一筆比對。疾病名稱相同的剔除，剩下的才叫「預測新適應症」。',
  },
  {
    t: '挑出來查證據',
    b: '每個藥取分數 0.99 以上的前 10 名，到 PubMed（美國國家醫學圖書館的文獻資料庫）和 ClinicalTrials.gov（全球臨床試驗登記平台）找相關研究，再判定 L1 到 L5 的證據等級。',
  },
  {
    t: '產出網站與資料',
    b: '產出每個藥的頁面、搜尋索引，以及 FHIR 格式的資料（FHIR 是醫療系統之間交換資料的國際標準；這裡用的是 MedicationKnowledge 和 ClinicalUseDefinition 兩種）。頁面同時整合藥物和藥物、食物、草藥的交互作用，以及藥物和疾病的禁忌資料。',
  },
  {
    t: '自動更新',
    b: '系統定期抓健康新聞、檢查有沒有新發表的文獻和試驗，有變動就自動重新部署網站。',
  },
];

const sameItems = ['AI 模型：同一個 TxGNN', '全球文獻：PubMed、ClinicalTrials.gov', '證據等級：同一套 L1 到 L5 判定方法'];
const diffItems = ['主管機關', '核准的藥和適應症', '網站語言'];

const smartAppUrl = 'https://apps.smarthealthit.org/app/twtxgnn-smart-app';
const W = worldmap.world;
const E = worldmap.europe;
const tipAttrs = (code: string) => {
  const i = info(code);
  return {
    'data-tip-name': i.name,
    'data-tip-reg': i.regulator,
    'data-tip-pages': i.pages,
    'data-tip-date': i.date,
    'data-tip-langs': i.langs,
  };
};
---
<ProductLayout slug="txgnn">
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <p class="mt-6 text-lg md:text-xl font-medium text-[color:var(--color-ink)] max-w-3xl leading-relaxed">
        已經上市的藥，可能還能治別的病。TxGNN 用 AI 找出這些可能，每一筆都附上目前找得到的研究證據。
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://twtxgnn.yao.care/" target="_blank" rel="noopener" class="btn-brand">
          查台灣的藥
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
        <a href="#countries" class="btn-outline-brand">選其他國家</a>
      </div>
      <dl class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-5 max-w-3xl">
        <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
          <dt class="sr-only">國家與地區</dt>
          <dd class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">{countries.length}<span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">個國家與地區</span></dd>
        </div>
        <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
          <dt class="sr-only">語言</dt>
          <dd class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">{langCount}<span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">種語言</span></dd>
        </div>
        <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
          <dt class="sr-only">藥物頁</dt>
          <dd class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">{nf(totalDrugPages)}<span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">個藥物頁</span></dd>
        </div>
      </dl>
      <p class="mt-3 text-xs text-[color:var(--color-ink-muted)]">藥物頁數為 {countries.length} 個站合計，{drugPagesDate} 統計。語言含英文。</p>
    </Fragment>
  </ProductHero>

  <!-- 2. 三個例子 -->
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="max-w-3xl mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Examples</p>
        <h2 class="section-title mt-2">模型自己找出來的例子</h2>
        <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink-soft)] leading-relaxed">
          下面幾個藥，知識圖譜裡原本都沒有記錄這組用途，是模型自己預測出來的。我們把目前查得到的臨床證據放在旁邊，證據有強有弱，照實寫。
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-5 max-w-5xl">
        {examples.map((ex) => (
          <article class="flex flex-col rounded-2xl bg-white border border-neutral-200 p-6 shadow-sm">
            <h3 class="text-xl font-bold text-[color:var(--color-ink)]">{ex.drug}</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="font-bold text-[color:var(--color-ink-soft)]">原本治什麼</dt>
                <dd class="mt-0.5 text-[color:var(--color-ink)]">{ex.original}</dd>
              </div>
              <div>
                <dt class="font-bold text-[color:var(--color-ink-soft)]">模型預測的新用途</dt>
                <dd class="mt-0.5 text-[color:var(--color-ink)] font-medium">{ex.newUse}</dd>
              </div>
              <div>
                <dt class="font-bold text-[color:var(--color-ink-soft)]">目前證據</dt>
                <dd class="mt-0.5 text-[color:var(--color-ink)] leading-relaxed">{ex.evidence}</dd>
              </div>
              <div>
                <dt class="font-bold text-[color:var(--color-ink-soft)]">證據等級</dt>
                <dd class="mt-1 flex items-start gap-2">
                  <span class="level-badge">{ex.level}</span>
                  <span class="text-[color:var(--color-ink-soft)]">{levelText[ex.level]}</span>
                </dd>
              </div>
              <div>
                <dt class="font-bold text-[color:var(--color-ink-soft)]">系統預測</dt>
                <dd class="mt-0.5 text-[color:var(--color-ink)]">
                  {ex.systemPrediction.none ? (
                    <span>系統沒有這組預測。{ex.systemPrediction.note}</span>
                  ) : (
                    <span>
                      模型分數 <strong class="tabular-nums">{ex.systemPrediction.score}</strong>，
                      <a href={ex.systemPrediction.url} target="_blank" rel="noopener" class="underline underline-offset-2 text-[color:var(--color-brand)]">看{ex.systemPrediction.site}的藥物頁</a>
                    </span>
                  )}
                </dd>
              </div>
            </dl>
            <details class="mt-4 text-sm">
              <summary class="cursor-pointer font-medium text-[color:var(--color-brand)]">來源（{ex.sources.length}）</summary>
              <ul class="mt-2 space-y-1.5 list-disc pl-5 text-[color:var(--color-ink-soft)]">
                {ex.sources.map((s) => (
                  <li><a href={s.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[color:var(--color-brand)]">{s.label}</a></li>
                ))}
              </ul>
            </details>
            <p class="mt-auto pt-5 text-xs font-medium text-[color:var(--color-critical)]">
              研究參考，不是醫療建議。預測不等於療效，仍需臨床驗證；用藥請與醫師討論。
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 證據等級與反例 -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
      <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Evidence Levels</p>
      <h2 class="section-title mt-2">為什麼要看證據等級</h2>
      <p class="mt-4 text-base md:text-lg leading-relaxed">
        模型分數只說明「模型覺得像」。這個藥對病人到底有沒有用，要看有沒有人做過研究、研究做得夠不夠嚴謹，所以每個預測旁邊都標了證據等級。
      </p>
      <ol class="mt-6 grid md:grid-cols-5 gap-3">
        {LEVELS.map((l) => (
          <li class="rounded-xl bg-white border border-neutral-200 p-4">
            <span class="level-badge">{l.k}</span>
            <p class="mt-2 text-sm font-bold text-[color:var(--color-ink)]">{l.t}</p>
            <p class="mt-1 text-xs text-[color:var(--color-ink-soft)] leading-relaxed">{l.b}</p>
          </li>
        ))}
      </ol>

      <div class="mt-10 rounded-2xl bg-white border-l-4 border-[color:var(--color-brand)] p-6 md:p-8 shadow-sm">
        <h3 class="text-lg md:text-xl font-bold">一個反例：羥氯奎與新冠肺炎</h3>
        <p class="mt-3 text-base leading-relaxed">
          羥氯奎（hydroxychloroquine）原本用來治瘧疾、紅斑性狼瘡和類風濕性關節炎。2020 年疫情初期，它被大量推薦拿來治新冠肺炎。
          當時被廣為引用的一篇法國研究，是沒有隨機分組的小型試驗，後來被期刊撤稿。
        </p>
        <p class="mt-3 text-base leading-relaxed">
          美國 FDA 在 2020 年 3 月 28 日發出緊急使用授權，6 月 15 日就撤銷，理由是不太可能有效，心臟方面的副作用風險也大過好處。
          之後兩個大型隨機試驗給了答案：英國 RECOVERY 試驗的住院病人，用了羥氯奎 28 天內死亡率沒有下降；
          WHO 的 SOLIDARITY 試驗在 30 個國家、405 家醫院進行，結論也是幾乎沒有效果。
        </p>
        <p class="mt-3 text-base leading-relaxed">
