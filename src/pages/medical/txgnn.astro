<script>
  // 地圖提示框：滑鼠移過或鍵盤 focus 到國家標點時顯示該站資料（資料在 data-tip-* 屬性裡，build 時已寫好）。
  const wrap = document.querySelector<HTMLElement>('.map-wrap');
  const tip = document.getElementById('map-tip');
  if (wrap && tip) {
    const show = (pin: Element) => {
      const d = (pin as HTMLElement).dataset;
      tip.replaceChildren();
      const title = document.createElement('strong');
      title.textContent = d.tipName ?? '';
      tip.append(title);
      const rows: [string, string | undefined][] = [
        ['主管機關', d.tipReg],
        ['藥物頁', d.tipPages ? `${d.tipPages}（${d.tipDate} 統計）` : undefined],
        ['語言', d.tipLangs],
      ];
      for (const [k, v] of rows) {
        if (!v) continue;
        const line = document.createElement('div');
        line.textContent = `${k}：${v}`;
        tip.append(line);
      }
      const hint = document.createElement('div');
      hint.textContent = '點一下在新分頁打開';
      hint.style.opacity = '0.75';
      tip.append(hint);
      tip.hidden = false;
      const r = (pin as SVGGraphicsElement).getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      let left = r.left - w.left + r.width / 2 + 12;
      const top = r.top - w.top + r.height / 2 + 12;
      const maxLeft = w.width - tip.offsetWidth - 8;
      if (left > maxLeft) left = Math.max(8, r.left - w.left - tip.offsetWidth - 12);
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };
    const hide = () => {
      tip.hidden = true;
    };
    wrap.querySelectorAll('.map-pin').forEach((pin) => {
      pin.addEventListener('mouseenter', () => show(pin));
      pin.addEventListener('focus', () => show(pin));
      pin.addEventListener('mouseleave', hide);
      pin.addEventListener('blur', hide);
    });
  }
</script>
