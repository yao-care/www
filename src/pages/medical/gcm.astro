---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import GcmClosedLoop from '../../components/products/GcmClosedLoop.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';

const product = PRODUCT_BY_SLUG.gcm;

const stats = [
  { value: 'FHIR', unit: 'R4', label: 'QuestionnaireResponse 收案' },
  { value: '3', unit: '工具', label: 'Func / Geri / Pedi 匯流' },
  { value: '0', unit: '帳密', label: '暱稱 + 收案碼' },
  { value: 'OAuth2', unit: 'PKCE', label: '符合 Inferno 測試' },
];

const fhir = [
  { k: '接收', t: 'QuestionnaireResponse', b: '三個自評工具在瀏覽器端產生標準 FHIR R4 問卷回應，送交收案。' },
  { k: '認證', t: 'OAuth 2.0 + PKCE', b: '以標準授權流程交付資料，符合 SMART on FHIR 規範。' },
  { k: '驗證', t: 'Inferno FHIR 測試', b: '對齊 FHIR R4 一致性測試，確保互通性。' },
];

const privacy = [
  '呼叫端送出後，服務先在內部去識別化，後續處理都在遮罩文本上進行',
  '原文與個資原值永不寫入稽核；稽核只存遮罩文雜湊（HMAC）＋ 狀態摘要',
  '全程留有可稽核軌跡（request_id / 規範版本 / 狀態 / 時間）',
  '每日加密備份、異地備援',
];

const caseMgmt = [
  '暱稱 + 系統產生的收案碼，免帳號密碼；同碼重複評估自動歸戶',
  '後台個案總覽：狀態追蹤（待聯繫 / 已聯繫 / 結案）、團隊指派、進度註記',
  '危險訊號（憂鬱 / 自傷等）自動升級，提醒人工即時處理',
];
---
<ProductLayout slug="gcm">
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
        {stats.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
            <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">
              {s.value}
              <span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">{s.unit}</span>
            </div>
            <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="mailto:service@yao.care" class="btn-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          談收案串接 / 合作
        </a>
      </div>
      <p class="mt-3 text-xs text-[color:var(--color-ink-muted)]">後端服務，無對外操作介面；與 GCM 預防醫學發展協會的公益使命接軌。</p>
    </Fragment>
  </ProductHero>

  <!-- intro -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <p class="text-base md:text-lg">
        Smart Func、Smart Geri、Smart Pedi 三個自評工具都在瀏覽器端完成評估、資料留在裝置。
        當民眾<strong class="text-[color:var(--color-brand)]">選擇送出</strong>時，
        GCM 收案伺服器就是接住這些結果、並把它變成可追蹤個案的後端 ——
        讓「自評」不只是一次性的測驗，而能銜接後續的關懷與追蹤。
      </p>
    </div>
  </section>

  <!-- 收案閉環（本頁不再放深入連結，避免連到自己） -->
  <GcmClosedLoop detailHref={null} />

  <!-- FHIR 互通 -->
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Interoperability</p>
        <h2 class="section-title mt-2">以 SMART on FHIR 標準互通</h2>
        <p class="section-subtitle">不是封閉資料孤島，而是能與醫療資訊系統對接的開放標準</p>
      </div>
      <div class="grid md:grid-cols-3 gap-4 md:gap-5">
        {fhir.map((f) => (
          <div class="rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
            <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-1">{f.k}</div>
            <h3 class="font-bold text-[color:var(--color-ink)]">{f.t}</h3>
            <p class="mt-2 text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{f.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 個案管理 + 隱私稽核 -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6 grid md:grid-cols-2 gap-6 md:gap-8">
      <div class="rounded-2xl bg-white border border-neutral-200 p-6 md:p-8 shadow-sm">
        <h3 class="text-lg md:text-xl font-bold text-[color:var(--color-ink)]">個案管理</h3>
        <ul class="mt-4 space-y-2.5">
          {caseMgmt.map((c) => (
            <li class="flex items-start gap-2.5 text-sm text-[color:var(--color-ink)]">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-[color:var(--color-brand)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-white border-l-4 border-[color:var(--color-brand)] p-6 md:p-8 shadow-sm">
        <h3 class="text-lg md:text-xl font-bold text-[color:var(--color-ink)]">隱私與稽核</h3>
        <ul class="mt-4 space-y-2.5">
          {privacy.map((p) => (
            <li class="flex items-start gap-2.5 text-sm text-[color:var(--color-ink)]">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-[color:var(--color-brand)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ProductCta
    product={product}
    headline="想把自評結果接進你的收案 / 個案管理流程？"
    description="GCM 收案伺服器為後端服務，可依需求討論 SMART on FHIR 串接與合作 — 來信 service@yao.care。"
  />
</ProductLayout>
