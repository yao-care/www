---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import CareTag from '../../components/CareTag.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import CapabilityCloud from '../../components/products/CapabilityCloud.astro';
import GcmClosedLoop from '../../components/products/GcmClosedLoop.astro';
import { CATEGORY_BY_SLUG, MEDICAL_GROUPS, productsByGroup } from '../../products.config';
import { SITE } from '../../site.config';

const category = CATEGORY_BY_SLUG.medical;
const clinical = productsByGroup('clinical');
const assessment = productsByGroup('assessment');
const casemgmt = productsByGroup('casemgmt');

const pageTitle = '智慧醫療 · yao.care';
const pageDescription =
  '藥提醒、AI 華佗、TxGNN，加上 Smart Func / Geri / Pedi 三套全齡自評工具，都對接 ATC 編碼與 SMART on FHIR 互通協定。';

// CollectionPage + ItemList：把本分類的產品目錄結構化，供 LLM/搜尋引擎理解
const hubProducts = [...clinical, ...assessment, ...casemgmt];
const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${new URL(category.href, SITE.url).toString()}#collection`,
  name: pageTitle,
  description: pageDescription,
  url: new URL(category.href, SITE.url).toString(),
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: hubProducts.length,
    itemListElement: hubProducts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${p.category}/${p.slug}/`, SITE.url).toString(),
      name: p.title,
    })),
  },
};

const medicalCapabilities = [
  { label: '醫療 AI 系統整合', en: 'Healthcare AI Integration' },
  { label: 'FHIR R4 / SMART on FHIR 應用開發', en: 'FHIR R4 / SMART on FHIR' },
  { label: '臨床決策支援系統', en: 'Clinical Decision Support' },
  { label: '醫療資料標準化與互通', en: 'Healthcare Interoperability' },
  { label: '證據導向 / 可解釋 AI', en: 'Verifiable / Explainable AI' },
];
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage="/assets/images/og/yaocare.png" extraSchema={[collectionSchema]}>
  <Nav />
  <main class="pt-20">
    <!-- breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">智慧醫療</span>
    </div>

    <!-- hero -->
    <section class="relative pt-10 pb-14 md:pt-14 md:pb-20 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-orange-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
        <CareTag caretag={category.caretag} size="lg" class="mb-4" />
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
          {category.kicker}
        </p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight max-w-4xl">
          {category.label}
        </h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          {category.tagline}
        </p>
        <p class="mt-3 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          {category.description}
        </p>
      </div>
    </section>

    <!-- group: 用藥與診療 -->
    {clinical.length > 0 && (
      <section class="py-12 md:py-16">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="mb-8">
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              {MEDICAL_GROUPS[0].kicker}
            </p>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold">{MEDICAL_GROUPS[0].label}</h2>
            <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
              {MEDICAL_GROUPS[0].description}
            </p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {clinical.map((p) => <ProductCard product={p} variant="hub" />)}
          </div>
        </div>
      </section>
    )}

    <!-- group: 全齡預防醫學評估 -->
    {assessment.length > 0 && (
      <section class="py-12 md:py-16 bg-neutral-50">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="mb-8">
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              {MEDICAL_GROUPS[1].kicker}
            </p>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold">{MEDICAL_GROUPS[1].label}</h2>
            <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
              {MEDICAL_GROUPS[1].description}
            </p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {assessment.map((p) => <ProductCard product={p} variant="hub" />)}
          </div>
        </div>
      </section>
    )}

    <!-- group: 慢性病個案管理 -->
    {casemgmt.length > 0 && (
      <section class="py-12 md:py-16">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="mb-8">
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
              {MEDICAL_GROUPS[2].kicker}
            </p>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold">{MEDICAL_GROUPS[2].label}</h2>
            <p class="mt-2 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
              {MEDICAL_GROUPS[2].description}
            </p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {casemgmt.map((p) => <ProductCard product={p} variant="hub" />)}
          </div>
        </div>
      </section>
    )}

    <!-- GCM SMART on FHIR 收案閉環 -->
    <GcmClosedLoop tinted={false} />

    <!-- capability cloud -->
    <CapabilityCloud
      kicker="Healthcare AI Capabilities"
      title="我們在智慧醫療能做的事"
      description="用藥提醒、EHR 整合、證據導向與可解釋推理，每一層都對齊國際醫療資訊標準。"
      capabilities={medicalCapabilities}
    />

    <!-- philosophy -->
    <section class="py-14 md:py-20 bg-neutral-50">
      <div class="max-w-3xl mx-auto px-4 lg:px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)]">
          以病人為中心，依循國際標準，與既有醫療系統互通
        </h2>
        <p class="mt-4 text-[color:var(--color-ink-soft)] leading-relaxed">
          ATC 藥品編碼、SMART on FHIR 互通協定、TWCM 中醫實作指南，這三套標準我們都照著做。
          我們不做封閉的 silo，做的是能跟健保資訊系統、Epic / Cerner 等 EHR 對接的開放平台。
        </p>
      </div>
    </section>

    <!-- 知識庫入口：名詞解釋 + 情境指南 -->
    <section class="py-10 border-t border-neutral-100">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <p class="text-sm md:text-base text-[color:var(--color-ink-soft)]">
          想先查名詞或找情境解法？<a href="/glossary/" class="text-[color:var(--color-brand)] font-medium hover:underline underline-offset-2">名詞解釋</a>與<a href="/guides/" class="text-[color:var(--color-brand)] font-medium hover:underline underline-offset-2">情境指南</a>都在這裡。
        </p>
      </div>
    </section>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
