---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import ProductNews from '../../components/news/ProductNews.astro';
import SmartHealthcare from '../../components/SmartHealthcare.astro';
import Advantages from '../../components/Advantages.astro';
import SixServices from '../../components/SixServices.astro';
import Verification from '../../components/Verification.astro';
import Screenshots from '../../components/Screenshots.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';
import { ORG_AWARDS, ORG_PATENT } from '../../seo.config';

const product = PRODUCT_BY_SLUG.yaocare;

const headlineStats = [
  { value: 'LINE', unit: '', label: '免裝 App、加好友即用' },
  { value: 'ATC', unit: '', label: '依國際標準藥品分類' },
  { value: '健保', unit: '', label: '與處方系統整合' },
  { value: '居家', unit: '', label: '回診評估資訊鏈' },
];
---
<ProductLayout slug="yaocare">
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
        {headlineStats.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
            <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)]">
              {s.value}
            </div>
            <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="https://lin.ee/1F7s4pP" target="_blank" rel="noopener" class="btn-line">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.92 2 10.74c0 4.32 3.55 7.94 8.35 8.62l1.06.15.13-.97-.07-.71c.08-.47-.31-.91-.78-.97l-.16-.02C5.83 16.27 3 13.81 3 10.74 3 6.48 7.03 3 12 3s9 3.48 9 7.74c0 4.26-4.03 7.74-9 7.74h-.5l-3.83 2.41a.5.5 0 0 1-.74-.55l.84-3.07A9.06 9.06 0 0 0 22 10.74C22 5.92 17.52 2 12 2z"/></svg>
          加入 LINE 體驗
        </a>
        <a href="/藥提醒Line民眾服務.ppsx" download class="btn-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          簡報下載
        </a>
      </div>
    </Fragment>
  </ProductHero>

  <!-- intro: 痛點 / 誰用 -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <p class="text-base md:text-lg">
        長者與慢性病患常同時服用多種藥物，
        <strong class="text-[color:var(--color-brand)]">漏服、重複服用、吃錯藥</strong>
        是居家用藥最常見的風險；傳統做法不是靠記性、就是靠家屬緊盯，
        而許多長輩連安裝、學一個新 App 都是門檻。
      </p>
      <p class="mt-4 text-base md:text-lg">
        藥提醒是<strong>以病人為中心</strong>的用藥提醒服務：依 ATC 國際藥品分類整合健保處方，
        透過<strong>長輩已經在用的 LINE / Telegram</strong> 推播服藥提醒、附上藥品外觀圖片，免裝 App。
        對<strong>需要規律服藥的民眾與長者</strong>降低使用門檻，
        也讓<strong>藥師</strong>能追蹤服藥成效、銜接居家到回診的評估資訊鏈。
      </p>
    </div>
  </section>

  <SmartHealthcare />
  <Advantages />
  <SixServices />
  <Verification />
  <Screenshots />

  <!-- 實績與肯定 -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Recognition &amp; Patent</p>
        <h2 class="section-title mt-2">實績與肯定</h2>
        <p class="section-subtitle">獲政府主管機關、專業競賽與國家品質標章肯定，並取得發明專利</p>
      </div>

      <div class="grid md:grid-cols-5 gap-6 md:gap-8 items-center mb-8">
        <figure class="md:col-span-2 rounded-2xl overflow-hidden border border-neutral-200 shadow-sm bg-white">
          <img
            src="/assets/images/credentials/snq-ceremony.jpg"
            alt="SNQ 國家品質標章授證典禮"
            class="w-full h-auto"
            loading="lazy"
          />
          <figcaption class="px-4 py-3 text-xs text-[color:var(--color-ink-soft)] border-t border-neutral-100">
            SNQ 國家品質標章授證典禮
          </figcaption>
        </figure>
        <div class="md:col-span-3 space-y-4">
          {ORG_AWARDS.map((a) => (
            <div class="rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm flex items-start gap-4">
              <span class="shrink-0 w-11 h-11 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
              </span>
              <p class="text-sm md:text-base text-[color:var(--color-ink)] leading-relaxed">{a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid md:grid-cols-5 gap-6 md:gap-8 items-center rounded-2xl bg-white border-l-4 border-[color:var(--color-brand)] border-t border-r border-b border-neutral-200 p-6 md:p-8 shadow-sm">
        <div class="md:col-span-3">
          <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">Invention Patent</div>
          <h3 class="font-bold text-base md:text-lg mb-1">
            發明專利「{ORG_PATENT.name}」
            <span class="ml-2 font-mono text-sm text-[color:var(--color-ink-soft)]">{ORG_PATENT.number}</span>
          </h3>
          <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{ORG_PATENT.note}。</p>
        </div>
        <figure class="md:col-span-2 rounded-xl overflow-hidden border border-neutral-200">
          <img
            src="/assets/images/credentials/patent-record.png"
            alt="發明專利 TW202202123A 全球專利檢索系統紀錄"
            class="w-full h-auto"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <ProductCta
    product={product}
    headline="醫院、診所、藥局想導入？"
    description="我們可以根據您的場景（醫院、診所、長照、藥局）提供對應的整合方式。最快 1 個工作天回覆。"
  />

  <ProductNews slot="news" target="yaocare" />
</ProductLayout>
