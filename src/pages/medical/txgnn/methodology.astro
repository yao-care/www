---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import FooterLinks from '../../../components/FooterLinks.astro';
import ContactMap from '../../../components/ContactMap.astro';
import { SITE } from '../../../site.config';
import { TXGNN_SITES, txgnnSiteUrl } from '../../../seo.config';
import countries from '../../../data/txgnn-countries.json';

// 對外口徑（TxGNN 團隊 2026-10-16 確認）：不提四級信心度、不把知識圖譜寫成預測方法、
// 不放各國流程燈號。數字一律由 txgnn-countries.json 計算。
// FHIR 資源數＝各站 MedicationKnowledge＋ClinicalUseDefinition 合計（txgnn-countries.json 的 fhir_resources）
const FHIR_RESOURCES = `約 ${(countries.reduce((a, c) => a + (c.fhir_resources ?? 0), 0) / 10000).toFixed(1)} 萬`;
const nf = (n: number | null) => (n == null ? '' : n.toLocaleString('en-US'));
const flagOf = Object.fromEntries(TXGNN_SITES.map((s) => [s.code, s.flag]));
const nameOf = Object.fromEntries(TXGNN_SITES.map((s) => [s.code, s.name]));
type Country = (typeof countries)[number];

const LANG_ZH: Record<string, string> = {
  en: '英文', zh: '繁體中文', ja: '日文', ko: '韓文', ar: '阿拉伯文', de: '德文', ms: '馬來文',
  es: '西班牙文', pt: '葡萄牙文', fi: '芬蘭文', no: '挪威文', da: '丹麥文', fr: '法文',
  it: '義大利文', sv: '瑞典文', th: '泰文', nl: '荷蘭文',
};
const baseLang = (t: string) => t.split('-')[0].toLowerCase();
const langLabel = (tags: string[] | null) =>
  [...new Set((tags ?? []).map(baseLang))].map((l) => LANG_ZH[l] ?? l).join('、');
const langCount = new Set(countries.flatMap((c) => (c.langs ?? []).map(baseLang))).size;
const totalDrugPages = countries.reduce((a, c) => a + (c.drug_pages ?? 0), 0);
const drugPagesDate = countries[0]?.drug_pages_date ?? '';

const regName = (c: Country) => {
  const name = c.regulator.name_local ?? c.regulator.name_en;
  const abbr = c.regulator.abbrev;
  if (name && abbr && name !== abbr) return `${name}（${abbr}）`;
  return name ?? abbr ?? '';
};

// dataset.last_updated 欄位裡混著「版本日期」和「來源更新頻率」兩種值，分開顯示；沒有就留空。
const FREQ: Record<string, string> = { Weekly: '每週', Semanal: '每週' };
const dataDate = (c: Country) => (c.dataset.last_updated && !FREQ[c.dataset.last_updated] ? c.dataset.last_updated : '');
const dataFreq = (c: Country) => (c.dataset.last_updated ? FREQ[c.dataset.last_updated] ?? '' : '');

// 2026-10-16 實測打不開（404／403／連線錯誤）的資料來源網址，先只寫名稱不連結
const DEAD_SOURCE = new Set(['au', 'ph', 'fr', 'se']);

// 已知限制：只寫資料本身看得出來的事（來源名稱、EMA 代理旗標），不推測
const limits = (c: Country) => {
  const out: string[] = [];
  if (c.dataset.ema_proxy) out.push('以歐洲藥品管理局（EMA）資料代替本國藥證清單');
  if (c.iso2 === 'ph') out.push('來源是國家基本藥物目錄，不是完整藥證清單');
  if (c.iso2 === 'nz') out.push('來源是 PHARMAC 給付品項清單，不是完整藥證清單');
  if (c.iso2 === 'jp') out.push('來源是健保藥價基準清單');
  if (c.iso2 === 'it') out.push('來源只含 A 類與 H 類給付藥品');
  if (!c.dataset.name) out.push('資料集名稱未記錄');
  return out.join('；');
};
const rows = [...countries].sort((a, b) => (b.drug_pages ?? 0) - (a.drug_pages ?? 0));

const LEVELS = [
  { k: 'L1', t: '多個第三期隨機對照試驗，或系統性回顧', b: '有兩個以上第三期試驗或系統性回顧' },
  { k: 'L2', t: '單一隨機對照試驗，或多個第二期試驗', b: '有一個隨機對照試驗，或兩個以上第二期試驗' },
  { k: 'L3', t: '觀察性研究、大型病例系列', b: '有觀察性研究或病例系列報告' },
  { k: 'L4', t: '前臨床研究、機轉研究、個案報告', b: '只有基礎研究或少量個案' },
  { k: 'L5', t: '只有模型預測，沒有臨床證據', b: '沒找到相關臨床證據' },
];

const SOURCES = [
  { t: 'TxGNN 模型', b: 'Huang K, … , Zitnik M. Nature Medicine 2024，MIT 授權。', url: 'https://doi.org/10.1038/s41591-024-03233-x', l: 'doi.org/10.1038/s41591-024-03233-x' },
  { t: 'TxGNN 原始碼', b: '哈佛醫學院 Zitnik Lab 公開的模型程式與權重。', url: 'https://github.com/mims-harvard/TxGNN', l: 'github.com/mims-harvard/TxGNN' },
  { t: 'PrimeKG 知識圖譜', b: 'TxGNN 使用的醫學知識圖譜，129,375 個節點、約 800 萬條關係。', url: 'https://zitniklab.hms.harvard.edu/projects/PrimeKG/', l: 'zitniklab.hms.harvard.edu/projects/PrimeKG' },
  { t: 'PubMed', b: '美國國家醫學圖書館的文獻資料庫，用來找支持或反駁預測的論文。', url: 'https://pubmed.ncbi.nlm.nih.gov/', l: 'pubmed.ncbi.nlm.nih.gov' },
  { t: 'ClinicalTrials.gov', b: '全球臨床試驗登記平台，用來找相關試驗與試驗階段。', url: 'https://clinicaltrials.gov/', l: 'clinicaltrials.gov' },
  { t: 'DDInter 2.0', b: '藥物與藥物、藥物與食物、藥物與疾病的交互作用資料，CC BY-NC-SA 4.0 授權。', url: 'https://ddinter2.scbdd.com/', l: 'ddinter2.scbdd.com' },
  { t: '各國藥品註冊或給付清單資料', b: '每個國家用自己的資料，有的是藥監機關的許可證，有的是給付清單，見上方對照表。', url: '', l: '' },
];

// 2026-11-15 用戶決定結束 SEO 實驗：description 改成現行口徑（不提雙引擎、四級信心度）；title 原本就沒有舊說法，維持。
const pageTitle = '30 國老藥新用 — 方法論與資料透明度 · yao.care';
const pageDescription =
  '30 個國家與地區的 TxGNN 老藥新用站，共用同一套模型與 L1 到 L5 證據等級。本頁說明預測方法，並逐國列出藥品資料來源（註冊或給付清單）與已知限制。';
const canonical = `${SITE.url}/medical/txgnn/methodology/`;

const articleSchema = {
  '@type': ['Article', 'TechArticle'],
  headline: '30 國老藥新用：方法與資料來源',
  description: pageDescription,
  inLanguage: 'zh-TW',
  url: canonical,
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  about: '老藥新用 Drug Repurposing',
  isAccessibleForFree: true,
};
const datasetSchema = {
  '@type': 'Dataset',
  name: 'TxGNN 30 國藥物報告頁統計與資料來源',
  description:
    '30 個國家與地區的 TxGNN 老藥新用站台，逐國列出主管機關、藥證資料來源、藥物報告頁數與網站語言。',
  url: canonical,
  inLanguage: 'zh-TW',
  isAccessibleForFree: true,
  creator: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  about: '老藥新用 Drug Repurposing',
  dateModified: drugPagesDate,
  variableMeasured: ['藥物報告頁數', '主管機關', '藥證資料來源', '網站語言'],
  spatialCoverage: countries.map((c) => ({ '@type': 'Place', name: c.zh })),
  distribution: countries.map((c) => ({
    '@type': 'DataDownload',
    name: `${c.zh} 老藥新用站台`,
    contentUrl: txgnnSiteUrl(c.iso2),
    encodingFormat: 'text/html',
  })),
  isBasedOn: countries
    .filter((c) => c.dataset?.url && !DEAD_SOURCE.has(c.iso2))
    .map((c) => ({
      '@type': 'Dataset',
      name: `${c.zh}（${c.regulator?.abbrev ?? ''}）${c.dataset.name}`,
      url: c.dataset.url,
      ...(c.dataset.license ? { license: c.dataset.license } : {}),
    })),
  citation: [
    {
      '@type': 'ScholarlyArticle',
      name: 'A foundation model for clinician-centered drug repurposing',
      isPartOf: 'Nature Medicine',
      datePublished: '2024',
      url: 'https://doi.org/10.1038/s41591-024-03233-x',
    },
  ],
};
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: '智慧醫療', item: `${SITE.url}/medical/` },
    { '@type': 'ListItem', position: 3, name: 'TxGNN 老藥新用', item: `${SITE.url}/medical/txgnn/` },
    { '@type': 'ListItem', position: 4, name: '方法與資料來源', item: canonical },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage="/assets/images/og/txgnn.png" ogType="article" extraSchema={[articleSchema, datasetSchema, breadcrumb]}>
  <Nav />
  <main class="pt-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a><span class="mx-1.5">›</span>
      <a href="/medical/" class="hover:text-[color:var(--color-brand)]">智慧醫療</a><span class="mx-1.5">›</span>
      <a href="/medical/txgnn/" class="hover:text-[color:var(--color-brand)]">TxGNN 老藥新用</a><span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">方法與資料來源</span>
    </div>

    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Methodology &amp; Data Sources</p>
        <h1 class="mt-3 text-3xl md:text-4xl font-bold leading-tight">{countries.length} 國老藥新用：方法與資料來源</h1>
        <p class="mt-5 text-base md:text-lg leading-relaxed">
          {countries.length} 個國家與地區的站，用的是同一個 TxGNN 模型、同一套證據等級。不同的是每一國的藥證資料：
          來源、詳細程度、更新方式都不一樣。這一頁把每一國用了什麼資料、有什麼限制列出來，方便你判斷結果能信到什麼程度。
        </p>
      </div>
    </section>

    <section class="pb-4">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
          {[
            { v: countries.length, u: '個國家與地區' },
            { v: langCount, u: '種語言（含英文）' },
            { v: nf(totalDrugPages), u: `份藥物報告頁（${drugPagesDate}）` },
            { v: FHIR_RESOURCES, u: `筆 FHIR 資源（${drugPagesDate}）` },
          ].map((s) => (
            <div class="rounded-xl bg-white border border-neutral-200 px-4 py-4 shadow-sm text-center">
              <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">{s.v}</div>
              <div class="text-xs text-[color:var(--color-ink-soft)] mt-1">{s.u}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 方法摘要 -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
        <h2 class="text-2xl md:text-3xl font-bold">預測新適應症是怎麼來的</h2>
        <div class="mt-5 space-y-4 text-base leading-relaxed">
          <p>
            TxGNN 的深度學習模型替每一組「藥物、疾病」打一個 0 到 1 的分數。接著拿 TxGNN 使用的知識圖譜 PrimeKG，
            列出這個藥已經記錄的適應症、仿單外用途和禁忌症，和模型預測逐筆比對。疾病名稱相同的剔除，剩下的才列為「預測新適應症」。
          </p>
          <p>
            知識圖譜這一步不是另一種預測方法，它的用處是對照已知用途，讓網站上標成「新」的，真的是知識圖譜裡沒有的組合。
          </p>
          <p>
            每個藥取分數 0.99 以上的前 10 名，到 PubMed 與 ClinicalTrials.gov 收集文獻和臨床試驗，再依下表判定證據等級。
          </p>
        </div>
      </div>
    </section>

    <!-- 證據等級 -->
    <section class="py-12 md:py-16 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
        <h2 class="text-2xl md:text-3xl font-bold">證據等級 L1 到 L5</h2>
        <p class="mt-2 text-base text-[color:var(--color-ink-soft)]">定義以台灣站 TwTxGNN 公開的方法說明為準，{countries.length} 國共用。</p>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-neutral-50 border-b border-neutral-200 text-[color:var(--color-ink-soft)]">
                <th class="text-left py-3 px-4 font-medium">等級</th>
                <th class="text-left py-3 px-4 font-medium">證據類型</th>
                <th class="text-left py-3 px-4 font-medium">判定條件</th>
              </tr>
            </thead>
            <tbody>
              {LEVELS.map((l, i) => (
                <tr class:list={[i > 0 && 'border-t border-neutral-100']}>
                  <td class="py-3 px-4 font-bold text-[color:var(--color-brand-deep)]">{l.k}</td>
                  <td class="py-3 px-4">{l.t}</td>
                  <td class="py-3 px-4 text-[color:var(--color-ink-soft)]">{l.b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 已知限制（全站共通） -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
        <h2 class="text-2xl md:text-3xl font-bold">已知限制</h2>
        <ul class="mt-5 space-y-4 text-base leading-relaxed list-disc pl-6">
          <li>
            比對已知用途時，看的是疾病名稱是否<strong>完全相同</strong>。已知疾病的子型仍可能被列為新適應症，全站大約 6% 的預測屬於這種情況，
            例如降血壓藥 lisinopril 被列出各型心肌梗塞。
          </li>
          <li>各國許可證上的適應症文字，目前<strong>沒有逐條</strong>拿來和預測比對。某個預測在當地可能其實已經核准。</li>
          <li>部分國家沒有可下載的本國藥證清單，改用歐洲藥品管理局（EMA）資料代替，表中有標註。</li>
          <li>各國藥證資料的「筆數」定義不同，有的是許可證數，有的是產品代碼數，不能直接跨國比較。</li>
          <li>多數國家的資料集沒有記錄授權條款和最後更新日，下表查不到的欄位一律留空，不補值。</li>
        </ul>
      </div>
    </section>

    <!-- 30 國對照表 -->
    <section class="py-12 md:py-16 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <h2 class="text-2xl md:text-3xl font-bold">{countries.length} 國對照表</h2>
        <p class="mt-2 text-base text-[color:var(--color-ink-soft)]">依藥物報告頁數排序。數字為 {drugPagesDate} 統計、各站可收錄的藥物報告頁；空白代表資料裡沒有記錄。</p>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <table class="w-full text-sm min-w-[72rem]">
            <thead>
              <tr class="bg-neutral-50 border-b border-neutral-200 text-[color:var(--color-ink-soft)]">
                <th class="text-left py-3 px-4 font-medium">國家與地區</th>
                <th class="text-left py-3 px-4 font-medium">主管機關</th>
                <th class="text-left py-3 px-4 font-medium">資料來源</th>
                <th class="text-left py-3 px-4 font-medium">資料日期</th>
                <th class="text-left py-3 px-4 font-medium">來源更新頻率</th>
                <th class="text-right py-3 px-4 font-medium">藥物報告頁</th>
                <th class="text-left py-3 px-4 font-medium">語言</th>
                <th class="text-left py-3 px-4 font-medium">已知限制</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((c, i) => (
                <tr class:list={[i > 0 && 'border-t border-neutral-100', 'align-top']}>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <a href={txgnnSiteUrl(c.iso2)} target="_blank" rel="noopener" class="font-medium text-[color:var(--color-ink)] hover:text-[color:var(--color-brand)] underline-offset-2 hover:underline">
                      <span class="mr-1.5" aria-hidden="true">{flagOf[c.iso2] ?? ''}</span>{nameOf[c.iso2] ?? c.zh}
                    </a>
                  </td>
                  <td class="py-3 px-4">{regName(c)}</td>
                  <td class="py-3 px-4 text-[color:var(--color-ink-soft)]">
                    {c.dataset.url && !DEAD_SOURCE.has(c.iso2) ? (
                      <a href={c.dataset.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[color:var(--color-brand)]">{c.dataset.name ?? c.dataset.url}</a>
                    ) : (
                      <span>{c.dataset.name ?? ''}</span>
                    )}
                    {c.dataset.license && <span class="block text-xs">授權：{c.dataset.license}</span>}
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap">{dataDate(c)}</td>
                  <td class="py-3 px-4 whitespace-nowrap">{dataFreq(c)}</td>
                  <td class="py-3 px-4 text-right tabular-nums font-bold">{nf(c.drug_pages)}</td>
                  <td class="py-3 px-4">{langLabel(c.langs)}</td>
                  <td class="py-3 px-4 text-[color:var(--color-ink-soft)]">{limits(c)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 資料來源清單 -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
        <h2 class="text-2xl md:text-3xl font-bold">資料來源</h2>
        <ul class="mt-5 space-y-4">
          {SOURCES.map((s) => (
            <li class="rounded-xl bg-white border border-neutral-200 p-4">
              <p class="font-bold">{s.t}</p>
              <p class="mt-1 text-sm text-[color:var(--color-ink-soft)]">{s.b}</p>
              {s.url && <a href={s.url} target="_blank" rel="noopener" class="mt-1 inline-block break-all text-sm text-[color:var(--color-brand)] underline underline-offset-2">{s.l}</a>}
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-[color:var(--color-ink-soft)]">
          藥提醒科技（yao.care）不是 TxGNN 模型的原作者，負責的是把模型接上各國藥證資料、建站、FHIR 與 SMART on FHIR 整合，以及收集證據。
        </p>
      </div>
    </section>

    <!--
      TODO(系統狀態快照)：原規劃在這裡放「系統狀態快照（附日期）」。
      目前沒有自動產生的狀態檔，先不放；不要手寫全綠狀態。有狀態檔後再從檔案讀出並附產生日期。
    -->

    <section class="py-12 md:py-16 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 *:max-w-4xl">
