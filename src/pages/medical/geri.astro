---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import ProductNews from '../../components/news/ProductNews.astro';
import RelatedTopics from '../../components/products/RelatedTopics.astro';
import GcmClosedLoop from '../../components/products/GcmClosedLoop.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';

const product = PRODUCT_BY_SLUG.geri;

const stats = [
  { value: '1–9', unit: 'CFS', label: '臨床衰弱量表分層' },
  { value: '2', unit: '模式', label: '公眾自篩 / 專業臨床' },
  { value: '紅黃綠', unit: '', label: '三級判讀 + 轉介' },
  { value: 'FHIR', unit: 'R4', label: '可選上傳收案' },
];

const modes = [
  {
    name: '公眾 / 家屬自篩',
    body: '以白話題目快速了解長者狀況，紅黃綠結果不糾結分數；偵測憂鬱／自傷訊號時顯示求助專線。',
    points: ['白話題目、低門檻', '短篩為主，異常才深入', '結果配對衛教與求助資源'],
  },
  {
    name: '專業臨床',
    body: '以 CFS 1–9 分層，深入多面向評估，作為長照與醫療端的結構化評估工具。',
    points: ['CFS 衰弱分層基準', '多面向深度評估', '五次坐站等功能測驗（相機計時）'],
  },
];

const domains = ['認知', '情緒', '營養', '行動步態', '用藥', '社會支持', '感官', '跌倒風險'];
---
<ProductLayout slug="geri">
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
        {stats.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
            <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">
              {s.value}
              <span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">{s.unit}</span>
            </div>
            <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={product.externalUrl} target="_blank" rel="noopener" class="btn-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          免費開始評估
        </a>
        <a href={product.repoUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 rounded-md font-medium border-2 border-neutral-300 text-[color:var(--color-ink)] hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.94c-3.2.7-3.87-1.54-3.87-1.54-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub 開源
        </a>
      </div>
    </Fragment>
  </ProductHero>

  <!-- intro -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <p class="text-base md:text-lg">
        台灣 2025 邁入超高齡社會，衰弱與功能退化常被當成「正常老化」而錯過介入時機。
        Smart Geri 以
        <strong class="text-[color:var(--color-brand)]"><a href="/glossary/cfs/" class="hover:underline underline-offset-2">臨床衰弱量表（CFS 1–9）</a></strong>
        為基準，延伸成多面向的<a href="/glossary/cga/" class="text-[color:var(--color-brand)] font-medium hover:underline underline-offset-2">高齡周全性評估（CGA）</a>，把該不該介入這件事變得有依據。
      </p>
      <p class="mt-4 text-base md:text-lg">
        它同時服務兩種人：家屬可用自篩模式快速了解長者狀況；長照與醫療端可用專業模式做結構化評估。
        離線可用、資料留在裝置，可選擇以 SMART on FHIR 上傳醫院或 GCM 收案。
      </p>
    </div>
  </section>

  <!-- dual mode -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Dual Mode</p>
        <h2 class="section-title mt-2">公眾自篩 × 專業臨床 雙模式</h2>
        <p class="section-subtitle">同一套評估，依使用者切換深度與呈現方式</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        {modes.map((m) => (
          <div class="rounded-2xl bg-white border border-neutral-200 p-6 md:p-8 shadow-sm">
            <h3 class="text-lg md:text-xl font-bold text-[color:var(--color-ink)]">{m.name}</h3>
            <p class="mt-3 text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{m.body}</p>
            <ul class="mt-5 space-y-2">
              {m.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-[color:var(--color-ink)]">
                  <svg class="w-4 h-4 mt-0.5 shrink-0 text-[color:var(--color-brand)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- multi-domain -->
  <section class="py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Comprehensive Geriatric Assessment</p>
        <h2 class="section-title mt-2">多面向評估，紅黃綠轉介</h2>
        <p class="section-subtitle">從衰弱基準延伸的各個高齡風險面向</p>
      </div>
      <ul class="flex flex-wrap justify-center gap-2 md:gap-3">
        {domains.map((d) => (
          <li class="inline-flex items-center px-4 md:px-5 py-2.5 rounded-full bg-white border border-neutral-200 hover:border-[color:var(--color-brand)] transition-colors text-sm font-medium text-[color:var(--color-ink)]">
            {d}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <GcmClosedLoop />

  <RelatedTopics product="geri" />

  <ProductCta
    product={product}
    headline="及早看見衰弱訊號，及早陪伴介入"
    description="免費、免註冊。給家屬一個快速了解的入口，給專業端一套結構化的評估工具。"
  />

  <ProductNews slot="news" target="geri" />
</ProductLayout>
