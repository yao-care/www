---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import ProductNews from '../../components/news/ProductNews.astro';
import GcmClosedLoop from '../../components/products/GcmClosedLoop.astro';
import RelatedTopics from '../../components/products/RelatedTopics.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';

const product = PRODUCT_BY_SLUG.pedi;

const stats = [
  { value: '2月–6歲', unit: '', label: '7 個年齡帶' },
  { value: '6', unit: '大', label: '發展領域' },
  { value: 'ASQ-3', unit: '', label: '常模對標' },
  { value: '3–5', unit: '分鐘', label: '完成篩檢' },
];

const domains = [
  { name: '粗動作', en: 'Gross Motor' },
  { name: '精細動作', en: 'Fine Motor' },
  { name: '語言理解', en: 'Receptive Language' },
  { name: '語言表達', en: 'Expressive Language' },
  { name: '認知', en: 'Cognition' },
  { name: '社會情緒', en: 'Social-Emotional' },
];

const tests = [
  { name: '圖卡辨識', body: '以圖卡互動評估認知與語言理解。' },
  { name: '繪圖描摹', body: '描摹／自由畫評估精細動作與視覺動作整合。' },
  { name: '語音錄製', body: '錄下發音與語句評估語言表達。' },
  { name: '動作影片', body: '錄製動作影片評估粗動作里程碑。' },
];

const triage = [
  { tone: 'emerald', label: '綠 · 發展符合', body: '發展符合同齡，持續觀察與親子互動即可。' },
  { tone: 'amber', label: '黃 · 持續追蹤', body: '部分領域偏弱，提供居家促進活動並建議追蹤。' },
  { tone: 'red', label: '紅 · 建議轉介', body: '達 −2SD 紅旗，指引尋求兒童發展專業評估。' },
];
const toneClass: Record<string, string> = {
  emerald: 'border-emerald-500/30 text-emerald-600 bg-emerald-500',
  amber: 'border-amber-500/30 text-amber-600 bg-amber-500',
  red: 'border-red-500/30 text-red-600 bg-red-500',
};
---
<ProductLayout slug="pedi">
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
        {stats.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
            <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">
              {s.value}
              <span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">{s.unit}</span>
            </div>
            <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={product.externalUrl} target="_blank" rel="noopener" class="btn-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          免費開始篩檢
        </a>
        <a href={product.repoUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 rounded-md font-medium border-2 border-neutral-300 text-[color:var(--color-ink)] hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.94c-3.2.7-3.87-1.54-3.87-1.54-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub 開源
        </a>
      </div>
    </Fragment>
  </ProductHero>

  <!-- intro -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <p class="text-base md:text-lg">
        發展遲緩的黃金療育期很短，家長卻常太晚察覺。Smart Pedi 依孩子的年齡帶給出對應問卷，
        對齊
        <strong class="text-[color:var(--color-brand)]">國健署兒童健康手冊與 <a href="/glossary/asq3/" class="hover:underline underline-offset-2">ASQ-3</a></strong>，
        用 3–5 分鐘協助家長判斷孩子是「慢飛」還是需要轉介。
      </p>
      <p class="mt-4 text-base md:text-lg">
        以常模化分數判讀、雷達圖對比同齡基準，達 −2SD 即紅旗提示。資料留在瀏覽器，
        可選擇上傳醫療院所或 GCM 收案，銜接早療資源。
      </p>
    </div>
  </section>

  <!-- 6 domains -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Developmental Domains</p>
        <h2 class="section-title mt-2">六大發展領域</h2>
        <p class="section-subtitle">對齊國健署兒童健康手冊與 ASQ-3 常模</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-5">
        {domains.map((d) => (
          <div class="rounded-2xl bg-white border border-neutral-200 p-5 text-center shadow-sm">
            <div class="text-base font-bold text-[color:var(--color-ink)]">{d.name}</div>
            <div class="text-[10px] font-medium tracking-wide uppercase text-[color:var(--color-brand)] mt-1">{d.en}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- interactive tests -->
  <section class="py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Interactive Tasks</p>
        <h2 class="section-title mt-2">不只問卷，還有互動測驗</h2>
        <p class="section-subtitle">必要時加入互動任務，讓判讀更貼近真實表現</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {tests.map((t) => (
          <div class="rounded-xl bg-white border border-neutral-200 p-6 shadow-sm">
            <div class="font-bold text-[color:var(--color-ink)]">{t.name}</div>
            <p class="mt-2 text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- traffic light -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Triage</p>
        <h2 class="section-title mt-2">常模化判讀 + 紅黃綠分級</h2>
        <p class="section-subtitle">以同齡常模為基準，給出明確的下一步</p>
      </div>
      <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        {triage.map((t) => (
          <div class:list={['rounded-xl border-2 bg-white p-6', toneClass[t.tone].split(' ')[0]]}>
            <div class="flex items-center gap-2 mb-2">
              <span class:list={['w-3 h-3 rounded-full', toneClass[t.tone].split(' ')[2]]}></span>
              <span class:list={['text-sm font-bold', toneClass[t.tone].split(' ')[1]]}>{t.label}</span>
            </div>
            <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <GcmClosedLoop tinted={false} />

  <RelatedTopics product="pedi" />

  <ProductCta
    product={product}
    headline="幾分鐘，掌握孩子的發展里程碑"
    description="免費、免註冊、資料留在你的裝置。及早發現、及早把握黃金療育期。"
  />

  <ProductNews slot="news" target="pedi" />
</ProductLayout>
