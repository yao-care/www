  </section>

  <!-- 8 phases accordion -->
  <section class="py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Pipeline</p>
        <h2 class="section-title mt-2">完整 8 階段流程</h2>
        <p class="section-subtitle">從原始 FDA 資料到 EHR 系統整合，全流程自動化</p>
      </div>

      <div class="space-y-3">
        {phases.map((p) => (
          <details class="group rounded-xl bg-white border border-neutral-200 shadow-sm overflow-hidden">
            <summary class="cursor-pointer p-5 md:p-6 flex items-start gap-4 list-none">
              <span class="shrink-0 w-9 h-9 rounded-lg bg-[color:var(--color-brand)] text-white flex items-center justify-center font-bold tabular-nums">
                {p.n}
              </span>
              <div class="flex-1">
                <h3 class="font-bold text-[color:var(--color-ink)]">{p.title}</h3>
                <p class="mt-1 text-sm text-[color:var(--color-ink-soft)]">{p.summary}</p>
              </div>
              <svg class="shrink-0 w-5 h-5 mt-2 text-[color:var(--color-ink-soft)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-5 md:px-6 pb-5 md:pb-6 pt-0 border-t border-neutral-100">
