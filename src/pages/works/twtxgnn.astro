  <WorkCta
    work={work}
    headline="想討論技術合作？"
    description="老藥新用、TxGNN 模型在地化、EHR / FHIR 整合 — 任何技術討論都歡迎透過 LINE 私訊。"
  />
</WorkLayout>

<script>
  import * as d3 from 'd3';

  function renderHeatmap() {
    const container = document.getElementById('radial-heatmap');
    if (!container) return;
    const dataAttr = container.getAttribute('data-heatmap');
    if (!dataAttr) return;
    const data = JSON.parse(dataAttr) as Record<string, Record<string, string>>;
    const phases = ['P0', 'P1', 'P2', 'P3', 'P4', 'P5', 'P6', 'P7', 'P8'];
    const countries = Object.keys(data).sort();

    const colorMap: Record<string, string> = {
      OK: '#10b981',
      WARN: '#f59e0b',
      ERR: '#ef4444',
      NONE: '#d4d4d4',
    };

    // Sizing for both desktop & mobile
    const width = Math.min(700, container.clientWidth || 700);
    const height = width;
    const innerRadius = width * 0.13;
    const outerRadius = width * 0.45;
    const labelRadius = outerRadius + width * 0.025;

    // clear
    container.innerHTML = '';
    const tooltip = d3.select(container)
      .append('div')
      .style('position', 'absolute')
      .style('pointer-events', 'none')
      .style('background', 'rgba(34, 32, 48, 0.95)')
      .style('color', '#fff')
      .style('border-radius', '8px')
      .style('padding', '6px 10px')
      .style('font-size', '12px')
      .style('opacity', '0')
      .style('transition', 'opacity 0.15s')
      .style('white-space', 'nowrap')
      .style('z-index', '10');

    const svg = d3.select(container)
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', `0 0 ${width} ${height}`)
      .style('max-width', '100%')
      .style('height', 'auto');

    const g = svg.append('g').attr('transform', `translate(${width / 2}, ${height / 2})`);

    const angleScale = d3.scaleBand<string>()
      .domain(countries)
      .range([0, 2 * Math.PI])
      .padding(0.04);

    const radiusScale = d3.scaleBand<string>()
      .domain(phases)
      .range([innerRadius, outerRadius])
      .padding(0.08);

    type Cell = { country: string; phase: string; status: string };
    const flatData: Cell[] = [];
    countries.forEach((c) => {
      phases.forEach((p) => {
        flatData.push({ country: c, phase: p, status: data[c][p] || 'NONE' });
      });
    });

    const arc = d3.arc<Cell>()
      .innerRadius((d) => radiusScale(d.phase) ?? innerRadius)
      .outerRadius((d) => (radiusScale(d.phase) ?? innerRadius) + radiusScale.bandwidth())
      .startAngle((d) => angleScale(d.country) ?? 0)
      .endAngle((d) => (angleScale(d.country) ?? 0) + angleScale.bandwidth())
      .padAngle(0.008)
      .padRadius(innerRadius);

    g.selectAll<SVGPathElement, Cell>('path.cell')
      .data(flatData)
      .join('path')
      .attr('class', 'cell')
      .attr('fill', (d) => colorMap[d.status] || colorMap.NONE)
      .attr('opacity', 0.92)
      .attr('d', arc)
      .style('cursor', 'pointer')
      .on('mouseover', function (event, d) {
        d3.select(this).attr('stroke', '#222').attr('stroke-width', 1.5).attr('opacity', 1);
        const cc = d.country.replace('TxGNN', '');
        const statusText: Record<string, string> = { OK: '✓ OK', WARN: '⚠ Warning', ERR: '✗ Error', NONE: '— N/A' };
        tooltip.html(`<strong>${cc}</strong> · ${d.phase}<br>${statusText[d.status] || d.status}`)
          .style('opacity', '1');
      })
      .on('mousemove', function (event) {
        const rect = container.getBoundingClientRect();
        tooltip.style('left', (event.clientX - rect.left + 12) + 'px')
          .style('top', (event.clientY - rect.top - 10) + 'px');
      })
      .on('mouseout', function () {
        d3.select(this).attr('stroke', null).attr('opacity', 0.92);
        tooltip.style('opacity', '0');
      });

    // country labels
    g.selectAll('text.country')
      .data(countries)
      .join('text')
      .attr('class', 'country')
      .attr('text-anchor', 'middle')
      .attr('dominant-baseline', 'middle')
      .attr('font-size', '10px')
      .attr('fill', '#666')
      .attr('transform', (d) => {
        const angle = (angleScale(d) ?? 0) + angleScale.bandwidth() / 2;
        const x = Math.sin(angle) * labelRadius;
        const y = -Math.cos(angle) * labelRadius;
        const rot = (angle * 180) / Math.PI;
        const flip = rot > 90 && rot < 270 ? rot + 180 : rot;
        return `translate(${x},${y}) rotate(${flip})`;
      })
      .text((d) => d.replace('TxGNN', ''));

    // phase labels (centered)
    g.selectAll('text.phase')
      .data(phases)
      .join('text')
      .attr('class', 'phase')
      .attr('text-anchor', 'middle')
      .attr('dominant-baseline', 'middle')
      .attr('font-size', '9px')
      .attr('fill', 'rgba(0,0,0,0.35)')
      .attr('transform', (d) => {
        const r = (radiusScale(d) ?? innerRadius) + radiusScale.bandwidth() / 2;
        return `translate(0,${-r})`;
      })
      .text((d) => d);
  }

  renderHeatmap();
  // re-render on resize for responsive
  let rt: number | undefined;
  window.addEventListener('resize', () => {
    if (rt) window.clearTimeout(rt);
    rt = window.setTimeout(renderHeatmap, 200);
  });
</script>
