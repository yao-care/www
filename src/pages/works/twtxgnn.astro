  <!-- 30-country radial heatmap -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Coverage Map</p>
        <h2 class="section-title mt-2">30 國 × 9 Phase 即時健康狀態</h2>
        <p class="section-subtitle">由 check_all.sh 自動更新，每環為一個 Phase，每色塊為一國</p>
      </div>

      <div class="rounded-2xl bg-white border border-neutral-200 p-4 md:p-8 shadow-sm">
        <div id="radial-heatmap" class="flex justify-center relative" data-heatmap={heatmapJson}></div>
        <div class="mt-4 flex justify-center gap-4 md:gap-6 flex-wrap text-xs text-[color:var(--color-ink-soft)]">
          <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-emerald-500"></span> OK</span>
          <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-amber-500"></span> 進行中 / 警告</span>
          <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-red-500"></span> 錯誤</span>
