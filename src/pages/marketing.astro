  },
  {
    label: '生活場景型',
    body: '節氣調飲、居家料理、下班放鬆 — 把產品融入真實情境，30 秒 Reels + 食譜卡 + 討論串。',
  },
  {
    label: '節氣餐桌型',
    body: '醫友策劃完整一桌餐，串起品牌全產線（食品、調味、保健、酒類），展現品牌多元性。',
  },
];

// 24 節氣方法論的 6 個代表性主題
const solarTerms = [
  { name: '夏至', date: '6/21', theme: '消暑沁涼' },
  { name: '中秋', date: '9/22', theme: '送禮節慶' },
  { name: '冬至', date: '12/21', theme: '進補暖身' },
  { name: '春節', date: '2/3', theme: '年節送禮' },
  { name: '清明', date: '4/4', theme: '祭祖追念' },
  { name: '端午', date: '6/5', theme: '創意料理' },
];

// 危機處理 SOP — L1/L2/L3
const crisisSop = [
  {
    level: 'L1',
    label: '一般留言',
    sla: '上班日每日一次',
    body: '小編依 SOP 處理：正面感謝、提問回覆、負面同理。',
  },
  {
    level: 'L2',
    label: '客訴 / 負評',
    sla: '2 小時內回應',
    body: '初步回應 → 私訊溝通 → 通報客戶窗口 → PM 追蹤至結案 → 記入月報。',
  },
  {
    level: 'L3',
    label: '重大危機',
    sla: '即時處理',
    body: '下架爭議內容 → 緊急通報公關室 → 協助擬聲明稿 → 監測輿情 72 小時 → 事後檢討報告。',
  },
];

// Top-level stats from the April 2026 campaign
const headlineStats = [
  { value: '4,634', unit: '筆', label: 'Qualified Leads（表單）' },
  { value: '$2.19', unit: '', label: '平均 CPL（業界 4–7 倍效率）' },
  { value: '5', unit: '產業', label: '跨類別實戰（醫療外）' },
];

// Three category cards
const categories = [
  {
    name: '美妝保養類',
    note: '38 則廣告 · 進行中',
    cpa: '$2.99',
    color: '#1A3A6B',
    leads: 1772,
    impressions: 473161,
    reach: 177439,
  },
  {
    name: '親子類',
    note: '46 則廣告 · 已關閉',
    cpa: '$1.94',
    color: '#0F6E56',
    leads: 2138,
    impressions: 649223,
    reach: 222583,
  },
  {
    name: '旅遊類',
    note: '4 則廣告 · 已關閉',
    cpa: '$1.00',
    color: '#BA7517',
    leads: 724,
    impressions: 127149,
    reach: 68248,
  },
];

// CPA ranking table (de-identified, sorted by CPA ascending)
const cpaTable = [
  { rank: 1, cat: '旅遊', name: 'Travel Ad-01', cpa: 0.89, leads: 343, spend: 305 },
  { rank: 2, cat: '旅遊', name: 'Travel Ad-02', cpa: 0.99, leads: 345, spend: 343 },
  { rank: 3, cat: '親子', name: 'Parenting Ad-01', cpa: 1.49, leads: 501, spend: 748 },
  { rank: 4, cat: '親子', name: 'Parenting Ad-03', cpa: 1.67, leads: 467, spend: 781 },
  { rank: 5, cat: '親子', name: 'Parenting Ad-02', cpa: 1.89, leads: 374, spend: 706 },
  { rank: 6, cat: '旅遊', name: 'Travel Ad-03', cpa: 1.96, leads: 36, spend: 71 },
  { rank: 7, cat: '親子', name: 'Parenting Ad-04', cpa: 1.99, leads: 313, spend: 622 },
  { rank: 8, cat: '美妝', name: 'Beauty Ad-01', cpa: 2.14, leads: 150, spend: 322 },
  { rank: 9, cat: '美妝', name: 'Beauty Ad-02', cpa: 2.19, leads: 405, spend: 889 },
  { rank: 10, cat: '親子', name: 'Parenting Ad-05', cpa: 2.61, leads: 97, spend: 253 },
  { rank: 11, cat: '美妝', name: 'Beauty Ad-03', cpa: 2.93, leads: 110, spend: 322 },
  { rank: 12, cat: '美妝', name: 'Beauty Ad-04', cpa: 2.97, leads: 760, spend: 2259 },
  { rank: 13, cat: '親子', name: 'Parenting Ad-06', cpa: 3.23, leads: 173, spend: 560 },
  { rank: 14, cat: '美妝', name: 'Beauty Ad-05', cpa: 9.53, leads: 5, spend: 48 },
];
const cpaTableJson = JSON.stringify(cpaTable);
const categoriesJson = JSON.stringify(categories);

// Style categories for portfolio showcase
const portfolioCats = [
  { name: '植栽生活', style: '自然系 · 情境導向', leads: 1500, cpa: '$2.50' },
  { name: '兒童教育', style: '規格導向 · 品牌感', leads: 2138, cpa: '$1.94' },
  { name: '餐飲飲品', style: '氛圍感 · 情感共鳴', leads: 760, cpa: '$2.97' },
  { name: '親子寢具', style: '溫暖感 · 信任導向', leads: 467, cpa: '$1.67' },
  { name: '親子旅遊', style: '體驗感 · 活動導向', leads: 724, cpa: '$1.00' },
];

// Pricing tiers
const pricingTiers = [
  {
    label: '單張購買',
    qty: '1 張起，彈性最高',
    price: 'NT$ 500',
    perImage: 'NT$ 500 / 張',
    body: '適合初次合作、測試風格或急件補充。彈性最高，隨時可下單。',
    saving: null,
    featured: false,
  },
  {
    label: '買斷方案',
    qty: '一次買斷 50 張',
    price: 'NT$ 400',
    perImage: 'NT$ 400 × 50 = NT$ 20,000',
    body: '50 張足以支撐完整 A/B 測試計畫。版權完整買斷，無限次使用。',
    saving: '省下 NT$ 5,000（vs 單張）',
    featured: true,
  },
  {
    label: '大量買斷方案',
    qty: '一次買斷 100 張',
    price: 'NT$ 300',
    perImage: 'NT$ 300 × 100 = NT$ 30,000',
    body: '單張成本最低，適合大量投放或代理商批量採購。',
    saving: '省下 NT$ 20,000（vs 單張）',
    featured: false,
  },
];
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage="/assets/images/og/marketing.png">
  <Nav />
  <main class="pt-20">
    <!-- breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">數位行銷</span>
    </div>

    <!-- hero -->
    <section class="relative pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-orange-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
          {category.kicker}
        </p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight max-w-4xl">
          數位行銷
        </h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          醫友 × 節氣 × 合規 — 不靠硬廣的整合行銷閉環
        </p>

        <div class="mt-6 grid grid-cols-3 gap-3 md:gap-5">
          {headlineStats.map((s) => (
            <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
              <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">
                {s.value}
                {s.unit && <span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">{s.unit}</span>}
              </div>
              <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
            </div>
          ))}
        </div>
        <div class="mt-3 text-xs text-[color:var(--color-ink-soft)]">
          資料來源：2026.04.01 — 2026.04.28 Meta Ads Manager 後台匯出（去識別化）
        </div>
      </div>
    </section>

    <!-- 5 環閉環 -->
    <section class="py-14 md:py-20 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="text-center mb-10">
          <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Closed-Loop Methodology</p>
          <h2 class="section-title mt-2">5 環閉環方法論</h2>
          <p class="section-subtitle">每一環都緊扣下一環，素材 → 醫友 → 投放 → 數據共用、結果可追蹤</p>
        </div>
        <div class="grid md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
          {closedLoop.map((s) => (
            <div class="rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
              <div class="flex items-baseline gap-2 mb-3">
                <span class="text-2xl font-bold text-[color:var(--color-brand)] tabular-nums">{s.n}</span>
                <span class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-ink-soft)]">{s.kicker}</span>
              </div>
              <h3 class="font-bold text-base text-[color:var(--color-ink)] mb-2">{s.title}</h3>
              <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 醫友資源 -->
    <section class="py-14 md:py-20">
      <div class="max-w-5xl mx-auto px-4 lg:px-6">
        <div class="rounded-2xl bg-gradient-to-br from-[color:var(--color-brand)] to-[color:var(--color-brand-deep)] text-white p-8 md:p-12 shadow-md">
          <p class="text-xs md:text-sm font-bold tracking-widest uppercase opacity-80 mb-3">醫友資源池</p>
          <h2 class="text-2xl md:text-4xl font-bold leading-tight mb-5">
            與 GCM 預防醫學發展協會合作 ——<br class="hidden md:inline" />
            900+ 醫療專業人員的內容池
          </h2>
          <p class="text-sm md:text-base opacity-90 leading-relaxed max-w-3xl">
            該協會會員須具備國家醫師、營養師、藥師、護理師等醫療專業資格方可加入。
            從中遴選具社群經營基礎（粉絲數 1,000+）的醫療專業人士擔任「醫友」，
            內容兼具<strong class="text-amber-300">專業公信力</strong>與<strong class="text-amber-300">社群傳播力</strong>，
            遠勝一般 KOL/KOC 的安全性與說服力。
          </p>
          <div class="mt-7 grid grid-cols-3 gap-4 max-w-2xl">
            <div>
              <div class="text-3xl md:text-4xl font-bold tabular-nums">900+</div>
              <div class="text-xs opacity-80 mt-1">醫療專業會員</div>
            </div>
            <div>
              <div class="text-3xl md:text-4xl font-bold tabular-nums">5+</div>
              <div class="text-xs opacity-80 mt-1">專業類別</div>
            </div>
            <div>
              <div class="text-3xl md:text-4xl font-bold tabular-nums">1K+</div>
              <div class="text-xs opacity-80 mt-1">粉絲基礎門檻</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 24 節氣 + 4 類試作 -->
    <section class="py-14 md:py-20 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="grid md:grid-cols-2 gap-8 md:gap-12">
          <!-- 24 節氣 -->
          <div>
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Solar Terms × 24</p>
            <h2 class="text-2xl md:text-3xl font-bold mt-2 mb-3">節氣為內容週期</h2>
            <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed mb-6">
              24 節氣是台灣民眾熟悉的生活節奏，每 15 天一個節氣，自然形成 24 個內容週期。
              節氣與飲食、養生緊密相關，產品配對邏輯成立、長輩傳播力強。
            </p>
            <div class="grid grid-cols-2 gap-3">
              {solarTerms.map((t) => (
                <div class="rounded-lg bg-white border border-neutral-200 px-4 py-3">
                  <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)]">{t.name} · {t.date}</div>
                  <div class="text-xs text-[color:var(--color-ink-soft)] mt-1">{t.theme}</div>
                </div>
              ))}
            </div>
          </div>
          <!-- 4 類試作 -->
          <div>
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Content Templates</p>
            <h2 class="text-2xl md:text-3xl font-bold mt-2 mb-3">4 類試作模板</h2>
            <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed mb-6">
              針對不同產品類別與節慶情境，預先設計 4 種試作模板，加速內容生產、降低跨案複製成本。
            </p>
            <ul class="space-y-3">
              {trialTemplates.map((t, i) => (
                <li class="rounded-lg bg-white border border-neutral-200 p-4">
                  <div class="flex items-baseline gap-3">
                    <span class="text-lg font-bold text-[color:var(--color-brand)] tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                    <div class="flex-1">
                      <div class="font-bold text-sm text-[color:var(--color-ink)]">{t.label}</div>
                      <p class="text-xs text-[color:var(--color-ink-soft)] mt-1 leading-relaxed">{t.body}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 合規 SOP -->
    <section class="py-14 md:py-20">
      <div class="max-w-5xl mx-auto px-4 lg:px-6">
        <div class="text-center mb-10">
          <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Compliance · Legal Review</p>
          <h2 class="section-title mt-2">律師團隊合規審查機制</h2>
          <p class="section-subtitle">酒類 / 食品 / 醫療廣告法規，內容發布前合規審查 SOP</p>
        </div>
        <div class="grid md:grid-cols-3 gap-4 md:gap-6">
          {crisisSop.map((s) => (
            <div class="rounded-2xl bg-white border border-neutral-200 p-6 shadow-sm">
              <div class="flex items-baseline gap-3 mb-3">
                <span class="inline-flex items-center justify-center w-12 h-7 rounded-md bg-[color:var(--color-brand)] text-white text-sm font-bold">{s.level}</span>
                <span class="text-sm font-medium text-[color:var(--color-ink)]">{s.label}</span>
              </div>
              <div class="text-xs font-medium tracking-wider uppercase text-[color:var(--color-brand)] mb-2">SLA · {s.sla}</div>
              <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  <!-- Differentiator -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <div class="rounded-2xl border border-orange-200 bg-orange-50/40 p-6 md:p-8">
        <p class="text-base md:text-lg">
          我們和一般行銷公司不一樣的地方，是
          <strong class="text-[color:var(--color-brand)]">與通過醫師、藥師、營養師等國家考試的師級夥伴合作</strong>，
          把專業知識帶進廣告素材的論述、視覺與投放策略。
        </p>
        <p class="mt-4 text-base md:text-lg">
          這也讓我們同時擁有兩種少見的能力：
          <strong>看得懂專業內容的素材設計</strong> + <strong>盯得緊投放表現的數據思維</strong>。
          兩件事在同一個團隊內無縫接軌，廣告才能真正帶單。
        </p>
      </div>
    </div>
  </section>

  <!-- Performance evidence -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Performance Evidence</p>
        <h2 class="section-title mt-2">投放實證 · 跨類別 CPA 表現</h2>
        <p class="section-subtitle">三大類別整合 · 美妝保養 × 親子 × 旅遊 · 全部為表單成果</p>
      </div>

      <div class="grid md:grid-cols-3 gap-4 md:gap-6 mb-12">
        {categories.map((c) => (
          <div class="rounded-2xl p-6 md:p-7 text-white shadow-sm" style={`background: ${c.color}`}>
            <div class="text-xs font-medium tracking-wider uppercase opacity-80 mb-2">{c.name}</div>
            <div class="text-xs opacity-70 mb-4">{c.note}</div>
            <div class="text-4xl font-bold tabular-nums">{c.cpa}</div>
            <div class="text-xs opacity-70 mt-1 mb-5">平均每次成果成本</div>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div><div class="opacity-70">成果數</div><div class="font-medium tabular-nums">{c.leads.toLocaleString()}</div></div>
              <div><div class="opacity-70">觸及人數</div><div class="font-medium tabular-nums">{c.reach.toLocaleString()}</div></div>
            </div>
          </div>
        ))}
      </div>

      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        <!-- Bar chart: CPA comparison -->
        <div class="rounded-xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
