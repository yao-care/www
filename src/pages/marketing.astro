const ctaHref = LINE_TEAM;

// 5 環閉環：醫友節氣閉環的方法論
const closedLoop = [
  {
    n: '01',
    kicker: 'Strategy',
    title: '策略診斷',
    body: '社群現況、SWOT、競品定位、KPI 規劃 — 把品牌與市場的距離量化下來。',
  },
