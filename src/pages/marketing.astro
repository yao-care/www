<script>
  import * as d3 from 'd3';

  const BRAND = '#c6461c';
  const TEAL = '#0F6E56';
  const NAVY = '#1A3A6B';
  const AMBER = '#BA7517';
  const MUTED = '#6B7A99';

  type Cat = { name: string; cpa: string; color: string; leads: number; impressions: number; reach: number };

  function parseCats(id: string): Cat[] {
    const el = document.getElementById(id);
    return JSON.parse(el?.getAttribute('data-categories') || '[]');
  }

  // ----- chart-cpa -----
  function drawCpaChart() {
    const host = document.getElementById('chart-cpa');
    if (!host) return;
    const cats = parseCats('chart-cpa');
    host.innerHTML = '';
    const margin = { top: 8, right: 8, bottom: 24, left: 36 };
    const width = host.clientWidth || 280;
    const height = 180;
    const svg = d3.select(host).append('svg').attr('width', width).attr('height', height).attr('viewBox', `0 0 ${width} ${height}`).style('max-width', '100%');
    const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);
    const w = width - margin.left - margin.right;
    const h = height - margin.top - margin.bottom;
    const data = cats.map((c) => ({ name: c.name, value: parseFloat(c.cpa.replace('$', '')), color: c.color }));
    const x = d3.scaleBand().domain(data.map((d) => d.name)).range([0, w]).padding(0.3);
    const y = d3.scaleLinear().domain([0, 3.5]).range([h, 0]);
    g.append('g').attr('transform', `translate(0,${h})`).call(d3.axisBottom(x).tickSize(0)).attr('font-size', 10).attr('color', MUTED);
    g.append('g').call(d3.axisLeft(y).ticks(4).tickFormat((d) => `$${d}`)).attr('font-size', 9).attr('color', MUTED);
    g.selectAll('rect').data(data).join('rect')
      .attr('x', (d) => x(d.name) || 0)
      .attr('y', (d) => y(d.value))
      .attr('width', x.bandwidth())
      .attr('height', (d) => h - y(d.value))
      .attr('rx', 3)
      .attr('fill', (d) => d.color)
      .attr('opacity', 0.85);
    g.selectAll('text.lbl').data(data).join('text')
      .attr('class', 'lbl')
      .attr('x', (d) => (x(d.name) || 0) + x.bandwidth() / 2)
      .attr('y', (d) => y(d.value) - 6)
      .attr('text-anchor', 'middle')
      .attr('font-size', 11)
      .attr('font-weight', 'bold')
      .attr('fill', (d) => d.color)
      .text((d) => `$${d.value.toFixed(2)}`);
  }

  // ----- chart-leads -----
  function drawLeadsChart() {
    const host = document.getElementById('chart-leads');
    if (!host) return;
    const cats = parseCats('chart-leads');
    host.innerHTML = '';
    const margin = { top: 8, right: 36, bottom: 24, left: 36 };
    const width = host.clientWidth || 280;
    const height = 180;
    const svg = d3.select(host).append('svg').attr('width', width).attr('height', height).attr('viewBox', `0 0 ${width} ${height}`).style('max-width', '100%');
    const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);
    const w = width - margin.left - margin.right;
    const h = height - margin.top - margin.bottom;
    type Row = { name: string; leads: number; spend: number; color: string };
    const data: Row[] = cats.map((c) => ({ name: c.name.replace('類', ''), leads: c.leads, spend: Math.round(c.leads * parseFloat(c.cpa.replace('$', ''))), color: c.color }));
    const x = d3.scaleBand().domain(data.map((d) => d.name)).range([0, w]).padding(0.4);
    const xSub = d3.scaleBand().domain(['leads', 'spend']).range([0, x.bandwidth()]).padding(0.05);
    const yLeads = d3.scaleLinear().domain([0, d3.max(data, (d) => d.leads) || 0]).range([h, 0]);
    const ySpend = d3.scaleLinear().domain([0, d3.max(data, (d) => d.spend) || 0]).range([h, 0]);
    g.append('g').attr('transform', `translate(0,${h})`).call(d3.axisBottom(x).tickSize(0)).attr('font-size', 10).attr('color', MUTED);
    g.append('g').call(d3.axisLeft(yLeads).ticks(4).tickFormat((d) => d3.format('~s')(d as number))).attr('font-size', 9).attr('color', MUTED);
    g.append('g').attr('transform', `translate(${w},0)`).call(d3.axisRight(ySpend).ticks(4).tickFormat((d) => `$${d3.format('~s')(d as number)}`)).attr('font-size', 9).attr('color', MUTED);
    data.forEach((d) => {
      const grp = g.append('g').attr('transform', `translate(${x(d.name)},0)`);
      grp.append('rect').attr('x', xSub('leads') || 0).attr('y', yLeads(d.leads)).attr('width', xSub.bandwidth()).attr('height', h - yLeads(d.leads)).attr('rx', 3).attr('fill', d.color).attr('opacity', 0.85);
      grp.append('rect').attr('x', xSub('spend') || 0).attr('y', ySpend(d.spend)).attr('width', xSub.bandwidth()).attr('height', h - ySpend(d.spend)).attr('rx', 3).attr('fill', d.color).attr('opacity', 0.4);
    });
  }

  // ----- chart-reach -----
  function drawReachChart() {
    const host = document.getElementById('chart-reach');
    if (!host) return;
    const cats = parseCats('chart-reach');
    host.innerHTML = '';
    const margin = { top: 8, right: 8, bottom: 24, left: 36 };
    const width = host.clientWidth || 280;
    const height = 180;
    const svg = d3.select(host).append('svg').attr('width', width).attr('height', height).attr('viewBox', `0 0 ${width} ${height}`).style('max-width', '100%');
    const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);
    const w = width - margin.left - margin.right;
    const h = height - margin.top - margin.bottom;
    const data = cats.map((c) => ({ name: c.name.replace('類', ''), value: c.impressions ? +(c.reach / c.impressions * 100).toFixed(1) : 0, color: c.color }));
    const x = d3.scaleBand().domain(data.map((d) => d.name)).range([0, w]).padding(0.3);
    const y = d3.scaleLinear().domain([0, 65]).range([h, 0]);
    g.append('g').attr('transform', `translate(0,${h})`).call(d3.axisBottom(x).tickSize(0)).attr('font-size', 10).attr('color', MUTED);
    g.append('g').call(d3.axisLeft(y).ticks(4).tickFormat((d) => `${d}%`)).attr('font-size', 9).attr('color', MUTED);
    g.selectAll('rect').data(data).join('rect')
      .attr('x', (d) => x(d.name) || 0)
      .attr('y', (d) => y(d.value))
      .attr('width', x.bandwidth())
      .attr('height', (d) => h - y(d.value))
      .attr('rx', 3)
      .attr('fill', (d) => d.color)
      .attr('opacity', 0.85);
    g.selectAll('text.lbl').data(data).join('text')
      .attr('class', 'lbl')
      .attr('x', (d) => (x(d.name) || 0) + x.bandwidth() / 2)
      .attr('y', (d) => y(d.value) - 6)
      .attr('text-anchor', 'middle')
      .attr('font-size', 11)
      .attr('font-weight', 'bold')
      .attr('fill', (d) => d.color)
      .text((d) => `${d.value.toFixed(1)}%`);
  }

  // ----- CPA table -----
  function renderCpaTable() {
    const tbody = document.getElementById('cpa-table-body');
    if (!tbody) return;
    type Row = { rank: number; cat: string; name: string; cpa: number; leads: number; spend: number };
    const rows: Row[] = JSON.parse(tbody.getAttribute('data-table') || '[]');
    const max = d3.max(rows, (r) => r.cpa) || 1;
    const colorMap: Record<string, string> = { 旅遊: AMBER, 親子: TEAL, 美妝: NAVY };
    const tagBg: Record<string, string> = { 旅遊: 'bg-amber-50 text-amber-700', 親子: 'bg-emerald-50 text-emerald-700', 美妝: 'bg-blue-50 text-blue-700' };
    const html = rows.map((r) => {
      const pct = ((r.cpa / max) * 100).toFixed(0);
      const c = colorMap[r.cat] || BRAND;
      return `
        <tr class="border-b border-neutral-100 last:border-0 hover:bg-neutral-50">
          <td class="py-2.5 pr-3 text-xs text-neutral-400 font-mono">${String(r.rank).padStart(2, '0')}</td>
          <td class="py-2.5 pr-3"><span class="text-xs px-1.5 py-0.5 rounded ${tagBg[r.cat] || 'bg-neutral-100'}">${r.cat}</span></td>
          <td class="py-2.5 pr-3 text-sm">${r.name}</td>
          <td class="py-2.5 pr-3 text-right font-medium tabular-nums" style="color: ${c}">$${r.cpa.toFixed(2)}</td>
          <td class="py-2.5 pr-3"><div class="h-1.5 rounded-full bg-neutral-100 overflow-hidden"><div class="h-full" style="width:${pct}%;background:${c}"></div></div></td>
          <td class="py-2.5 pr-3 text-right tabular-nums text-sm">${r.leads.toLocaleString()}</td>
          <td class="py-2.5 text-right tabular-nums text-sm">$${r.spend.toLocaleString()}</td>
        </tr>
      `;
    }).join('');
    tbody.innerHTML = html;
  }

  function renderAll() {
    drawCpaChart();
    drawLeadsChart();
    drawReachChart();
    renderCpaTable();
  }

  renderAll();
  let rt: number | undefined;
  window.addEventListener('resize', () => {
    if (rt) window.clearTimeout(rt);
    rt = window.setTimeout(renderAll, 200);
  });
</script>
