  },
  {
    n: '04',
    kicker: 'Ads',
    title: '廣告投放',
    body: 'Meta / Google / LINE 三平台投放 + A/B 測試 + 受眾優化，導購與品牌曝光分軌操作。',
  },
  {
    n: '05',
    kicker: 'Compliance',
    title: '法規合規',
    body: '律師團隊把關酒類 / 食品 / 醫療法規，內容發布前合規審查 SOP，降低裁罰風險。',
  },
];

// 4 類試作模板
const trialTemplates = [
  {
    label: '產品導購型',
    body: '醫友以專業視角拆解產品成分 / 用法 / 適用情境，搭配 ASMR 料理或試用畫面，UGC 挑戰賽放大互動。',
