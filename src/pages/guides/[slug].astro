---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { GUIDES, GUIDE_BY_SLUG } from '../../guides.config';
import { PRODUCT_BY_SLUG } from '../../products.config';
import { GLOSSARY_BY_SLUG } from '../../glossary.config';
import { SITE } from '../../site.config';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = GUIDE_BY_SLUG[slug!];
const related = (guide.related ?? []).map((s) => PRODUCT_BY_SLUG[s]);
const terms = (guide.relatedTerms ?? []).map((s) => GLOSSARY_BY_SLUG[s]).filter(Boolean);

const pageTitle = `${guide.question} · yao.care`;
const pageDescription = guide.answer;
const canonical = new URL(`/guides/${guide.slug}/`, SITE.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: guide.question,
      description: guide.answer,
      inLanguage: 'zh-TW',
      mainEntityOfPage: canonical,
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
        logo: { '@type': 'ImageObject', url: `${SITE.url}/assets/images/logo.png` },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: '指南', item: new URL('/guides', SITE.url).toString() },
        { '@type': 'ListItem', position: 3, name: guide.question, item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: guide.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDescription} ogType="article" jsonLd={jsonLd}>
  <Nav />
  <main class="pt-20">
    <!-- breadcrumb -->
    <div class="max-w-3xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <a href="/guides" class="hover:text-[color:var(--color-brand)]">指南</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">{guide.question}</span>
    </div>

    <article class="max-w-3xl mx-auto px-4 lg:px-6 py-8 md:py-12">
      <h1 class="text-3xl md:text-4xl font-bold leading-tight">{guide.question}</h1>

      <!-- direct answer -->
      <p class="mt-5 text-lg md:text-xl text-[color:var(--color-ink)] leading-relaxed font-medium border-l-4 border-[color:var(--color-brand)] pl-4">
        {guide.answer}
      </p>

      {guide.searchPhrases.length > 0 && (
        <p class="mt-4 text-xs text-[color:var(--color-ink-muted)]">
          常見問法：{guide.searchPhrases.join('、')}
        </p>
      )}

      <!-- sections -->
      <div class="mt-10 space-y-10">
        {guide.sections.map((s) => (
          <section>
            <h2 class="text-xl md:text-2xl font-bold text-[color:var(--color-ink)]">{s.heading}</h2>
            {s.paragraphs && (
              <div class="mt-3 space-y-3 text-base text-[color:var(--color-ink-soft)] leading-relaxed">
                {s.paragraphs.map((p) => <p>{p}</p>)}
              </div>
            )}
            {s.bullets && (
              <ul class="mt-4 space-y-2.5">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-[color:var(--color-ink)]">
                    <svg class="w-5 h-5 mt-0.5 shrink-0 text-[color:var(--color-brand)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      {guide.externalResources && guide.externalResources.length > 0 && (
        <div class="mt-10 pt-6 border-t border-neutral-200 text-sm text-[color:var(--color-ink-soft)]">
          <p class="font-medium text-[color:var(--color-ink)] mb-2">延伸資源</p>
          {guide.externalResources.map((r) => (
            <p class="leading-relaxed">
              {r.before}{' '}
              <a href={r.url} target="_blank" rel="noopener" class="text-[color:var(--color-brand)] hover:underline underline-offset-2">{r.label}</a>
              {r.after}
            </p>
          ))}
        </div>
      )}
    </article>

    <!-- tool callout + related products -->
    {related.length > 0 && (
      <section class="py-12 md:py-16 bg-neutral-50">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="mb-8 max-w-3xl mx-auto">
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">yao.care 怎麼幫上忙</p>
            {guide.toolIntro && (
              <p class="mt-3 text-base md:text-lg text-[color:var(--color-ink)] leading-relaxed">{guide.toolIntro}</p>
            )}
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {related.map((p) => <ProductCard product={p} variant="preview" />)}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    {guide.faqs.length > 0 && (
      <section class="py-14 md:py-20">
        <div class="max-w-3xl mx-auto px-4 lg:px-6">
          <div class="mb-8">
            <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">FAQ</p>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold">常見問題</h2>
          </div>
          <div class="space-y-3">
            {guide.faqs.map((f) => (
              <details class="group rounded-xl bg-white border border-neutral-200 shadow-sm overflow-hidden">
                <summary class="cursor-pointer p-5 md:p-6 flex items-start gap-4 list-none">
                  <span class="flex-1 font-bold text-[color:var(--color-ink)]">{f.q}</span>
                  <svg class="shrink-0 w-5 h-5 mt-0.5 text-[color:var(--color-ink-soft)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="px-5 md:px-6 pb-5 md:pb-6 pt-0 text-[color:var(--color-ink-soft)] leading-relaxed border-t border-neutral-100">
                  <p class="pt-4">{f.a}</p>
                </div>
              </details>
            ))}
          </div>

          {terms.length > 0 && (
            <div class="mt-10 pt-6 border-t border-neutral-200">
              <p class="text-sm font-medium text-[color:var(--color-ink)] mb-3">相關名詞解釋</p>
              <div class="flex flex-wrap gap-2">
                {terms.map((t) => (
                  <a href={`/glossary/${t.slug}/`} class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white border border-neutral-200 text-sm text-[color:var(--color-ink-soft)] hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">
                    {t.term}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- back -->
    <div class="max-w-3xl mx-auto px-4 lg:px-6 pb-12">
      <a href="/guides" class="inline-flex items-center gap-2 text-sm text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-brand)]">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        看更多情境指南
      </a>
    </div>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
