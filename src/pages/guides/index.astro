---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import { GUIDES, AUDIENCE_LABEL, type Guide } from '../../guides.config';
import { SITE } from '../../site.config';

const pageTitle = '健康與醫療 AI 情境指南 · yao.care';
const pageDescription =
  '長輩衰弱怎麼評估、小孩發展會不會遲緩、成人功能下滑、AI 醫療內容如何合規、長照據點怎麼報到 — yao.care 以你會搜尋的問題出發，給直接解答與工具。';

const order: Guide['audience'][] = ['caregiver', 'parent', 'adult', 'b2b', 'all'];
const groups = order
  .map((a) => ({ audience: a, label: AUDIENCE_LABEL[a], items: GUIDES.filter((g) => g.audience === a) }))
  .filter((g) => g.items.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageTitle,
  itemListElement: GUIDES.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.question,
    url: new URL(`/guides/${g.slug}/`, SITE.url).toString(),
  })),
};
---
<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Nav />
  <main class="pt-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">指南</span>
    </div>

    <section class="relative pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Guides</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight">情境指南</h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          從你會搜尋的那個問題出發 —— 先給直接、實用的解答，再告訴你 yao.care 哪個服務幫得上忙。
        </p>
      </div>
    </section>

    <section class="py-10 md:py-14">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 space-y-12">
        {groups.map((grp) => (
          <div>
            <h2 class="text-xl md:text-2xl font-bold mb-5">{grp.label}</h2>
            <div class="grid md:grid-cols-2 gap-5 md:gap-6">
              {grp.items.map((g) => (
                <a href={`/guides/${g.slug}/`} class="group block rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all">
                  <h3 class="text-lg font-bold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors leading-snug">{g.question}</h3>
                  <p class="mt-3 text-sm text-[color:var(--color-ink-soft)] leading-relaxed line-clamp-3">{g.answer}</p>
                  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-brand)]">
                    看解答
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
