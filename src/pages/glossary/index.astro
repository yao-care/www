---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import { GLOSSARY } from '../../glossary.config';
import { CATEGORY_BY_SLUG } from '../../products.config';
import { SITE } from '../../site.config';

const pageTitle = '醫療 AI 名詞解釋（知識庫） · yao.care';
const pageDescription =
  'SMART on FHIR、ATC 藥品碼、CFS 臨床衰弱量表、ASQ-3、WHO 內在能力、老藥新用、CDSS、醫療生成式 AI 指引、MCP — yao.care 醫療與 AI 名詞的清楚定義。';

const groups = (['medical', 'ai', 'care'] as const).map((cat) => ({
  cat,
  label: CATEGORY_BY_SLUG[cat].label,
  terms: GLOSSARY.filter((t) => t.category === cat),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'yao.care 醫療 AI 名詞解釋',
  description: pageDescription,
  url: new URL('/glossary', SITE.url).toString(),
  hasDefinedTerm: GLOSSARY.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    alternateName: t.en,
    description: t.oneLiner,
    url: new URL(`/glossary/${t.slug}`, SITE.url).toString(),
  })),
};
---
<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Nav />
  <main class="pt-20">
    <!-- breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">知識庫</span>
    </div>

    <!-- hero -->
    <section class="relative pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Glossary</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight">醫療 AI 名詞解釋</h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          把醫療資訊與 AI 領域的關鍵名詞講清楚 —— 從 SMART on FHIR、ATC 藥品碼到 CFS、ASQ-3、內在能力與生成式 AI 指引。
        </p>
      </div>
    </section>

    <!-- terms by category -->
    <section class="py-10 md:py-14">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 space-y-12">
        {groups.map((g) => (
          <div>
            <h2 class="text-xl md:text-2xl font-bold mb-5">{g.label}</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
              {g.terms.map((t) => (
                <a href={`/glossary/${t.slug}`} class="group block rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all">
                  <h3 class="text-lg font-bold text-[color:var(--color-ink)] group-hover:text-[color:var(--color-brand)] transition-colors">{t.term}</h3>
                  <p class="text-xs font-medium tracking-wide uppercase text-[color:var(--color-ink-soft)] mt-0.5">{t.en}</p>
                  <p class="mt-3 text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{t.oneLiner}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
