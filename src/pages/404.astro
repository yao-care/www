---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FooterLinks from '../components/FooterLinks.astro';
import { NAV } from '../nav.config';
---
<BaseLayout title="找不到頁面（404）— yao.care" description="您要找的頁面不存在或已移動，請從以下入口繼續瀏覽 yao.care 的智慧醫療、AI 系統、高齡友善與數位行銷服務。">
  <Nav />
  <main class="min-h-[70vh] flex items-center justify-center px-4 py-24">
    <div class="max-w-2xl text-center">
      <p class="text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Error 404</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tight">找不到這個頁面</h1>
      <p class="mt-5 text-lg text-[color:var(--color-ink-soft)] leading-relaxed">
        您要找的內容可能已移動或不存在。試試以下入口，或回到首頁。
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {NAV.map((n) => (
          <a href={n.href} class="px-4 py-2 rounded-full border border-neutral-300 text-sm font-medium hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)] transition-colors">{n.label}</a>
        ))}
      </div>
      <p class="mt-8">
        <a href="/" class="btn-brand">回首頁</a>
      </p>
    </div>
  </main>
  <FooterLinks />
</BaseLayout>
