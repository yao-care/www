---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import ProductNews from '../../components/news/ProductNews.astro';
import RelatedTopics from '../../components/products/RelatedTopics.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';

const product = PRODUCT_BY_SLUG.siqc;

// Hero stats — 價值 / 信任導向（實績 + 規模 + 標準 + 品質）
const headlineStats = [
  { value: '13', unit: '', label: '間醫院 ESG 盤點輔導' },
  { value: '64', unit: '+', label: 'ISMS 文件框架' },
  { value: '93', unit: '', label: 'ISO 27001 控制項對照' },
  { value: '≥95', unit: '%', label: 'AI 稽核助理 QA 命中率' },
];

// 運作方式 — 收斂版（取代原 modules / schedule / tech stack 三段）
const howItWorks = [
  {
    tag: 'Scan & Inventory',
    title: '自動掃描與盤點',
    body: '12 個 GitHub Actions workflow 驅動 13 條掃描管線（SAST、弱點掃描、滲透測試、SBOM、CVE、AI/LLM 安全等），並每 15 分鐘輪詢 CVE，Critical / High 自動 email 告警。',
  },
  {
    tag: 'Auto-Fix & Gap',
    title: '文件自動修復與缺口分析',
    body: '64+ 份 ISMS 文件框架，三條自動維護線：基礎設施缺漏自動補、版本不同步自動重產、內容不合規建 PR 交人工審查，缺口一目了然。',
  },
  {
    tag: 'AI Auditor',
    title: 'AI 稽核助理',
    body: '單頁離線 HTML（~3MB）內嵌全部文件與掃描報告，三層檢索 + Claude 推理，每月 QA 命中率 ≥ 95%；可在地端 / 離線的受控環境運作，敏感文件不外流。',
  },
  {
    tag: 'Audit Pack',
    title: '離線稽核包交付',
    body: '以 GitHub Release 打包（tag audit-YYYYMMDD），稽核顧問解壓後開啟 index.html 即可離線審查，不必另建環境。',
  },
];

// dogfooding：SIQC 目前維運的自家產品線
const liveProjects = [
  { name: 'yao.care / TwTxGNN', type: '藥物再利用 AI 模型', depth: '每日 standard · 每月 deep' },
  { name: 'weiqi.kids / tax-ai', type: '稅務 AI 助理（含 LLM endpoint）', depth: '每日 standard · 每月 deep' },
];
---
<ProductLayout slug="siqc">
  <ProductHero product={product} taglineNowrap>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
        {headlineStats.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
            <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">
              {s.value}
              {s.unit && <span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">{s.unit}</span>}
            </div>
            <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
    </Fragment>
  </ProductHero>

  <!-- 定位 + 跨場景共通痛點 -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <p class="text-base md:text-lg">
        不論要通過 <strong>ISO 27001</strong>、編製 <strong>ESG 永續報告</strong>，
        還是準備 <strong>醫策會 / JCI 醫院評鑑</strong>，都會撞到同樣三件事：
        制度文件散落各處、人工維護版本不可持續、每次稽核都要手動彙整證據。
      </p>
      <p class="mt-5 text-base md:text-lg">
        SIQC 把這三件事串成
        <strong class="text-[color:var(--color-brand)]">一條由 12 個 GitHub Actions workflow 驅動的自動化管線</strong>：
        安全掃描、ISMS 文件自動修復，再產出可離線審查的 AI 稽核助理與稽核包。制度條文不再只是躺著的文件，是每天真的跑得動的檢核。
      </p>
      <p class="mt-5 text-base md:text-lg">
        而且它<strong>不是 demo</strong>：我們自己就靠這套落實公司的 ISO 27001 資訊安全管理制度，
        也用同一套框架幫醫療機構做 ESG ——
        <strong class="text-[color:var(--color-brand)]">自用驗證過，也能協助你導入</strong>。
      </p>
    </div>
  </section>

  <!-- 適用場景（整併「適用稽核類型」+「合規涵蓋」）-->
  <section class="py-12 md:py-16 bg-gradient-to-b from-orange-50/30 to-white">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Applicable Scenarios</p>
        <h2 class="section-title mt-2">適用場景</h2>
        <p class="section-subtitle">同一套自動化框架，換一組文件與對照矩陣就能重新組態</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 max-w-6xl mx-auto">
        <div class="rounded-2xl bg-white border-l-4 border-[color:var(--color-brand)] border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">資訊安全</div>
          <h3 class="font-bold text-base mb-2">ISO 27001 / SOC 2</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            ISMS 文件 + SAST / SBOM / CVE 掃描，Annex A 93 控制項對照，並對齊 SOC 2 TSC、OWASP ASVS、OWASP LLM Top 10、NIST AI RMF。
          </p>
        </div>
        <div class="rounded-2xl bg-white border-l-4 border-emerald-500 border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-emerald-600 mb-2">永續報告</div>
          <h3 class="font-bold text-base mb-2">ESG · GRI / TCFD / SASB</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            指標蒐集、報告書生成、證據檔案管理，對應金管會與證交所永續揭露要求；已實際用於醫療機構碳盤查。
          </p>
        </div>
        <div class="rounded-2xl bg-white border-l-4 border-blue-500 border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-blue-600 mb-2">醫療評鑑</div>
          <h3 class="font-bold text-base mb-2">醫策會 / JCI</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            醫院評鑑文件版控、條文對應、稽核包匯出；可串接醫院 HIS / EMR。
          </p>
        </div>
        <div class="rounded-2xl bg-white border-l-4 border-amber-500 border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-amber-600 mb-2">品質與治理</div>
          <h3 class="font-bold text-base mb-2">ISO 9001 / 14001 / GRC</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            品質、環境、風險管理框架，企業治理 GRC 整合，制度文件可重複稽核。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 運作方式（收斂版）-->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-12">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">How It Works</p>
        <h2 class="section-title mt-2">運作方式</h2>
        <!-- ai-voice-ok: 四步是產品定義的流程名稱 -->
        <p class="section-subtitle">四步把「掃描 → 修復 → 問答 → 交付」串成一條無人介入的合規生產線</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        {howItWorks.map((m, i) => (
          <div class="rounded-2xl bg-white border border-neutral-200 p-5 md:p-7 shadow-sm flex gap-5">
            <div class="shrink-0 text-2xl md:text-3xl font-bold text-[color:var(--color-brand)]/30 tabular-nums leading-none">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div>
              <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">{m.tag}</div>
              <h3 class="font-bold text-base md:text-lg mb-2">{m.title}</h3>
              <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{m.body}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center text-xs md:text-sm text-[color:var(--color-ink-soft)]">
        技術基礎：完全建構在 GitHub 生態（GitHub Actions + Release），無需額外伺服器即可導入。
      </p>
    </div>
  </section>

  <!-- 實績帶：dogfooding + ESG -->
  <section class="py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Proof</p>
        <h2 class="section-title mt-2">實績：自家驗證，也對外落地</h2>
        <p class="section-subtitle">我們先用它管好自己，再把同一套能力延伸到客戶的合規與永續</p>
      </div>

      <!-- A. dogfooding -->
      <div class="rounded-2xl bg-white border border-neutral-200 p-6 md:p-8 shadow-sm mb-6">
        <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">We use it ourselves</div>
        <h3 class="font-bold text-lg md:text-xl mb-3">我們自己就在用</h3>
        <p class="text-sm md:text-base text-[color:var(--color-ink-soft)] leading-relaxed mb-6 max-w-3xl">
          藥提醒以 SIQC 落實公司自家的 ISO 27001 / CNS 27001 資訊安全管理制度（Annex A 93 控制項對照），
          並自製 ISMS 知識助理，稽核當下查得到條文、引得出出處，平時也拿來做內部演練。它同時長期為我們自家多個產品線提供合規維運：
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          {liveProjects.map((p) => (
            <div class="rounded-xl bg-neutral-50 border border-neutral-200 p-5">
              <div class="font-mono text-sm text-[color:var(--color-brand)] mb-1.5">{p.name}</div>
              <h4 class="font-bold text-sm mb-3">{p.type}</h4>
              <span class="inline-block text-xs px-2 py-1 rounded-md bg-emerald-50 text-emerald-700 font-medium">
                {p.depth}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- B. ESG 導入實績 -->
      <div class="rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 text-white p-8 md:p-10 shadow-md">
        <p class="text-xs md:text-sm font-bold tracking-widest uppercase opacity-80 mb-3">Field Case · ESG · 與國際醫療減碳協會合作</p>
        <h3 class="text-xl md:text-2xl font-bold leading-tight mb-4">
          協助醫療機構建置能源管理系統，落實 ESG Scope 3 盤點
        </h3>
        <p class="text-sm md:text-base opacity-90 leading-relaxed max-w-3xl">
          與
          <a href="https://crinhealthcare.org/" target="_blank" rel="noopener" class="underline decoration-amber-300/70 hover:decoration-amber-300">國際醫療減碳協會</a>
          合作，協助醫療機構盤點、記錄與管理能源使用及碳排資料，並逐步支援價值鏈間接碳排（Scope 3）管理，
          把制度性要求、資料盤點、跨單位蒐集與紀錄留存整合為可營運的資訊系統。
        </p>
        <div class="mt-7 grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-2xl">
          <div>
            <div class="text-3xl md:text-4xl font-bold tabular-nums">13</div>
            <div class="text-xs opacity-80 mt-1">間醫院 ESG 盤點輔導</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold">Scope 3</div>
            <div class="text-xs opacity-80 mt-1">價值鏈間接碳排管理</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold">能源</div>
            <div class="text-xs opacity-80 mt-1">能源管理系統建置</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <RelatedTopics product="siqc" />

  <ProductCta
    product={product}
    headline="想了解這套怎麼幫你過稽核？"
    description="ISO 27001、ESG 永續報告、醫院評鑑，這套流程我們自家先驗證過，也能協助你評估與導入。用 LINE 私訊你的稽核情境，我們一起看怎麼落地。"
  />

  <ProductNews slot="news" target="siqc" />
</ProductLayout>
