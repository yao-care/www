---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductHero from '../../components/products/ProductHero.astro';
import ProductCta from '../../components/products/ProductCta.astro';
import ProductNews from '../../components/news/ProductNews.astro';
import { PRODUCT_BY_SLUG } from '../../products.config';

const product = PRODUCT_BY_SLUG.siqc;

const headlineStats = [
  { value: '12', unit: '', label: 'GitHub Actions Workflows' },
  { value: '13', unit: '', label: '掃描管線' },
  { value: '64', unit: '份', label: 'ISMS 文件自動修復' },
  { value: '95', unit: '%+', label: 'AI 助理 QA 命中率' },
];

// System modules
const modules = [
  {
    name: '掃描管線（13 項）',
    body: 'SAST、弱點掃描、滲透測試、SBOM、CVE 月報、源碼交付驗證、密碼學稽核、AI/LLM 安全（OWASP LLM Top 10）、AI 供應鏈、SEO、WordPress、連結檢查',
    tag: 'Security Scans',
  },
  {
    name: 'ISMS 文件庫（64 份）',
    body: '程序書 PRO · 政策 POL · 標準 STD · 指引 GDL · 表單 FRM · 計畫 PLN · 登錄冊 REG · 工作指引 WKI · 對照矩陣 MTX',
    tag: 'Documents',
  },
  {
    name: '文件自動修復',
    body: '三條閉環：A（基礎設施缺漏）自動 commit · B（版本不同步）自動重產 · C（內容不合規）建 PR 人工審查',
    tag: 'Auto-Fix',
  },
  {
    name: 'AI 稽核助理',
    body: '單一 HTML 離線應用（~3MB），內嵌全部 ISMS 文件與掃描報告，三層檢索 + Claude 推理，每月 QA 驗證命中率 ≥ 95%',
    tag: 'AI Assistant',
  },
  {
    name: 'CVE 即時情報',
    body: '每 15 分鐘輪詢 OSV API，Critical / High 自動發送 email 告警',
    tag: 'Real-time CVE',
  },
  {
    name: '運行時監控',
    body: '每日治理態勢檢查、事件回應演練排程、每週紅隊演練（Purple Team Agent）',
    tag: 'Runtime',
  },
  {
    name: '稽核包發行',
    body: 'GitHub Release 打包（tag audit-YYYYMMDD），顧問解壓後開啟 index.html 即可離線審查',
    tag: 'Audit Pack',
  },
];

// Schedule
const schedule = [
  { freq: '每 15 分鐘', what: 'CVE 即時情報輪詢', color: '#ef4444' },
  { freq: '每日 06:17', what: '快速掃描（CVE + SAST + AI 安全）', color: '#0F6E56' },
  { freq: '每日 14:00', what: '運行時監控 + 治理態勢', color: '#0F6E56' },
  { freq: '每日 16:00', what: '事件回應演練排程檢查', color: '#0F6E56' },
  { freq: '每週一 11:00', what: '紅隊演練（Purple Team Agent）', color: '#1A3A6B' },
  { freq: '每月 1 日', what: '全深度掃描 + CVE 月報 + QA 驗證報告', color: '#c6461c' },
  { freq: '每月 15 日', what: 'ISMS 文件稽核', color: '#c6461c' },
  { freq: '推送觸發', what: 'ISMS 文件渲染 + 稽核助理建置', color: '#6B7A99' },
];

// Compliance coverage
const compliance = [
  { name: 'ISO 27001:2022 / CNS 27001', detail: 'Annex A 93 項控制項完整對照', icon: '🛡️' },
  { name: 'SOC 2 TSC', detail: '交叉對照矩陣', icon: '📋' },
  { name: 'OWASP ASVS', detail: '應用程式安全驗證標準', icon: '🔒' },
  { name: 'OWASP LLM Top 10 / NIST AI RMF', detail: 'AI 安全專項', icon: '🤖' },
];

// Managed projects
const projects = [
  {
    name: 'yao.care / TwTxGNN',
    type: '藥物再利用 AI 模型',
    depth: '每日 standard / 每月 deep',
  },
  {
    name: 'weiqi.kids / tax-ai',
    type: '稅務 AI 助理（含 LLM endpoint）',
    depth: '每日 standard / 每月 deep',
  },
];

// Tech stack
const techStack = [
  { kind: 'CI/CD', items: ['GitHub Actions（12 個 workflow）'] },
  { kind: '掃描工具', items: ['Semgrep', 'Trivy', 'OWASP ZAP', 'WPScan', 'Nuclei', 'Garak'] },
  { kind: '文件管理', items: ['Markdown → HTML 渲染', '_meta/ 驅動閉環修復'] },
  { kind: 'AI 助理', items: ['單頁 HTML 應用', 'MiniSearch 全文索引', 'Claude API 推理'] },
  { kind: '後端服務', items: ['AKORA App（token 管理、表單提交、AI 問答 proxy）'] },
  { kind: 'Runtime', items: ['Node.js', 'Shell scripts'] },
];
---
<ProductLayout slug="siqc">
  <ProductHero product={product}>
    <Fragment slot="hero-extras">
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
        {headlineStats.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 px-4 py-3 md:px-5 md:py-4 shadow-sm">
            <div class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)] tabular-nums">
              {s.value}
              {s.unit && <span class="text-sm font-medium text-[color:var(--color-ink-soft)] ml-1">{s.unit}</span>}
            </div>
            <div class="text-xs text-[color:var(--color-ink-soft)] mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
    </Fragment>
  </ProductHero>

  <!-- Applicable audit types -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-orange-50/30 to-white">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Applicable Audit Frameworks</p>
        <h2 class="section-title mt-2">適用稽核 / 評鑑類型</h2>
        <p class="section-subtitle">同一套自動化框架，可重新組態到多種稽核情境</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 max-w-6xl mx-auto">
        <div class="rounded-2xl bg-white border-l-4 border-[color:var(--color-brand)] border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-2">資訊安全</div>
          <h3 class="font-bold text-base mb-2">ISO 27001 / SOC 2</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            ISMS 文件 + SAST/SBOM/CVE 掃描，對齊 OWASP ASVS、OWASP LLM Top 10。
          </p>
        </div>
        <div class="rounded-2xl bg-white border-l-4 border-emerald-500 border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-emerald-600 mb-2">永續報告</div>
          <h3 class="font-bold text-base mb-2">ESG · GRI / TCFD / SASB</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            指標蒐集、報告書生成、證據檔案管理，對應永續金管會與證交所要求。
          </p>
        </div>
        <div class="rounded-2xl bg-white border-l-4 border-blue-500 border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-blue-600 mb-2">醫療評鑑</div>
          <h3 class="font-bold text-base mb-2">醫策會 / JCI</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            醫院評鑑文件版控、條文對應、稽核包匯出；可串接醫院 HIS / EMR。
          </p>
        </div>
        <div class="rounded-2xl bg-white border-l-4 border-amber-500 border-t border-r border-b border-neutral-200 p-5 md:p-6 shadow-sm">
          <div class="text-xs font-bold tracking-wider uppercase text-amber-600 mb-2">品質與管理</div>
          <h3 class="font-bold text-base mb-2">ISO 9001 / 14001 / GRC</h3>
          <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">
            品質、環境、風險管理框架，企業治理 GRC 整合，可重複稽核。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain points & solution -->
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 lg:px-6 text-[color:var(--color-ink)] leading-relaxed">
      <p class="text-base md:text-lg">
        中小型軟體團隊要通過 ISO 27001 認證，通常面臨三個痛點：
      </p>
      <ol class="mt-4 space-y-2 text-base">
        <li><strong>1.</strong> 安全掃描散落各處 — SAST、弱點掃描、滲透測試、SBOM 各跑各的，結果無法統整</li>
        <li><strong>2.</strong> ISMS 文件維護成本高 — 60+ 份程序書、政策、表單需要人工維護版本與合規性</li>
        <li><strong>3.</strong> 稽核準備耗時 — 每次稽核要手動彙整文件、報告、證據</li>
      </ol>
      <p class="mt-5 text-base md:text-lg">
        SIQC 把這三件事串成
        <strong class="text-[color:var(--color-brand)]">一條自動化管線</strong>
        ，用 12 個 GitHub Actions workflow 驅動，
        配合 AI agent 自動修復文件缺陷、產出離線稽核助理 ——
        全流程無人介入。
      </p>
      <p class="mt-5 text-base md:text-lg">
        從要通過 <strong>ISO 27001</strong> 的中小型軟體團隊、需要備 <strong>ESG 永續報告</strong>的企業，
        到準備 <strong>醫策會 / JCI 評鑑</strong>的醫療機構，都能用同一套框架重新組態 ——
        差別只在掛載哪一組文件與對照矩陣。
      </p>
    </div>
  </section>

  <!-- System modules -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-12">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">System Architecture</p>
        <h2 class="section-title mt-2">系統組成</h2>
        <p class="section-subtitle">7 個模組串成一條完整的合規生產線</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {modules.map((m) => (
          <div class="rounded-2xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
            <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-3">
              {m.tag}
            </div>
            <h3 class="font-bold text-base md:text-lg mb-3">{m.name}</h3>
            <p class="text-sm text-[color:var(--color-ink-soft)] leading-relaxed">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Schedule -->
  <section class="py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Automation Schedule</p>
        <h2 class="section-title mt-2">自動化排程</h2>
        <p class="section-subtitle">從每 15 分鐘到每月，全頻段覆蓋</p>
      </div>

      <div class="rounded-2xl bg-white border border-neutral-200 overflow-hidden shadow-sm">
        <div class="divide-y divide-neutral-100">
          {schedule.map((s) => (
            <div class="flex items-center gap-4 md:gap-6 px-5 md:px-7 py-4 md:py-5 hover:bg-neutral-50">
              <div class="shrink-0 w-32 md:w-44 font-mono text-xs md:text-sm font-bold" style={`color: ${s.color}`}>
                {s.freq}
              </div>
              <div class="text-sm md:text-base text-[color:var(--color-ink)]">{s.what}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance coverage -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-12">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Compliance Coverage</p>
        <h2 class="section-title mt-2">合規涵蓋</h2>
        <p class="section-subtitle">不只 ISO 27001，多個合規框架同步對照</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {compliance.map((c) => (
          <div class="rounded-xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
            <div class="text-3xl mb-3">{c.icon}</div>
            <h3 class="font-bold text-sm md:text-base text-[color:var(--color-ink)] mb-2">{c.name}</h3>
            <p class="text-xs text-[color:var(--color-ink-soft)] leading-relaxed">{c.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Managed projects -->
  <section class="py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Live Projects</p>
        <h2 class="section-title mt-2">目前管理的專案</h2>
        <p class="section-subtitle">SIQC 同時為兩個產品線提供合規維運</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        {projects.map((p) => (
          <div class="rounded-2xl bg-white border border-neutral-200 p-6 md:p-7 shadow-sm">
            <div class="font-mono text-sm text-[color:var(--color-brand)] mb-2">{p.name}</div>
            <h3 class="font-bold text-base mb-3">{p.type}</h3>
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-1 rounded-md bg-emerald-50 text-emerald-700 font-medium">
                {p.depth}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech stack -->
  <section class="py-14 md:py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-12">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Tech Stack</p>
        <h2 class="section-title mt-2">技術棧</h2>
        <p class="section-subtitle">完全建構在 GitHub 生態系上，無需額外基礎設施</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {techStack.map((s) => (
          <div class="rounded-xl bg-white border border-neutral-200 p-5 md:p-6 shadow-sm">
            <div class="text-xs font-bold tracking-wider uppercase text-[color:var(--color-brand)] mb-3">
              {s.kind}
            </div>
            <ul class="space-y-1.5">
              {s.items.map((item) => (
                <li class="text-sm text-[color:var(--color-ink)] font-mono">· {item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 導入實績 · ESG 永續 -->
  <section class="py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 lg:px-6">
      <div class="text-center mb-10">
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">Field Case · ESG</p>
        <h2 class="section-title mt-2">導入實績 · ESG 永續</h2>
        <p class="section-subtitle">把「制度條文 → 可自動檢核」的能力，延伸到醫療機構的淨零減碳</p>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 text-white p-8 md:p-10 shadow-md">
        <p class="text-xs md:text-sm font-bold tracking-widest uppercase opacity-80 mb-3">與國際醫療減碳協會合作</p>
        <h3 class="text-xl md:text-2xl font-bold leading-tight mb-4">
          協助醫療機構建置能源管理系統，落實 ESG Scope 3 盤點
        </h3>
        <p class="text-sm md:text-base opacity-90 leading-relaxed max-w-3xl">
          與
          <a href="https://crinhealthcare.org/" target="_blank" rel="noopener" class="underline decoration-amber-300/70 hover:decoration-amber-300">國際醫療減碳協會</a>
          合作，協助醫療機構盤點、記錄與管理能源使用及碳排資料，並逐步支援價值鏈間接碳排（Scope 3）管理，
          把制度性要求、資料盤點、跨單位蒐集與紀錄留存整合為可營運的資訊系統。
        </p>
        <div class="mt-7 grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-2xl">
          <div>
            <div class="text-3xl md:text-4xl font-bold tabular-nums">13</div>
            <div class="text-xs opacity-80 mt-1">間醫院 ESG 盤點輔導</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold">Scope 3</div>
            <div class="text-xs opacity-80 mt-1">價值鏈間接碳排管理</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold">能源</div>
            <div class="text-xs opacity-80 mt-1">能源管理系統建置</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ProductCta
    product={product}
    headline="想要這套合規自動化？"
    description="不論您是準備 ISO 27001 認證、想擺脫人工維護 ISMS 的痛苦，或是需要為 AI 系統做合規對照 —— 用 LINE 私訊您的需求，我們可以協助評估與導入。"
  />

  <ProductNews slot="news" target="siqc" />
</ProductLayout>
