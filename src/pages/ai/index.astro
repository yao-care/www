---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterLinks from '../../components/FooterLinks.astro';
import ContactMap from '../../components/ContactMap.astro';
import CareTag from '../../components/CareTag.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import CapabilityCloud from '../../components/products/CapabilityCloud.astro';
import { CATEGORY_BY_SLUG, productsByCategory } from '../../products.config';

const category = CATEGORY_BY_SLUG.ai;
const products = productsByCategory('ai');

const pageTitle = 'AI 系統 · yao.care';
const pageDescription =
  '把專業知識變成自動化、可重複跑的 AI 系統 — 情報追蹤、ISO/ESG/醫院評鑑、TRIZ 創新方法庫。RAG + 多角色 Agent 把專業領域決策結構化。';

const aiCapabilities = [
  { label: 'AI 系統設計與落地', en: 'AI System Implementation' },
  { label: 'AI 導入企業流程', en: 'AI for Business Process' },
  { label: 'AI Agent 設計與應用', en: 'AI Agent Design' },
  { label: '企業知識庫 AI 化', en: 'AI-powered Knowledge Base' },
  { label: '知識結構化與知識工程', en: 'Knowledge Engineering' },
  { label: '工作流程設計與自動化', en: 'Workflow Automation' },
  { label: '多來源資料整合', en: 'Data Integration / Fusion' },
  { label: '圖譜推理 / 關聯分析', en: 'Graph-based AI / Knowledge Graph' },
  { label: 'ISO / ESG / GRC 合規系統設計', en: 'GRC System Design' },
  { label: '稽核與評鑑流程 AI 化', en: 'Audit Automation' },
  { label: '複雜系統產品化', en: 'Productizing Complex Systems' },
  { label: '系統化思維與決策建模', en: 'Systems Thinking / Decision Modeling' },
  { label: '複雜議題拆解與結構化表達', en: 'Structured Communication' },
  { label: 'AI 教育與學習系統設計', en: 'AI in Education / EdTech' },
];
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage="/assets/images/og/intel.png">
  <Nav />
  <main class="pt-20">
    <!-- breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 lg:px-6 pt-6 text-sm text-[color:var(--color-ink-soft)]">
      <a href="/" class="hover:text-[color:var(--color-brand)]">首頁</a>
      <span class="mx-1.5">›</span>
      <span class="text-[color:var(--color-ink)]">AI 系統</span>
    </div>

    <!-- hero -->
    <section class="relative pt-10 pb-14 md:pt-14 md:pb-20 overflow-hidden bg-gradient-to-b from-orange-50/40 to-white">
      <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-orange-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-orange-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
        <CareTag caretag={category.caretag} size="lg" class="mb-4" />
        <p class="text-xs md:text-sm font-medium tracking-widest uppercase text-[color:var(--color-brand)]">
          {category.kicker}
        </p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight max-w-4xl">
          {category.label}
        </h1>
        <p class="mt-4 text-lg md:text-xl text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          {category.tagline}
        </p>
        <p class="mt-3 text-sm md:text-base text-[color:var(--color-ink-soft)] max-w-3xl leading-relaxed">
          {category.description}
        </p>
      </div>
    </section>

    <!-- products grid -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 lg:px-6">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {products.map((p) => <ProductCard product={p} variant="hub" />)}
        </div>
      </div>
    </section>

    <!-- capability cloud -->
    <CapabilityCloud
      kicker="AI System Capabilities"
      title="我們在 AI 系統能做的事"
      description="從 AI Agent 設計、企業知識庫 AI 化，到稽核 / 評鑑流程自動化、教育學習系統 — 每一條都跑過真實案例。"
      capabilities={aiCapabilities}
    />

    <!-- philosophy -->
    <section class="py-14 md:py-20 bg-neutral-50">
      <div class="max-w-3xl mx-auto px-4 lg:px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand)]">
          AI 處理判斷、自動化處理重複、人去處理決策
        </h2>
        <p class="mt-4 text-[color:var(--color-ink-soft)] leading-relaxed">
          我們不做「AI 看起來很厲害」的 demo，做的是把專業領域裡那些本來需要老手判斷、
          現在可以結構化的決策流程，改寫成可重複、可監測、可改進的系統。
          每件作品上線後都能持續跑、持續產出價值，不是一次性的 PoC。
        </p>
      </div>
    </section>

    <ContactMap />
  </main>
  <FooterLinks />
</BaseLayout>
