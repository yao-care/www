{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yaocare-inquiry-form",
  // Cloudflare 帳號 ID 不寫在 repo：部署前設環境變數 CLOUDFLARE_ACCOUNT_ID（主機設定，見 docs/HOST-CONFIG.md；與 ods-apply-form 同帳號）
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "yaocare-inquiries", "database_id": "ad7ef948-f246-4cd1-82d1-92efafb74d82" }
  ],
  "vars": {
    // 跨網域只收這兩個來源；Turnstile 回傳的 hostname 也必須在這份清單（正式環境不含 localhost）
    "ALLOWED_ORIGINS": "https://www.yao.care,https://yao.care",
    "TURNSTILE_HOSTNAMES": "www.yao.care,yao.care",
    // 2026-11-02 用戶選：詢問通知寄這個信箱，不發 Slack（原本的 #藥提醒-yao-care 會被週報洗掉）
    "NOTIFY_TO": "service@yao.care"
  }
}
