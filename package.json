{
  "name": "yao-care-www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-design.mjs && node scripts/check-content.mjs && node scripts/check-ai-voice.mjs && node scripts/check-nav.mjs && astro build && node scripts/check-internal-links.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:content:all": "node scripts/check-content.mjs --all",
    "check:ai-voice": "node scripts/check-ai-voice.mjs",
    "check:ai-voice:all": "node scripts/check-ai-voice.mjs --all",
    "publish": "rsync -a --delete dist/ $WWW_SITE_DIR/",
    "deploy": "npm run build && rsync -a --delete dist/ $WWW_SITE_DIR/",
    "preview": "astro preview",
    "astro": "astro",
    "fetch-news": "tsx scripts/fetch-news.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.5.0",
    "@google-analytics/admin": "^9.1.0",
    "@google-analytics/data": "^6.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.13.0",
    "d3": "^7.9.0",
    "google-auth-library": "^10.7.0",
    "opencc-js": "^1.3.1",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
